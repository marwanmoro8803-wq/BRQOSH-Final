<Application x:Class="Brqosh.VendorIssuer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Brand/BrandMark.xaml"/>
                <ResourceDictionary Source="Brand/BrandWordmark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ألوانُ برقوش نفسُها (design-system/Brand) — منسوخةً لأنّ الأداةَ لا ترجع إلى المنتج. -->
            <SolidColorBrush x:Key="PrimaryBrush"       Color="#6B4420"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush"   Color="#4E3016"/>
            <SolidColorBrush x:Key="PrimaryLightBrush"  Color="#8B5A2B"/>
            <SolidColorBrush x:Key="AccentBrush"        Color="#B07A3B"/>
            <SolidColorBrush x:Key="AccentDarkBrush"    Color="#8B5A2B"/>
            <SolidColorBrush x:Key="SurfaceBrush"       Color="#FFFDF8"/>
            <SolidColorBrush x:Key="BackgroundBrush"    Color="#F7F3EA"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#141413"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3E382F"/>
            <SolidColorBrush x:Key="TextMutedBrush"     Color="#5A5348"/>
            <SolidColorBrush x:Key="BorderBrush"        Color="#DDD6C6"/>
            <SolidColorBrush x:Key="BorderLightBrush"   Color="#ECE6D8"/>
            <SolidColorBrush x:Key="SuccessBrush"       Color="#2E6B45"/>
            <SolidColorBrush x:Key="DangerBrush"        Color="#B3261E"/>
            <SolidColorBrush x:Key="WarningBrush"       Color="#8C5A0B"/>
            <SolidColorBrush x:Key="SuccessSoftBrush"   Color="#E4EEDF"/>
            <SolidColorBrush x:Key="DangerSoftBrush"    Color="#F6E1DC"/>
            <SolidColorBrush x:Key="DisabledBrush"      Color="#EAE3D3"/>

            <FontFamily x:Key="AppFont">Segoe UI, Tahoma, Arial</FontFamily>
            <FontFamily x:Key="FigureFont">Consolas, Segoe UI</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Height" Value="36"/>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="Height" Value="36"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Padding" Value="36,30"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.08"
                                          Color="#2B1E12"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,11"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource PrimaryLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource DisabledBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
