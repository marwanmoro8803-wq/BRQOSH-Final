<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ‏«ترخيص برقوش» — برنامجُ المورِّد لإصدار مفاتيح التراخيص الرقميّة.

    ‏**مستقلٌّ عن المنتج قصداً**: لا `ProjectReference` ولا حزمةَ NuGet واحدة — يُشحن إلى
    ‏جهاز المورِّد الذي قد لا يملك المستودعَ ولا الـSDK. وثمنُ الاستقلال نسخةٌ من قواعد
    ‏الترميز في `LicenseCodec.cs`، **وهذا الثمنُ يُدفع في `SelfTest.cs`**: متّجهاتٌ سالبةٌ
    ‏تُسقط الإصدارَ إن فارقت نسخةُ المنتج نسخةَ الأداة.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BrqoshLicenseIssuer</AssemblyName>
    <RootNamespace>Brqosh.VendorIssuer</RootNamespace>
    <ApplicationTitle>BRQOSH — ترخيص برقوش</ApplicationTitle>
    <ApplicationIcon>..\..\assets\brand\brqosh.ico</ApplicationIcon>

    <!-- ‏نشرٌ مستقلٌّ بملفٍّ واحد. ‏`PublishTrimmed` **لا يُفعَّل**: WPF لا يُقصّ. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- هندسةُ الشعار منسوخةٌ من ثيم المنتج (Brand\*.xaml) — تُضمَّن تلقائيّاً كصفحات. -->
  </ItemGroup>

</Project>
