<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Brqosh.Application\Brqosh.Application.csproj" />
    <ProjectReference Include="..\Brqosh.Infrastructure\Brqosh.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\templates\**\*.json" Link="config\templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- (جاهزيّةُ الإطلاق · commercial-readiness#12) إشعاراتُ الطرف الثالث تُشحن بجوار البرنامج — والمُنصِّبُ يحصد مجلّدَ النشر كلَّه.
         تُولَّد بـ scripts/third_party_notices.py، ويُسقط TheShippedPackagesAreAllNoticedTests الحزمةَ إن لم تطابق ما يُشحن. -->
    <Content Include="..\..\assets\legal\eula.txt" Link="legal\eula.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- (جاهزيّةُ الإطلاق · ح-١٦٠ · commercial-readiness#8) دليلُ المستخدم العربيّ يُشحن بجانب البرنامج. -->
    <Content Include="..\..\docs\user-manual\README.md" Link="UserManual-ar.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- (جاهزيّةُ الإطلاق · ح-١٦٣ · ui-ux#9) قوالبُ رسائل الأخطاء المركَّبة — مُضمَّنةٌ في البرنامج فلا ملفَّ يضيع. -->
    <EmbeddedResource Include="..\..\assets\i18n\message-patterns.json" LogicalName="Brqosh.Desktop.MessagePatterns.json" />
    <!-- (commercial-readiness#7) قنواتُ الدعم ومستوياتُ الخدمة كما يعتمدها المورّد — والقالبُ config/templates/support.example.json. -->
    <Content Include="..\..\config\support.json" Condition="Exists('..\..\config\support.json')" Link="config\support.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- أيقونةُ البرنامج: تُدمَج في الملف التنفيذيّ وتصير أيقونةَ كلّ نافذةٍ وشريطِ المهامّ ومختصراتِ المُنصِّب. تُولَّد بـ tools/brand/build_brand.py. -->
    <ApplicationIcon>..\..\assets\brand\brqosh.ico</ApplicationIcon>
    <!-- (تطابقُ ويندوز) ‏بيانُ التطبيق (app.manifest) واسمُ العرض في إدارة المهامّ وخصائص الملف. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>BRQOSH ERP</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- (CEEF-229 · م0-١٦) دلالة إعادة الدخول في UiBusyGuard تُقاس مباشرةً. -->
    <InternalsVisibleTo Include="Brqosh.Desktop.Tests" />
  </ItemGroup>

</Project>
