<Window x:Class="Brqosh.Desktop.Reporting.DocumentPdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="معاينة PDF"
        Width="920" Height="720"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleText}" Text="معاينة المستند"/>
            <TextBlock x:Name="SizeText" Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="0">
            <Grid>
                <wv2:WebView2 x:Name="PdfWebView"/>
                <Border x:Name="FallbackPanel" Visibility="Collapsed" Padding="24">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="FallbackText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Content="فتح في العارض الخارجي" Style="{StaticResource PrimaryButton}"
                                Padding="20,9" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Click="OnOpenExternal"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button x:Name="PrintBtn" Content="طباعة" Style="{StaticResource PrimaryButton}"
                    Padding="20,9" Margin="0,0,8,0" Click="OnPrint"/>
            <Button Content="حفظ باسم…" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Margin="0,0,8,0" Click="OnSaveAs"/>
            <Button Content="فتح خارجياً" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Margin="0,0,8,0" Click="OnOpenExternal"/>
            <Button Content="إغلاق" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
