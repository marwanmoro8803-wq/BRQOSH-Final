<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:Brqosh.Desktop.Ui">

    <!-- هندسةُ شعار BRQOSH (مولَّدة) — داخل الثيم فيراها كلُّ من يحمّل الثيمَ: التطبيقُ والاختباراتُ والمسبار. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BrandMark.xaml"/>
        <ResourceDictionary Source="BrandWordmark.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════
         لوحة الألوان — هوية BRQOSH
    ═══════════════════════════════════════════════ -->
    <Color x:Key="PrimaryColor">#6B4420</Color>
    <Color x:Key="ElectricCyanColor">#6B4420</Color>
    <Color x:Key="GlassSurfaceColor">#EFEADF</Color>
    <Color x:Key="PrimaryDarkColor">#4E3016</Color>
    <Color x:Key="PrimaryLightColor">#8B5A2B</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="AccentInkColor">#7A4F23</Color>
    <Color x:Key="RuleStrongColor">#8F8676</Color>
    <Color x:Key="SidebarTextColor">#E9DCC9</Color>
    <Color x:Key="SidebarMutedColor">#BDA98C</Color>
    <Color x:Key="PrimarySoftColor">#EFE3D2</Color>
    <Color x:Key="AccentColor">#B07A3B</Color>
    <Color x:Key="AccentDarkColor">#8B5A2B</Color>
    <Color x:Key="SurfaceColor">#FFFDF8</Color>
    <Color x:Key="BackgroundColor">#F7F3EA</Color>
    <Color x:Key="SidebarColor">#2B1E12</Color>
    <Color x:Key="SidebarMidColor">#2B1E12</Color>
    <Color x:Key="SidebarHoverColor">#3A2A1A</Color>
    <Color x:Key="TextPrimaryColor">#141413</Color>
    <Color x:Key="TextSecondaryColor">#3E382F</Color>
    <Color x:Key="TextMutedColor">#5A5348</Color>
    <Color x:Key="BorderColor">#DDD6C6</Color>
    <Color x:Key="BorderLightColor">#ECE6D8</Color>
    <Color x:Key="SuccessColor">#2E6B45</Color>
    <Color x:Key="DangerColor">#B3261E</Color>
    <Color x:Key="InfoColor">#2F5F86</Color>
    <Color x:Key="WarningColor">#8C5A0B</Color>
    <Color x:Key="StatusBarColor">#ECE6D9</Color>
    <Color x:Key="StatusBarTextColor">#3E382F</Color>
    <!-- (CEEF-222) ألوان الجداول — كانت مثبَّتة نصّاً داخل الأنماط فلا تتبع الثيم. -->
    <Color x:Key="RowAltColor">#F9F6EF</Color>
    <Color x:Key="RowHoverColor">#F0E6D6</Color>
    <!-- «دفتر الحبر والنحاس»: خلفيّاتُ الحالات الباهتة وحالاتُ التعطيل والتمرير — كانت ألواناً زرقاءَ مثبّتةً داخل الأنماط فلا تتبع الثيم ولا تُقلب في الداكن. -->
    <Color x:Key="SuccessSoftColor">#E4EEDF</Color>
    <Color x:Key="DangerSoftColor">#F6E1DC</Color>
    <Color x:Key="WarningSoftColor">#F5E6C4</Color>
    <Color x:Key="InfoSoftColor">#DFE9F0</Color>
    <Color x:Key="SuccessDarkColor">#25573A</Color>
    <Color x:Key="DisabledBackgroundColor">#EAE3D3</Color>
    <Color x:Key="DisabledForegroundColor">#8A8171</Color>
    <Color x:Key="ScrollThumbColor">#CFC5B0</Color>

    <SolidColorBrush x:Key="PrimaryBrush"       Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="ElectricCyanBrush" Color="{StaticResource ElectricCyanColor}"/>
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{StaticResource GlassSurfaceColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"   Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"  Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"     Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentInkBrush"     Color="{StaticResource AccentInkColor}"/>
    <SolidColorBrush x:Key="RuleStrongBrush"    Color="{StaticResource RuleStrongColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"   Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush"  Color="{StaticResource SidebarMutedColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush"   Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush"    Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"       Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarMidBrush"    Color="{StaticResource SidebarMidColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"  Color="{StaticResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush"   Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush"          Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="WarningBrush"       Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="StatusBarBrush"     Color="{StaticResource StatusBarColor}"/>
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="{StaticResource StatusBarTextColor}"/>
    <SolidColorBrush x:Key="RowAltBrush"        Color="{StaticResource RowAltColor}"/>
    <SolidColorBrush x:Key="RowHoverBrush"      Color="{StaticResource RowHoverColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="{StaticResource SuccessDarkColor}"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}"/>

    <!-- علمُ كلّ عملة: [علم] SAR SA — لقوائم اختيار العملة (ItemTemplate). الاتجاهُ LTR: رموزٌ لاتينيّة. -->
    <ui:CurrencyFlagConverter x:Key="CurrencyFlag"/>
    <ui:CurrencyCountryConverter x:Key="CurrencyCountry"/>
    <DataTemplate x:Key="CurrencyFlagItem">
        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
            <Border Width="30" Height="22" Margin="0,0,10,0" CornerRadius="2" ClipToBounds="True"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <Image Source="{Binding Converter={StaticResource CurrencyFlag}}" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding}" FontWeight="SemiBold" Width="48" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Converter={StaticResource CurrencyCountry}}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <FontFamily x:Key="AppFont">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="FigureFont">Bahnschrift, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="DisplayFont">Sakkal Majalla, Segoe UI, Tahoma</FontFamily>

    <Style TargetType="UserControl">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
    </Style>

    <!-- تدرجات -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B1E12" Offset="0"/>
        <GradientStop Color="#2B1E12" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroPanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B1E12" Offset="0"/>
        <GradientStop Color="#2B1E12" Offset="1"/>
    </LinearGradientBrush>

    <!-- ظلال -->
    <DropShadowEffect x:Key="CardShadow"     BlurRadius="20" ShadowDepth="3" Opacity="0" Color="#2B1E12"/>
    <DropShadowEffect x:Key="ElevatedShadow" BlurRadius="32" ShadowDepth="6" Opacity="0" Color="#2B1E12"/>
    <DropShadowEffect x:Key="HeroShadow"     BlurRadius="48" ShadowDepth="8" Opacity="0" Color="#2B1E12"/>

    <!-- UI UX Pro Max — حركة وتركيز لوحة المفاتيح -->
    <sys:Double x:Key="MotionDurationFast">150</sys:Double>
    <sys:Double x:Key="MotionDurationNormal">200</sys:Double>
    <!-- كثافةُ الجداول: يبدّلها DensityManager (مريح ٤٠ · مضغوط ٣٢)؛ نمطُ DataGrid يقرؤها DynamicResource. -->
    <sys:Double x:Key="GridRowHeight">40</sys:Double>

    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource AccentBrush}"
                               StrokeThickness="2" RadiusX="4" RadiusY="4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════
         أزرار
    ═══════════════════════════════════════════════ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Background"   Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground"   Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="FontFamily"   Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"     Value="14"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Padding"      Value="22,11"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Background"    Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground"    Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily"    Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"      Value="14"/>
        <Setter Property="FontWeight"    Value="SemiBold"/>
        <Setter Property="Padding"       Value="18,10"/>
        <Setter Property="BorderBrush"   Value="{DynamicResource RuleStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"   Value="{DynamicResource RowHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"  Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Background"    Value="Transparent"/>
        <Setter Property="Foreground"    Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily"    Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"      Value="13"/>
        <Setter Property="Padding"       Value="14,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground"  Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SoftDangerButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Background"    Value="{DynamicResource DangerSoftBrush}"/>
        <Setter Property="Foreground"    Value="{DynamicResource DangerBrush}"/>
        <Setter Property="FontFamily"    Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"      Value="14"/>
        <Setter Property="FontWeight"    Value="SemiBold"/>
        <Setter Property="Padding"       Value="18,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Background"    Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground"    Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="FontFamily"    Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"      Value="14"/>
        <Setter Property="FontWeight"    Value="SemiBold"/>
        <Setter Property="Padding"       Value="22,11"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SuccessDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SuccessDarkBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
