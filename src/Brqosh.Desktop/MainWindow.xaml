<Window x:Class="Brqosh.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Brqosh.Desktop.Views.Controls"
        Title="BRQOSH ERP"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── محتوى رئيسي (شريط جانبي + منطقة عمل) ── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="AiColumn" Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════
                 الشريط الجانبي
            ══════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- الشعار والهوية -->
                    <StackPanel Grid.Row="0" Margin="18,20,18,10">
                        <!-- خط تمييز علوي بلون العلامة -->
                        <Border Height="3" CornerRadius="1" Margin="0,0,0,14"
                                Background="{DynamicResource AccentBrush}"/>

                        <!-- اسم النظام -->
                        <controls:BrandLogo MarkHeight="48" NameSize="15" HorizontalAlignment="Center"
                                            MarkBrush="{DynamicResource BrandMarkBrush}" NameBrush="{DynamicResource BrandMarkBrush}"/>
                        <TextBlock Text="نظام تخطيط موارد المؤسسة"
                                   FontSize="11.5" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>

                        <!-- اسم المنشأة ونمط العمل في سطرين: نصٌّ لا شارةٌ كبسولية -->
                        <TextBlock x:Name="CompanyNameText"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProfileBadge"
                                   FontSize="11.5" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,2,0,0"/>

                        <!-- بحثٌ في القائمة — Ctrl+K -->
                        <TextBox x:Name="NavSearchBox" Style="{StaticResource NavSearchBox}" Margin="0,12,0,0"
                                 AutomationProperties.AutomationId="NavSearch"
                                 TextChanged="OnNavSearchChanged" PreviewKeyDown="OnNavSearchKeyDown"/>
                    </StackPanel>

                    <!-- قائمة التنقل -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,2,8">
                        <StackPanel x:Name="NavPanel"/>
                    </ScrollViewer>

                    <!-- بطاقة المستخدم السفلية -->
                    <Border Grid.Row="2" Background="{DynamicResource SidebarHoverBrush}"
                            CornerRadius="4" Margin="12,0,12,14" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}"/>
                                <TextBlock x:Name="UserRoleText"
                                           FontSize="11" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="UserInitialText"
                                           Text="م" FontSize="14" FontWeight="Bold"
                                           Foreground="#141413"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════
                 منطقة العمل
            ══════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ترويسة الصفحة -->
                <Border x:Name="PageHeader" Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="28,16"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- مسار التنقل والعنوان -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PageCrumb"
                                       AutomationProperties.AutomationId="PageCrumb"
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,2"/>
                            <TextBlock x:Name="PageTitle"
                                       AutomationProperties.AutomationId="PageTitle"
                                       Text="لوحة التحكم"
                                       FontSize="20" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- أدوات الترويسة -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="CompanyLabel" Text="المنشأة" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CompanyCombo" Width="200" MinHeight="36"
                                      Style="{StaticResource AppComboBox}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                      SelectionChanged="OnCompanyChanged"
                                      Margin="0,0,16,0"/>

                            <TextBlock x:Name="BranchLabel" Text="الفرع" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BranchCombo" Width="180" MinHeight="36"
                                      Style="{StaticResource AppComboBox}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                      SelectionChanged="OnBranchChanged"
                                      Margin="0,0,16,0"/>

                            <!-- زر الوضع الداكن -->
                            <Button x:Name="LanguageToggleBtn" Content="EN"
                                    ToolTip="تبديل اللغة / Switch language"
                                    Style="{StaticResource GhostButton}"
                                    MinWidth="44" MinHeight="36"
                                    Margin="0,0,8,0"
                                    Click="OnToggleLanguage"/>

                            <Button x:Name="AiToggleBtn" Content="AI"
                                    ToolTip="إظهار/إخفاء المساعد الذكي"
                                    Style="{StaticResource GhostButton}"
                                    MinWidth="44" MinHeight="36"
                                    Margin="0,0,8,0"
                                    Click="OnToggleAiPanel"/>

                            <Button x:Name="ThemeToggleBtn" Content="داكن"
                                    ToolTip="تبديل المظهر"
                                    Style="{StaticResource GhostButton}"
                                    MinWidth="52" MinHeight="36"
                                    Margin="0,0,8,0"
                                    Click="OnToggleTheme"/>

                            <!-- التاريخ الهجري/الميلادي -->
                            <TextBlock x:Name="DateText"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,18,0"/>

                            <!-- شارة المستخدم -->
                            <Border x:Name="HeaderUserBadge" Background="{DynamicResource PrimarySoftBrush}"
                                    CornerRadius="3" Padding="12,6">
                                <TextBlock x:Name="HeaderUserText"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryDarkBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- منطقة الصفحة + Toast -->
                <Grid Grid.Row="1" Margin="20">
                    <!-- (UI-AUDIT · P1) الصفحةُ تُمرَّر إن طالت — والارتفاعُ يُدار في Ui/PageViewport
                         حتى تبقى الجداولُ محدودةً فلا يُكسر ترشيدُ صفوفها. والـ Toast خارج التمرير فيبقى مرئياً. -->
                    <ScrollViewer x:Name="PageViewportScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" Focusable="False">
                        <ContentControl x:Name="PageHost"
                                        VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="PageHost"/>
                    </ScrollViewer>
                    <Grid x:Name="ToastOverlay" IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <!-- ══ AI Assistant Panel — Luxury Glass ══ -->
            <Border x:Name="AiPanel" Grid.Column="2" Style="{StaticResource AiPanelShell}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="BRQOSH AI"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource ElectricCyanBrush}"/>
                        <TextBlock x:Name="AiSubtitleText"
                                   Text="مساعد مالي ذكي"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="رؤى فورية"
                                       x:Name="AiInsightsLabel"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <StackPanel x:Name="AiInsightHost"/>
                            <TextBlock Text="المحادثة"
                                       x:Name="AiChatLabel"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,12,0,8"/>
                            <StackPanel x:Name="AiChatHost"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <WrapPanel x:Name="AiQuickPromptsHost" Margin="0,0,0,8"/>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AiInputBox"
                                 Grid.Column="0"
                                 MinHeight="36"
                                 Style="{StaticResource AppTextBox}"
                                 Margin="0,0,8,0"
                                 AutomationProperties.AutomationId="AiInputBox"/>
                        <Button x:Name="AiSendBtn"
                                Grid.Column="1"
                                Content="إرسال"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="64" MinHeight="36"
                                AutomationProperties.AutomationId="AiSendBtn"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════
             شريط الحالة السفلي
        ══════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource StatusBarBrush}"
                Padding="20,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusDbDot" Width="6" Height="6" CornerRadius="3"
                            Background="{DynamicResource SuccessBrush}"
                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusDbText"
                               Text="قاعدة البيانات: متصل"
                               FontSize="11" Foreground="{DynamicResource StatusBarTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}"
                        Margin="16,3"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusSessionText"
                               Text="الجلسة نشطة"
                               FontSize="11" Foreground="{DynamicResource StatusBarTextBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>

                    <!-- ‏(CEEF-237 · ت-٤) شارةُ آخرِ نسخةٍ احتياطيّة — تُرى ولا تُطلَب.
                         ‏كان النسخُ زرّاً لا يُذكّر أحداً بنفسه، فتمرّ أسابيعُ بلا نسخة. -->
                    <Border x:Name="StatusBackupBadge" Visibility="Collapsed"
                            Background="{DynamicResource DangerBrush}" CornerRadius="3" Padding="7,1"
                            Margin="16,0,0,0" VerticalAlignment="Center"
                            ToolTip="اضغط لفتح شاشة النسخ الاحتياطي">
                        <TextBlock x:Name="StatusBackupText" FontSize="11"
                                   Foreground="{DynamicResource OnPrimaryBrush}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Text="BRQOSH ERP"
                           FontSize="11" Foreground="{DynamicResource StatusBarTextBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
