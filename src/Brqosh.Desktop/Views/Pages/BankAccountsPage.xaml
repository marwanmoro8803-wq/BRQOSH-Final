<UserControl x:Class="Brqosh.Desktop.Views.Pages.BankAccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الحسابات البنكية" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="IBAN · عملات · إعادة تقييم FX"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="＋ حساب بنكي جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FxRevalBtn" Content="إعادة تقييم عملة" Padding="16,9" Click="OnFxReval"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button DockPanel.Dock="Right" Content="إيقاف"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnDeactivate"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="BankSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      MouseDoubleClick="OnEdit" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="اسم الحساب" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="البنك" Binding="{Binding BankName}" Width="160"/>
                    <DataGridTextColumn Header="رقم الحساب" Binding="{Binding AccountNumber}" Width="140"/>
                    <DataGridTextColumn Header="الآيبان" Binding="{Binding Iban}" Width="200"/>
                    <DataGridTextColumn Header="حساب الأستاذ" Binding="{Binding GlCode}" Width="110"/>
                    <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyCode}" Width="70"/>
                    <DataGridTextColumn Header="افتراضي" Binding="{Binding DefaultAr}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
