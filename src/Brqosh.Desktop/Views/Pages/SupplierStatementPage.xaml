<UserControl x:Class="Brqosh.Desktop.Views.Pages.SupplierStatementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="كشف حساب مورد" FontSize="{DynamicResource FontSize.Title}"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="فواتير المشتريات والمدفوعات والرصيد المستحق للمورد"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <WrapPanel>
                <TextBlock Text="المورد" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SupplierCombo" Width="280" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectionChanged="OnSupplierChanged"/>
                <Button Content="عرض الكشف" Style="{StaticResource PrimaryButton}" Padding="24,7" Margin="16,0,0,0" Click="OnRun"/>
                <Button Content="تصدير PDF" Style="{StaticResource SecondaryButton}" Padding="24,7" Margin="12,0,0,0" Click="OnExportPdf"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="110"/>
                    <DataGridTextColumn Header="رقم المستند" Binding="{Binding DocumentNumber}" Width="130"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding DocumentType}" Width="140"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الرصيد الدائن" Binding="{Binding RunningBalance, StringFormat=N2}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SummaryCard}">
            <TextBlock x:Name="TotalsText" Foreground="White" FontWeight="Bold" FontSize="{DynamicResource FontSize.BodyLarge}"/>
        </Border>
    </Grid>
</UserControl>
