<UserControl x:Class="Brqosh.Desktop.Views.Pages.PosShiftsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="ورديات نقاط البيع" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="فتح · إغلاق · نقد افتتاحي · مبيعات"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenBtn" Content="＋ فتح وردية" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnOpenShift"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button DockPanel.Dock="Right" x:Name="CloseBtn" Content="إغلاق المحدد"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnCloseShift"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <!-- (جاهزيّةُ الإطلاق · ح-١١٤) مستودعُ بيع الوردية التي تُفتح — والأوّلُ «الافتراضيّ». -->
                <ComboBox x:Name="ShiftWarehouseCombo" DockPanel.Dock="Right" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" MinWidth="200"
                          VerticalAlignment="Center" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                <TextBlock DockPanel.Dock="Right" Text="المستودع" VerticalAlignment="Center"
                           Margin="0,0,10,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="ShiftSummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="*"/>
                    <DataGridTextColumn Header="الفتح" Binding="{Binding OpenedAt}" Width="150"/>
                    <DataGridTextColumn Header="الإغلاق" Binding="{Binding ClosedAt}" Width="150"/>
                    <DataGridTextColumn Header="نقد افتتاحي" Binding="{Binding OpeningCash, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="المبيعات" Binding="{Binding TotalSales, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="المعاملات" Binding="{Binding TransactionCount}" Width="90"/>
                    <!-- (CEEF-231 · ط5-٩) نقد الدرج المتوقع والفعلي وفرقهما — وكان الفرق
                         يُحسب في النطاق ولا يراه أحد. ووردية تُغلق بعجز مئتين لا يظهر
                         شيء، فيتكرر شهرا ولا يُكتشف. -->
                    <DataGridTextColumn Header="نقد متوقع" Binding="{Binding ExpectedCash, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="نقد فعلي" Binding="{Binding ClosingCash, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="الفرق" Binding="{Binding CashDifferenceText}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
