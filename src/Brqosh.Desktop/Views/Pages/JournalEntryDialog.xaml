<Window x:Class="Brqosh.Desktop.Views.Pages.JournalEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="قيد يومية جديد"
        Width="920" Height="640"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="قيد يومية" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>

        <!-- رأس القيد -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DatePickerBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="البيان *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>

            <!-- (CEEF-231 · O-34) عملةُ المعاملة وسعرُها. والمبالغُ في الجدول تُقرأ بهذه
                 العملة، ويُرحَّل القيدُ بالريال بعد الترجمة — فالدفترُ النظاميُّ بالريال
                 ولا يُقاس ميزانٌ بعملتين. -->
            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <TextBlock Text="عملة المعاملة" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="30" Height="22" Margin="0,0,8,0" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="{Binding Text, ElementName=CurrencyBox, Converter={StaticResource CurrencyCountry}}">
                        <Image Source="{Binding Text, ElementName=CurrencyBox, Converter={StaticResource CurrencyFlag}}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBox x:Name="CurrencyBox" Style="{StaticResource AppTextBox}" Text="SAR"
                         TextChanged="OnCurrencyChanged"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="12,0,0,0">
                <TextBlock Text="سعر الصرف" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RateBox" Style="{StaticResource AppTextBox}" Text="1"
                         TextChanged="OnCurrencyChanged"/>
            </StackPanel>
        </Grid>

        <!-- معاملة بين الشركات -->
        <Border Grid.Row="2" x:Name="IntercompanyPanel" Margin="0,0,0,14" Padding="12,10"
                Style="{StaticResource ContentCard}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="IntercompanyCheck" Content="معاملة بين الشركات" VerticalAlignment="Center"
                          Checked="OnIntercompanyToggled" Unchecked="OnIntercompanyToggled"/>
                <TextBlock Text="الشركة المقابلة:" Style="{StaticResource FieldLabel}" Margin="24,0,8,0"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="CounterpartyCombo" Width="280" IsEnabled="False"
                          DisplayMemberPath="Display" SelectedValuePath="Id"/>
            </StackPanel>
        </Border>

        <!-- سطور القيد -->
        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36"
                      Background="Transparent"
                      CellEditEnding="OnCellEditEnding">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="AccountColumn" Header="الحساب" Width="*"
                                            SelectedValueBinding="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id" DisplayMemberPath="Display"/>
                    <DataGridComboBoxColumn x:Name="CostCenterColumn" Header="مركز التكلفة" Width="180"
                                            SelectedValueBinding="{Binding CostCenterId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id" DisplayMemberPath="Display"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="180"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- الإجماليات -->
        <Border Grid.Row="4" Style="{StaticResource TotalsCard}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="إجمالي المدين:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalDebitText" Text="0.00" Margin="8,0,32,0" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="إجمالي الدائن:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalCreditText" Text="0.00" Margin="8,0,32,0" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="BalanceText" FontWeight="Bold"/>
                <TextBlock x:Name="TranslationText" Margin="32,0,0,0" FontWeight="SemiBold"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- الأزرار -->
        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                <Button Content="ترحيل القيد" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
