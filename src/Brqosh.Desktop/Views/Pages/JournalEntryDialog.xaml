<Window x:Class="Brqosh.Desktop.Views.Pages.JournalEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="قيد يومية جديد"
        Width="920" Height="640"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="قيد يومية" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

        <!-- رأس القيد -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="التاريخ *" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DatePicker x:Name="DatePickerBox" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="البيان *" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
        </Grid>

        <!-- سطور القيد -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="LinesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" FontSize="14" RowHeight="36"
                      Background="Transparent"
                      CellEditEnding="OnCellEditEnding">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="AccountColumn" Header="الحساب" Width="*"
                                            SelectedValueBinding="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id" DisplayMemberPath="Display"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="220"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- الإجماليات -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,10" Margin="0,12,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="إجمالي المدين:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalDebitText" Text="0.00" Margin="8,0,32,0" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="إجمالي الدائن:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalCreditText" Text="0.00" Margin="8,0,32,0" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="BalanceText" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- الأزرار -->
        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                <Button Content="ترحيل القيد" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
                <Button Content="إلغاء" Margin="10,0,0,0" Padding="24,9" Click="OnCancel"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
