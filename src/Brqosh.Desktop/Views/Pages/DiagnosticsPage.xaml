<UserControl x:Class="Brqosh.Desktop.Views.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="حالة النظام" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="ما يسأل عنه الدعم أول مكالمة — في شاشة واحدة"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyBtn" Content="نسخ التقرير" Style="{StaticResource PrimaryButton}"
                            Padding="20,9" Click="OnCopy"/>
                    <!-- ‏(م-٥ · ن-٤٢) ‏**حزمةُ الدعم**: ملفٌّ واحدٌ يُرسَل بدل مجلّدٍ يُفتَح
                         ويُترَك المستخدمُ أمامه ليختار من ثلاثين ملفّاً متشابهاً. -->
                    <Button x:Name="BundleBtn" Content="حزمة الدعم" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="20,9" Click="OnExportBundle"/>
                    <Button x:Name="LogsBtn" Content="فتح مجلد السجلات" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="20,9" Click="OnOpenLogs"/>
                    <Button x:Name="UpdateBtn" Content="فحص التحديث" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="20,9" Click="OnCheckUpdate"/>
                    <!-- ‏(ح-١٤١) ‏**تنزيلُ الحزمة وتهيئتُها — لا تنصيبُها.** يظهر حين يوجد إصدارٌ أحدث،
                         ‏ونصُّه من الشيفرة الخلفيّة بـ`LocaleManager.T`. -->
                    <Button x:Name="StageBtn" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"
                            Margin="8,0,0,0" Padding="20,9" Click="OnStageUpdate"/>
                </WrapPanel>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <StackPanel>
                <!-- ‏(ح-١٤١) ‏**القناةُ تُحفظ مرّة** — مسارُ ملفٍّ أو مشاركةٌ أو https. -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="ChannelLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Margin="0,0,8,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button x:Name="BrowseChannelBtn" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="14,6" Click="OnBrowseChannel"/>
                    <TextBox x:Name="ChannelBox" FlowDirection="LeftToRight"/>
                </DockPanel>
                <TextBlock x:Name="UpdateText" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="البند" Binding="{Binding Label}" Width="260"/>
                    <DataGridTextColumn Header="القيمة" Binding="{Binding Value}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
