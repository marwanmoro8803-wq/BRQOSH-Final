<UserControl x:Class="Brqosh.Desktop.Views.Pages.PurchaseInvoicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="فواتير المشتريات" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="شراء → ضريبة قابلة للخصم → ترحيل AP"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewInvoiceBtn" Content="＋ فاتورة مشتريات جديدة"
                            Style="{StaticResource PrimaryButton}" Padding="18,9"
                            Click="OnNewInvoice"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض" Padding="16,9" Margin="0,0,8,0" Click="OnView"/>
                    <Button Content="عرض القيد" Padding="16,9" Margin="0,0,8,0" Click="OnViewJournal"/>
                    <Button Content="طباعة PDF" Padding="16,9" Click="OnPrintPdf"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PrevBtn" Content="→" Padding="12,9" Margin="0,0,6,0"
                            ToolTip="الصفحة السابقة" Click="OnPrev"/>
                    <Button x:Name="NextBtn" Content="←" Padding="12,9"
                            ToolTip="الصفحة التالية" Click="OnNext"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button DockPanel.Dock="Right" x:Name="CancelInvoiceBtn" Content="إلغاء"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9"
                        Click="OnCancelInvoice"/>
                <Border DockPanel.Dock="Left" Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="20" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                </Border>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="8" Margin="0,12,0,12">
            <UniformGrid x:Name="KpiGrid" Columns="3"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="InvoicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" Background="Transparent"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم الداخلي" Binding="{Binding InvoiceNumber}" Width="140"/>
                    <DataGridTextColumn Header="مرجع المورد" Binding="{Binding SupplierReference}" Width="130"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate}" Width="110"/>
                    <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="قبل الضريبة" Binding="{Binding Subtotal, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الضريبة" Binding="{Binding VatAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
