<Window x:Class="Brqosh.Desktop.Views.Pages.ProjectCostDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل تكلفة مشروع"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TitleText" Text="تسجيل تكلفة مشروع" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DateBox" FontSize="14" Margin="0,0,0,14"/>

        <TextBlock Text="الوصف *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="المبلغ *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AmountBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <CheckBox x:Name="PostJournalBox" Content="ترحيل قيد محاسبي (مدين 5105 / دائن صندوق)" IsChecked="True"
                  FontSize="13" Margin="0,0,0,8"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="SemiBold"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
