<UserControl x:Class="Brqosh.Desktop.Views.Pages.DataMigrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="ترحيل البيانات" FontSize="17"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="نقل الدليل والعملاء والموردين والأرصدة الافتتاحية من نظام سابق"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="تاريخ بدء التشغيل" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DatePicker x:Name="OpeningDatePicker" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="ImportOpeningBtn" Content="استيراد الميزان الافتتاحي"
                            Style="{StaticResource PrimaryButton}" Padding="18,9" Click="OnImportOpening"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="ImportStockBtn" DockPanel.Dock="Right" Content="المخزون الافتتاحي"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0" Click="OnImportStock"/>
                <Button x:Name="ImportProductsBtn" DockPanel.Dock="Right" Content="استيراد الأصناف"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0" Click="OnImportProducts"/>
                <Button x:Name="ImportPayablesBtn" DockPanel.Dock="Right" Content="ذمم الموردين المفتوحة"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0" Click="OnImportPayables"/>
                <Button x:Name="ImportReceivablesBtn" DockPanel.Dock="Right" Content="ذمم العملاء المفتوحة"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0" Click="OnImportReceivables"/>
                <Button x:Name="ImportSuppliersBtn" DockPanel.Dock="Right" Content="استيراد الموردين"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnImportSuppliers"/>
                <Button x:Name="ImportCustomersBtn" DockPanel.Dock="Right" Content="استيراد العملاء"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0" Click="OnImportCustomers"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="ImportAccountsBtn" DockPanel.Dock="Right" Content="استيراد دليل الحسابات"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnImportAccounts"/>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,10" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="اختر ملفًا بصيغة CSV. والصف الأول عناوين، وما تعذّر يُعرض بسطره وسببه."/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="0,0,0,10" Padding="16,12">
            <StackPanel>
                <TextBlock Text="الأعمدة المتوقعة" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="دليل الحسابات: Code · NameAr · NameEn · Type (Asset/Liability/Equity/Revenue/Expense) · IsGroup اختياري"
                           Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
                <TextBlock Text="العملاء والموردون: NameAr · VatNumber (خمسة عشر رقماً أو فارغ)"
                           Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
                <TextBlock Text="الميزان الافتتاحي: AccountCode · Debit · Credit — يتوازن ويُرحَّل قيداً واحداً بتاريخ بدء التشغيل أو لا يُرحَّل منه شيء. والذمم المدينة والدائنة تقف في 3107 حتى تُفصَّل على أصحابها، والمخزون بحركته الافتتاحية لكل صنف."
                           Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
                <TextBlock Text="الذمم المفتوحة: CustomerName أو SupplierName · DocumentNumber · DocumentDate · DueDate (yyyy-MM-dd) · Amount — بعد الميزان، فتنتقل من 3107 إلى أصحابها ويعود 3107 صفراً."
                           Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
                <TextBlock Text="الأصناف: Code · NameAr · Unit · Type (Stockable/Service) · SalePrice — والمخزون الافتتاحي: ProductCode · Quantity · UnitCost في المستودع الافتراضي بعد الميزان. والحقل الذي فيه فاصلة يُكتب بين علامتي تنصيص."
                           Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم السطر" Binding="{Binding LineNumber}" Width="120"/>
                    <DataGridTextColumn Header="النتيجة" Binding="{Binding State}" Width="120"/>
                    <DataGridTextColumn Header="السبب" Binding="{Binding Error}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
