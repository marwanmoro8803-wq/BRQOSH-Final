<UserControl x:Class="Brqosh.Desktop.Views.Pages.FixedAssetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddBtn" Content="＋ أصل جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض قيد الاقتناء" Padding="16,9" Margin="0,0,8,0" Click="OnViewJournal"/>
                    <Button Content="عرض قيد الاستبعاد" Padding="16,9" Margin="0,0,8,0" Click="OnViewDisposalJournal"/>
                    <Button x:Name="RunDepreciationBtn" Content="تشغيل إهلاك شهري" Padding="16,9" Margin="0,0,8,0" Click="OnRunDepreciation"/>
                    <Button x:Name="ReverseDepreciationBtn" Content="عكس تشغيل الإهلاك" Style="{StaticResource SoftDangerButton}"
                            Padding="16,9" Click="OnReverseDepreciation"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="DisposeBtn" DockPanel.Dock="Right" Content="استبعاد"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnDispose"/>
                <Button x:Name="CancelAcquisitionBtn" DockPanel.Dock="Right" Margin="0,0,8,0"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnCancelAcquisition"/>
                <Button x:Name="ReverseDisposalBtn" DockPanel.Dock="Right" Margin="0,0,8,0"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnReverseDisposal"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الأصول الثابتة" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="اقتناء · إهلاك · استبعاد · قيمة دفترية"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="8" Margin="0,12,0,12">
            <UniformGrid x:Name="KpiGrid" Columns="3"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      MouseDoubleClick="OnEdit" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="تاريخ الاقتناء" Binding="{Binding AcquisitionDate}" Width="110"/>
                    <DataGridTextColumn Header="التكلفة" Binding="{Binding AcquisitionCost, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="مجمع الإهلاك" Binding="{Binding AccumulatedDepreciation, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="القيمة الدفترية" Binding="{Binding BookValue, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="إهلاك شهري" Binding="{Binding MonthlyDepreciation, StringFormat=N2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
