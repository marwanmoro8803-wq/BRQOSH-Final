<UserControl x:Class="Brqosh.Desktop.Views.Pages.CompanyGroupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
 FontFamily="{StaticResource AppFont}">
    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="مجموعات الشركات" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="تقارير موحّدة · خرائط IC · عملة تقرير"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}" Margin="0,12,0,0">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="رمز" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="CodeBox" Width="100" Style="{StaticResource AppTextBox}"/>
                    <TextBlock Text="الاسم" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <TextBox x:Name="NameBox" Width="220" Style="{StaticResource AppTextBox}"/>
                    <TextBlock Text="عملة التقرير" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <DockPanel>
                    <Border DockPanel.Dock="Left" Width="30" Height="22" Margin="0,0,8,0" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="{Binding Text, ElementName=CurrencyBox, Converter={StaticResource CurrencyCountry}}">
                        <Image Source="{Binding Text, ElementName=CurrencyBox, Converter={StaticResource CurrencyFlag}}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBox x:Name="CurrencyBox" Width="60" MaxLength="3" Style="{StaticResource AppTextBox}" Text="SAR"/>
                </DockPanel>
                    <Button x:Name="AddBtn" Content="إضافة مجموعة" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="16,0,0,0" Click="OnAdd"/>
                </WrapPanel>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="GroupSummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,8,0">
                <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="34"
                          SelectionChanged="OnGroupSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="100"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding NameAr}" Width="*"/>
                        <DataGridTextColumn Header="عملة التقرير" Binding="{Binding ReportingCurrencyCode}" Width="120"/>
                        <DataGridTextColumn Header="عدد الشركات" Binding="{Binding CompanyCount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource ContentCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="خرائط حسابات المعاملات بين الشركات"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="AccountCodeBox" Width="100" Style="{StaticResource AppTextBox}"
                                 ToolTip="رمز الحساب (أرقام فقط)"/>
                        <Button x:Name="AddMapBtn" Content="إضافة" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Padding="12,7" Click="OnAddMap"/>
                        <Button x:Name="RemoveMapBtn" Content="حذف" Style="{StaticResource SoftDangerButton}"
                                Margin="8,0,0,0" Padding="12,7" Click="OnRemoveMap"/>
                    </StackPanel>
                    <DataGrid x:Name="MapsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="0" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
