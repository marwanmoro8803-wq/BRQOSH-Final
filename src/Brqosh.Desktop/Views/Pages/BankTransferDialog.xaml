<Window x:Class="Brqosh.Desktop.Views.Pages.BankTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحويل بنكي"
        Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="تحويل بين حسابات بنكية" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DatePickerBox" FontSize="{DynamicResource FontSize.BodyLarge}" Margin="0,0,0,14"/>

        <TextBlock Text="من حساب *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="FromBankCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"
                  DisplayMemberPath="Display" SelectedValuePath="Id"/>

        <TextBlock Text="إلى حساب *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ToBankCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"
                  DisplayMemberPath="Display" SelectedValuePath="Id"/>

        <TextBlock Text="المبلغ *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AmountBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="مرجع (اختياري)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ReferenceBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="ترحيل التحويل" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="حفظ" Padding="24,9" Click="OnSave"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="24,9" Margin="12,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
