<UserControl x:Class="Brqosh.Desktop.Views.Pages.PurchaseRequestsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewBtn" Content="＋ طلب جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnNew"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SubmitBtn" Content="إرسال للموافقة" Padding="16,9" Margin="0,0,8,0" Click="OnSubmit"/>
                    <Button x:Name="ApproveBtn" Content="اعتماد" Padding="16,9" Margin="0,0,8,0" Click="OnApprove"/>
                    <Button x:Name="RejectBtn" Content="رفض" Style="{StaticResource SoftDangerButton}"
                            Padding="16,9" Margin="0,0,8,0" Click="OnReject"/>
                    <Button x:Name="ConvertPoBtn" Content="تحويل لأمر شراء" Padding="16,9" Margin="0,0,8,0" Click="OnConvertPo"/>
                    <Button Content="عرض" Padding="16,9" Click="OnView"/>
                </WrapPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="طلبات الشراء" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="مسودة → إرسال → مدير → مالية → أمر شراء"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="مسار الموافقة:" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,0" Padding="10,4">
                    <TextBlock Text="مسودة"/>
                </Border>
                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,0" Padding="10,4">
                    <TextBlock Text="مُرسَل"/>
                </Border>
                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,0" Padding="10,4">
                    <TextBlock Text="مدير"/>
                </Border>
                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,0" Padding="10,4">
                    <TextBlock Text="مالية"/>
                </Border>
                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource StatusBadge}" Padding="10,4">
                    <TextBlock Text="أمر شراء"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      BorderThickness="0" MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الطلب" Binding="{Binding RequestNumber}" Width="130"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding RequestDate}" Width="100"/>
                    <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding Subtotal, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                    <DataGridTextColumn Header="خطوة الموافقة" Binding="{Binding PipelineStep}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
