<UserControl x:Class="Brqosh.Desktop.Views.Pages.WageProtectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="ملف حماية الأجور" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="إلزامي نظامًا — يُرفع للبنك فيودع الرواتب"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ExportBtn" Content="تصدير الملف" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnExport"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <ComboBox x:Name="RunBox" DockPanel.Dock="Right" Width="280" FontSize="14"
                          VerticalAlignment="Center" Margin="0,0,12,0" SelectionChanged="OnRunChanged"/>
                <TextBlock DockPanel.Dock="Right" Text="دورة الرواتب" VerticalAlignment="Center"
                           Margin="0,0,10,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,10" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="0,0,0,10" Padding="16,12"
                x:Name="RefusalCard" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="⚠️ موظفون لم يدخلوا الملف — ولكلٍّ سبب:" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ItemsControl x:Name="RefusalList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="CsvBox" IsReadOnly="True" BorderThickness="0" FontSize="13"
                         FontFamily="Consolas" TextWrapping="NoWrap" FlowDirection="LeftToRight"
                         Background="Transparent" AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
