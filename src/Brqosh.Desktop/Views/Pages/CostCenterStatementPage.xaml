<UserControl x:Class="Brqosh.Desktop.Views.Pages.CostCenterStatementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="كشف مراكز التكلفة" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="إيراد ومصروف كل مركز — وغير المصنف يُعرض ولا يُخفى"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunBtn" Content="عرض" Style="{StaticResource PrimaryButton}"
                            Padding="24,9" Click="OnRun"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <DatePicker x:Name="ToBox" DockPanel.Dock="Right" FontSize="{DynamicResource FontSize.BodyLarge}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="إلى" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="FromBox" DockPanel.Dock="Right" FontSize="{DynamicResource FontSize.BodyLarge}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="من" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="مركز التكلفة" Binding="{Binding CostCenter}" Width="220"/>
                    <DataGridTextColumn Header="الحساب" Binding="{Binding AccountCode}" Width="110"/>
                    <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeText}" Width="100"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="الصافي" Binding="{Binding Net, StringFormat=N2}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
