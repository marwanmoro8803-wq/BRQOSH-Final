<Window x:Class="Brqosh.Desktop.Views.Pages.ClaimAdjudicationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="قرار شركة التأمين" Height="560" Width="980"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="قرار شركة التأمين" Style="{StaticResource PageTitleText}"
                   Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="المعتمد والمرفوض يطبقان المطالب تماماً — وبقية بينهما مال بلا حالة. والرفض بلا سبب لا يقبل."/>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" BorderThickness="0"
                      GridLinesVisibility="Horizontal" RowHeight="36" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الزيارة" Binding="{Binding VisitNumber}" Width="130"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="المطالَب" Binding="{Binding Claimed, StringFormat=N2}"
                                        Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="المعتمَد *" Binding="{Binding Approved}" Width="120"/>
                    <DataGridTextColumn Header="المرفوض *" Binding="{Binding Rejected}" Width="120"/>
                    <DataGridTextColumn Header="سبب الرفض" Binding="{Binding Reason}" Width="*"/>
                    <DataGridComboBoxColumn x:Name="DispositionColumn" Header="مصير المرفوض"
                                            SelectedValueBinding="{Binding Disposition}"
                                            SelectedValuePath="Value" DisplayMemberPath="Label"
                                            Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource AlertStrip}" Margin="0,12,0,0" Padding="16,10">
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="اترك المرفوض صفراً لسطر اعتمد كاملاً — والمعتمد يملأ المطالب."/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ القرار" Style="{StaticResource PrimaryButton}" Padding="20,9"
                    Click="OnSave"/>
            <Border Style="{StaticResource ToolbarSpacer}"/>
            <Button Content="اعتماد الكل" Style="{StaticResource SecondaryButton}" Padding="18,9"
                    Click="OnApproveAll"/>
            <Border Style="{StaticResource ToolbarSpacer}"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="18,9"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
