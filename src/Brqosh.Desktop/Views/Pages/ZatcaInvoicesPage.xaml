<UserControl x:Class="Brqosh.Desktop.Views.Pages.ZatcaInvoicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="فواتير ZATCA" FontSize="{DynamicResource FontSize.Title}"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="UBL · QR · ICV · إرسال هيئة الزكاة"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <WrapPanel>
                <Button x:Name="SubmitBtn" Content="إرسال المحدد للهيئة" Style="{StaticResource PrimaryButton}" Padding="18,8" Click="OnSubmit"/>
                <Button Content="إعادة إرسال المعلَّق" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="12,0,0,0" Click="OnResubmitPending"/>
                <Button Content="طباعة PDF" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="12,0,0,0" Click="OnPrintPdf"/>
                <Button Content="عرض XML" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="12,0,0,0" Click="OnViewXml"/>
                <Button Content="فتح المستند المصدر" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="12,0,0,0" Click="OnOpenSource"/>
                <Button x:Name="ReissueBtn" Content="إلغاء المرفوضة وإصدار مصحَّحة" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="12,0,0,0" Click="OnReissueRejected"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="ZatcaSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="140"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeAr}" Width="100"/>
                    <DataGridTextColumn Header="UUID" Binding="{Binding UuidShort}" Width="120"/>
                    <DataGridTextColumn Header="ICV" Binding="{Binding Icv}" Width="60"/>
                    <DataGridTextColumn Header="الوضع" Binding="{Binding ModeAr}" Width="90"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="120"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding GeneratedAt}" Width="150"/>
                    <DataGridTextColumn Header="QR (TLV)" Binding="{Binding QrShort}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
