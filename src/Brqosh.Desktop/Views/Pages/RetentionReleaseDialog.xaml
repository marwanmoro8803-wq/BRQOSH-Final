<Window x:Class="Brqosh.Desktop.Views.Pages.RetentionReleaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إفراج محتجز" Height="220" Width="400" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" ResizeMode="NoResize">
    <Border Padding="24" Background="{StaticResource BackgroundBrush}">
        <StackPanel>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
            <TextBlock Text="المبلغ" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="AmountBox" Style="{StaticResource AppTextBox}"/>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="ترحيل" Style="{StaticResource PrimaryButton}" Padding="24,8" Click="OnOk"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="24,8" Margin="12,0,0,0" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
