<UserControl x:Class="Brqosh.Desktop.Views.Pages.SalesInvoicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             xmlns:ctl="clr-namespace:Brqosh.Desktop.Controls"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ شريط الأدوات ══ -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="فواتير المبيعات" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="إصدار الفواتير وإرسالها لهيئة الزكاة وتسجيلها في ذمم العملاء"/>
                </StackPanel>
                <!-- المجموعة الأساسية: الإجراء الرئيسي -->
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewInvoiceBtn"
                            Content="＋ فاتورة جديدة"
                            Style="{StaticResource PrimaryButton}"
                            Padding="18,9"
                            Click="OnNewInvoice"/>
                </WrapPanel>

                <!-- فاصل -->
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>

                <!-- مجموعة ثانوية: عرض وإجراءات غير تدميرية -->
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض"
                            Padding="16,9" Margin="0,0,8,0"
                            Click="OnView"/>
                    <Button Content="عرض القيد"
                            Padding="16,9" Margin="0,0,8,0"
                            Click="OnViewJournal"/>
                    <Button Content="طباعة PDF"
                            Padding="16,9"
                            Click="OnPrintPdf"/>
                </WrapPanel>

                <!-- فاصل -->
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>

                <!-- مجموعة التنقل بين الصفحات -->
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PrevBtn" Content="→"
                            Padding="12,9" Margin="0,0,6,0"
                            ToolTip="الصفحة السابقة"
                            Click="OnPrev"
                            AutomationProperties.Name="الصفحة السابقة"/>
                    <Button x:Name="NextBtn" Content="←"
                            Padding="12,9"
                            ToolTip="الصفحة التالية"
                            Click="OnNext"
                            AutomationProperties.Name="الصفحة التالية"/>
                </WrapPanel>

                <!-- فاصل -->
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>

                <!-- زر الخطر: إلغاء — منفصل عن الباقي -->
                <Button DockPanel.Dock="Right"
                        x:Name="CancelInvoiceBtn"
                        Content="إلغاء"
                        Style="{StaticResource SoftDangerButton}"
                        Padding="16,9"
                        Click="OnCancelInvoice"/>

                <!-- عداد النتائج (يسار الشريط = يمين الشاشة في RTL) -->
                <Border DockPanel.Dock="Left"
                        Background="{DynamicResource PrimarySoftBrush}"
                        CornerRadius="3" Padding="12,5"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="CountText"
                               FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryDarkBrush}"/>
                </Border>
            </brq:ToolbarDockPanel>
        </Border>

        <!-- ══ البحث والفلترة ══ -->
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="12,8" Margin="0,12,0,0">
            <ctl:ListFilterBar x:Name="FilterBar" FilterChanged="OnFilterChanged"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Padding="8" Margin="0,12,0,12">
            <UniformGrid x:Name="KpiGrid" Columns="3"/>
        </Border>

        <!-- ══ جدول الفواتير ══ -->
        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="InvoicesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Background="Transparent"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة"
                                        Binding="{Binding InvoiceNumber}"
                                        Width="150"/>
                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding InvoiceDate}"
                                        Width="110"/>
                    <DataGridTextColumn Header="العميل"
                                        Binding="{Binding CustomerName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="قبل الضريبة"
                                        Binding="{Binding Subtotal, StringFormat=N2}" ElementStyle="{StaticResource NumericCellText}" CellStyle="{StaticResource DataGridNumericCell}"
                                        Width="120"/>
                    <DataGridTextColumn x:Name="VatColumn"
                                        Binding="{Binding VatAmount, StringFormat=N2}" ElementStyle="{StaticResource NumericCellText}" CellStyle="{StaticResource DataGridNumericCell}"
                                        Width="110"/>
                    <DataGridTextColumn Header="الإجمالي"
                                        Binding="{Binding GrandTotal, StringFormat=N2}" ElementStyle="{StaticResource NumericCellText}" CellStyle="{StaticResource DataGridNumericCell}"
                                        Width="125"/>
                    <DataGridTextColumn Header="الحالة"
                                        Binding="{Binding StatusAr}"
                                        Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
