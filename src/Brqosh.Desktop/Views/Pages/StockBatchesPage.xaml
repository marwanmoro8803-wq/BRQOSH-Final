<UserControl x:Class="Brqosh.Desktop.Views.Pages.StockBatchesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الدفعات والصلاحية" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="أرصدة الدفعات · وما قارب الانتهاء · وما انتهى"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <ComboBox x:Name="FilterBox" DockPanel.Dock="Right" Width="220" FontSize="{DynamicResource FontSize.BodyLarge}"
                          VerticalAlignment="Center" Margin="0,0,12,0" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="كل الدفعات" IsSelected="True"/>
                    <ComboBoxItem Content="ما يقارب الانتهاء (٩٠ يوماً)"/>
                    <ComboBoxItem Content="ما انتهت صلاحيته"/>
                </ComboBox>
                <TextBlock DockPanel.Dock="Right" Text="العرض" VerticalAlignment="Center"
                           Margin="0,0,10,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="المستودع" Binding="{Binding WarehouseName}" Width="160"/>
                    <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchNumber}" Width="150"/>
                    <DataGridTextColumn Header="الصلاحية" Binding="{Binding Expiry}" Width="120"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding Quantity, StringFormat=N4}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
