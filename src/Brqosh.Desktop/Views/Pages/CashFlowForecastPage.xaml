<UserControl x:Class="Brqosh.Desktop.Views.Pages.CashFlowForecastPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="التدفق النقدي المتوقع" FontSize="17"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="ثلاثة عشر أسبوعاً — من الذمم المستحقة لا من النية"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunBtn" Content="عرض" Style="{StaticResource PrimaryButton}"
                            Padding="24,9" Click="OnRun"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <DatePicker x:Name="AsOfBox" DockPanel.Dock="Right" FontSize="14"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="من تاريخ" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الأسبوع" Binding="{Binding WeekIndex}" Width="90"/>
                    <DataGridTextColumn Header="من" Binding="{Binding WeekStart}" Width="130"/>
                    <DataGridTextColumn Header="إلى" Binding="{Binding WeekEnd}" Width="130"/>
                    <DataGridTextColumn Header="متحصلات متوقعة" Binding="{Binding ProjectedInflows, StringFormat=N2}" Width="170"/>
                    <DataGridTextColumn Header="مدفوعات متوقعة" Binding="{Binding ProjectedOutflows, StringFormat=N2}" Width="170"/>
                    <DataGridTextColumn Header="الصافي" Binding="{Binding NetCashFlow, StringFormat=N2}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
