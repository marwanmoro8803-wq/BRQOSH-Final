<Window x:Class="Brqosh.Desktop.Views.Pages.LeaveRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طلب إجازة" Height="330" Width="680"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="طلب إجازة" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="الموظف *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="EmployeeBox" FontSize="14" DisplayMemberPath="Label"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="نوع الإجازة *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TypeBox" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem Content="سنوية"/>
                    <ComboBoxItem Content="مرضية"/>
                    <ComboBoxItem Content="بلا أجر"/>
                    <ComboBoxItem Content="وضع"/>
                    <ComboBoxItem Content="زواج"/>
                    <ComboBoxItem Content="وفاة"/>
                    <ComboBoxItem Content="حج"/>
                    <ComboBoxItem Content="امتحان"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="من *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="FromBox" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="إلى *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="ToBox" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="السبب" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ReasonBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource AlertStrip}" Margin="0,14,0,0" Padding="16,10"
                VerticalAlignment="Top">
            <TextBlock x:Name="HintText" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave"/>
            <Border Style="{StaticResource ToolbarSpacer}"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="18,9" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
