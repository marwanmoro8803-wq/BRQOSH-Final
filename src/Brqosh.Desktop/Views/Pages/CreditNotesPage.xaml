<UserControl x:Class="Brqosh.Desktop.Views.Pages.CreditNotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button Content="＋ إشعار دائن جديد" Style="{StaticResource PrimaryButton}" Padding="18,8"
                        DockPanel.Dock="Left" Click="OnNewNote"/>
                <TextBlock Text="إشعار الدائن هو الأداة النظامية لتصحيح فاتورة مرحّلة (مرتجع/خصم) — لا تُعدَّل الفاتورة نفسها."
                           VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="NotesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FontSize="14" RowHeight="36" Background="Transparent" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الإشعار" Binding="{Binding NoteNumber}" Width="140"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding NoteDate}" Width="110"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="الفاتورة الأصلية" Binding="{Binding InvoiceNumber}" Width="150"/>
                    <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="180"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
