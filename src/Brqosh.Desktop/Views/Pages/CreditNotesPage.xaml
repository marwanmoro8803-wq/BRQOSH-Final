<UserControl x:Class="Brqosh.Desktop.Views.Pages.CreditNotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="مردودات المبيعات" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="إشعارات دائن — تصحيح فواتير مرحّلة · لا تعديل مباشر"/>
                </StackPanel>                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewNoteBtn" Content="＋ إشعار دائن جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnNewNote"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض" Padding="16,9" Margin="0,0,8,0" Click="OnView"/>
                    <Button Content="عرض القيد" Padding="16,9" Margin="0,0,8,0" Click="OnViewJournal"/>
                    <Button Content="طباعة PDF" Padding="16,9" Margin="0,0,8,0" Click="OnPrintPdf"/>
                    <Button x:Name="PrevBtn" Content="→" Padding="12,9" Margin="0,0,6,0"
                            ToolTip="الصفحة السابقة" Click="OnPrev"
                            AutomationProperties.Name="الصفحة السابقة"/>
                    <Button x:Name="NextBtn" Content="←" Padding="12,9"
                            ToolTip="الصفحة التالية" Click="OnNext"
                            AutomationProperties.Name="الصفحة التالية"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="CancelNoteBtn" DockPanel.Dock="Right" Content="إلغاء"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9"
                        Click="OnCancelNote"/>
                <Border DockPanel.Dock="Left" Background="{DynamicResource PrimarySoftBrush}"
                        CornerRadius="3" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryDarkBrush}"/>
                </Border>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="NoteSummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="NotesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" Background="Transparent"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الإشعار" Binding="{Binding NoteNumber}" Width="140"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding NoteDate}" Width="110"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="الفاتورة الأصلية" Binding="{Binding InvoiceNumber}" Width="150"/>
                    <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="180"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
