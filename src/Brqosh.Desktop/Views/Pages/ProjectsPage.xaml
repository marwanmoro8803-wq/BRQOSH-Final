<UserControl x:Class="Brqosh.Desktop.Views.Pages.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddProjectBtn" Content="＋ مشروع جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAddProject"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddCostBtn" Content="تسجيل تكلفة" Padding="16,9" Click="OnAddCost"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="DeactivateBtn" DockPanel.Dock="Right" Content="إيقاف"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnDeactivate"/>
                <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Width="320"
                         DockPanel.Dock="Left" VerticalAlignment="Center"
                         TextChanged="OnSearchChanged" ToolTip="بحث بالكود أو الاسم"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="المشاريع" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="محفظة المشاريع · العقود · BOQ"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="8" Margin="0,12,0,12">
            <UniformGrid x:Name="KpiGrid" Columns="3"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="OnEdit" BorderThickness="0"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="اسم المشروع" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="160"/>
                    <DataGridTextColumn Header="قيمة العقد" Binding="{Binding ContractValue, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="محتجز %" Binding="{Binding RetentionPercent, StringFormat=N1}" Width="80"/>
                    <DataGridTextColumn Header="إجمالي BOQ" Binding="{Binding BoqTotal, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
