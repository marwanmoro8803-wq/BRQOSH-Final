<UserControl x:Class="Brqosh.Desktop.Views.Pages.PosReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Right" Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button Content="تصدير PDF" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="0,0,8,0" Click="OnExportPdf"/>
                    <Button Content="تحديث" Style="{StaticResource PrimaryButton}" Padding="22,8" Click="OnRefresh"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="تقارير نقاط البيع" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="ملخص يومي لمعاملات نقاط البيع" Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="120"/>
                    <DataGridTextColumn Header="عدد المعاملات" Binding="{Binding Transactions}" Width="130"/>
                    <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalSales, StringFormat=N2}" Width="150"/>
                    <DataGridTextColumn Header="ضريبة القيمة المضافة" Binding="{Binding VatAmount, StringFormat=N2}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
