<UserControl x:Class="Brqosh.Desktop.Views.Pages.InsurancePayersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="شركات التأمين" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="شركة التأمين عميل له ذمة — ومهلة سدادها تختلف عن مهلة المريض"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="NewBtn" Content="＋ شركة تأمين" Style="{StaticResource PrimaryButton}"
                            Padding="24,9" Click="OnNew"/>
                    <Button x:Name="DeactivateBtn" Content="إيقاف" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Padding="20,9" Click="OnDeactivate"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="مهلة السداد (يوم)" Binding="{Binding PaymentTermDays}" Width="150"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="150"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
