<UserControl x:Class="Brqosh.Desktop.Views.Pages.CrmLeadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="ConvertBtn" Content="تحويل لعميل" Style="{StaticResource SecondaryButton}"
                            Padding="16,9" Margin="0,0,8,0" Click="OnConvert"/>
                    <Button x:Name="AddBtn" Content="＋ عميل محتمل" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="العملاء المحتملون" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="CRM · G-10 · Leads"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,12,0,0">
            <DataGrid x:Name="LeadsGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="البريد" Binding="{Binding Email}" Width="180"/>
                    <DataGridTextColumn Header="المصدر" Binding="{Binding Source}" Width="100"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusLabel}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
