<Window x:Class="Brqosh.Desktop.Views.Pages.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="صنف جديد" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}" ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="إضافة صنف" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
        <TextBlock Text="كود الصنف *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>
        <TextBlock Text="اسم الصنف *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="وحدة القياس *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UnitBox" Style="{StaticResource AppTextBox}" Text="قطعة"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="النوع *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TypeCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" SelectedIndex="0">
                    <ComboBoxItem Content="مخزني (يتابع كمياً)"/>
                    <ComboBoxItem Content="خدمة (بلا مخزون)"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="سعر البيع" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PriceBox" Style="{StaticResource AppTextBox}" Text="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="الباركود" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="BarcodeBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
        </Grid>
        <!-- (CEEF-231 · ط1-٣د) نمطُ التتبّع — و`SetTracking` كان بلا مستدعٍ في الواجهة
             كلِّها. فصنفٌ لا يُعلَّم متتبَّعاً من الشاشة لا تُدخَل له دفعة، ولا صلاحية،
             ولا يصلح لصرف الأقدم انتهاءً — وكلُّ ما بُني من دفعاتٍ وصيدليةٍ ومطبخٍ
             خلف بابٍ لا مفتاحَ له. -->
        <TextBlock Text="التتبّع" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="TrackingCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" SelectedIndex="0" Margin="0,0,0,4">
            <ComboBoxItem Content="بلا تتبع"/>
            <ComboBoxItem Content="بالدفعة والصلاحية"/>
            <ComboBoxItem Content="بالرقم التسلسلي"/>
        </ComboBox>
        <TextBlock x:Name="TrackingHint" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="لا يُغيَّر نمط التتبع وللصنف رصيد قائم — صفِّ الرصيد بجرد أولا."/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" Margin="0,12,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
