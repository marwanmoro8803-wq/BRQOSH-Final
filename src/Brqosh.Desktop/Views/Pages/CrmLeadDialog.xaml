<Window x:Class="Brqosh.Desktop.Views.Pages.CrmLeadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عميل محتمل"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="إضافة عميل محتمل" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
        <TextBlock Text="الاسم *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>
        <TextBlock Text="الهاتف" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PhoneBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>
        <TextBlock Text="البريد" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="EmailBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>
        <TextBlock Text="المصدر" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="SourceBox" Style="{StaticResource AppComboBox}" Margin="0,0,0,4"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="SemiBold"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
