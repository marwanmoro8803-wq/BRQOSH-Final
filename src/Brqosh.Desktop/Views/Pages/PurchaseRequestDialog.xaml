<Window x:Class="Brqosh.Desktop.Views.Pages.PurchaseRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طلب شراء جديد"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="طلب شراء" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DatePickerBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="المورد *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="SupplierCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="المبرر / الغرض" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="JustificationBox" MinHeight="36" Padding="10,8" FontSize="{DynamicResource FontSize.BodyLarge}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36"
                      CellEditEnding="OnCellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="130" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="الإجمالي:" FontWeight="SemiBold"/>
            <TextBlock x:Name="TotalText" Margin="8,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
        </StackPanel>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ مسودة" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSaveDraft" IsDefault="True"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
