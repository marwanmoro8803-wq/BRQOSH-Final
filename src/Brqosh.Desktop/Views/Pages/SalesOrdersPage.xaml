<UserControl x:Class="Brqosh.Desktop.Views.Pages.SalesOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="InvoiceBtn" Content="إنشاء فاتورة" Style="{StaticResource SecondaryButton}"
                            Padding="16,9" Margin="0,0,8,0" Click="OnCreateInvoice"/>
                    <Button x:Name="NewBtn" Content="＋ أمر بيع" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="أوامر البيع" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="LIFECYCLE-32/33 · مسودة → مؤكد → مفوتر"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,12,0,0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNumber}" Width="120"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding OrderDate}" Width="110"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
