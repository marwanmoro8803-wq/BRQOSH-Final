<Window x:Class="Brqosh.Desktop.Views.Pages.PurchaseInvoiceDialog"
        KeyboardNavigation.TabNavigation="Cycle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Brqosh.Desktop.Ui"
        Title="فاتورة مشتريات جديدة"
        Width="900" Height="640"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="فاتورة مشتريات" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DatePickerBox" AutomationProperties.Name="التاريخ" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="المورد *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="SupplierCombo" AutomationProperties.Name="المورد" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectionChanged="OnSupplierSelected"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="مرجع فاتورة المورد *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ReferenceBox" AutomationProperties.Name="مرجع فاتورة المورد" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                <TextBlock Text="العملة" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CurrencyBox" ItemTemplate="{StaticResource CurrencyFlagItem}" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          FlowDirection="LeftToRight" AutomationProperties.Name="العملة"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="سعر الصرف" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RateBox" AutomationProperties.Name="سعر الصرف" Style="{StaticResource AppTextBox}" Text="1"/>
            </StackPanel>
            <!-- (جاهزيّةُ الإطلاق · ح-١١١) مستودعُ الاستلام — والأوّلُ «الافتراضيّ» فلا يتغيّر شيءٌ لمن لا يختار. -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0">
                <TextBlock Text="المستودع" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="WarehouseCombo" AutomationProperties.Name="المستودع" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"/>
            </StackPanel>
            <!-- (جاهزيّةُ الإطلاق · ح-١٤٤) المشروعُ المُحمَّلُ عليه — والأوّلُ «بلا مشروع» فلا يتغيّر شيءٌ لمن لا يختار. -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,10,0,0">
                <TextBlock Text="المشروع" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ProjectCombo" AutomationProperties.Name="المشروع" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"/>
                <!-- (جاهزيّةُ الإطلاق · ح-١٥٨) الأصلُ الذي تشتريه الفاتورة — نصُّه من السجلّ ثنائيّ اللغة في الكود. -->
                <TextBlock x:Name="AssetLabel" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                <ComboBox x:Name="AssetCombo" AutomationProperties.LabeledBy="{Binding ElementName=AssetLabel}" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <CheckBox x:Name="DeductibleCheck" Content="ضريبة المدخلات قابلة للخصم (مورد مسجل بفاتورة ضريبية صحيحة)"
                      IsChecked="True" FontSize="{DynamicResource FontSize.Body}"
                      Foreground="{DynamicResource TextSecondaryBrush}"/>
            <!-- (جاهزيّةُ الإطلاق · tax-zatca#12) معاملةُ الضريبة في الإقرار — المحلّيُّ أوّلاً فلا يتغيّر شيءٌ لمن لا يختار. -->
            <TextBlock Text="معاملة الضريبة في الإقرار" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
            <ComboBox x:Name="TreatmentCombo" AutomationProperties.Name="معاملة الضريبة في الإقرار" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" DisplayMemberPath="Label"
                      SelectionChanged="OnTreatmentChanged"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36" Background="Transparent"
                      CellEditEnding="OnCellEditEnding">
                <DataGrid.Columns>
                    <!-- (CEEF-229 · م2-٢٠) عمود اختيار الصنف — كان غائباً، فتُرحَّل كل
                         فاتورةٍ بـ ProductId = null ولا تدخل البضاعة المستودعَ إطلاقاً. -->
                    <DataGridComboBoxColumn x:Name="ProductColumn" Header="الصنف" Width="220"
                                            SelectedValueBinding="{Binding ProductId}"
                                            DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    <DataGridTextColumn Header="الوصف / الصنف" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="130"/>
                    <DataGridComboBoxColumn Header="الفئة الضريبية" Width="150"
                                                SelectedValueBinding="{Binding VatCategory}"
                                                SelectedValuePath="Value"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding Source={x:Static ui:VatCategoryOptions.All}}"/>
                    <!-- (جاهزيّةُ الإطلاق · ح-١٠٨) رقمُ الدفعة وصلاحيتُها — لشراء الدواء والغذاء مباشرةً بلا أمر. -->
                    <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchNumber}" Width="130"/>
                    <DataGridTemplateColumn Header="تاريخ الصلاحية" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker AutomationProperties.Name="تاريخ الصلاحية" SelectedDate="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0" FontSize="{DynamicResource FontSize.Body}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="130" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource TotalsCard}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="قبل الضريبة:" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtotalText" Text="0.00" Margin="8,0,28,0" FontWeight="Bold"/>
                <TextBlock Text="الضريبة 15%:" FontWeight="SemiBold"/>
                <TextBlock x:Name="VatText" Text="0.00" Margin="8,0,28,0" FontWeight="Bold"/>
                <TextBlock Text="الإجمالي:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalText" Text="0.00" Margin="8,0,0,0" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}" FontSize="{DynamicResource FontSize.Title}"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                <Button Content="ترحيل الفاتورة" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
