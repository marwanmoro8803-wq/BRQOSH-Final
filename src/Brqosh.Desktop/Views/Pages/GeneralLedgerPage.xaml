<UserControl x:Class="Brqosh.Desktop.Views.Pages.GeneralLedgerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="دفتر الأستاذ العام" FontSize="18"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="حركة الحسابات · رصيد متحرك · قيود مرحّلة"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDate" Width="150" FontSize="14"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <DatePicker x:Name="ToDate" Width="150" FontSize="14"/>
                <TextBlock Text="حساب (اختياري)" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <TextBox x:Name="AccountFilter" Style="{StaticResource AppTextBox}" Width="100"/>
                <Button Content="عرض" Style="{StaticResource PrimaryButton}" Padding="24,7" Margin="12,0,0,0" Click="OnRun"/>
                <Button Content="تصدير PDF" Style="{StaticResource SecondaryButton}" Padding="24,7" Margin="12,0,0,0" Click="OnExportPdf"/>
                <Button x:Name="PrevBtn" Content="السابق" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="16,0,0,0" Click="OnPrev"/>
                <Button x:Name="NextBtn" Content="التالي" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="8,0,0,0" Click="OnNext"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="GlSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FontSize="13" RowHeight="32" Background="Transparent" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الحساب" Binding="{Binding AccountCode}" Width="90"/>
                    <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountNameAr}" Width="160"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDate}" Width="100"/>
                    <DataGridTextColumn Header="رقم القيد" Binding="{Binding EntryNumber}" Width="130"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat=N2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
