<UserControl x:Class="Brqosh.Desktop.Views.Pages.PayrollPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="NewBtn" Content="＋ دورة رواتب جديدة" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnNew"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PostBtn" Content="ترحيل المحدد" Padding="16,9" Margin="0,0,8,0" Click="OnPost"/>
                    <Button Content="عرض القيد" Padding="16,9" Click="OnViewJournal"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="ReverseBtn" DockPanel.Dock="Right" Content="↩ عكس"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnReverse"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="AccrueEosBtn" DockPanel.Dock="Right" Content="تخصيص مكافأة نهاية الخدمة"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnAccrueEndOfService"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الرواتب" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="دورات الصرف · GOSI · ترحيل محاسبي"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="8" Margin="0,12,0,12">
            <UniformGrid x:Name="KpiGrid" Columns="3"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الفترة" Binding="{Binding PeriodCode}" Width="100"/>
                    <DataGridTextColumn Header="تاريخ الصرف" Binding="{Binding PayDate}" Width="110"/>
                    <DataGridTextColumn Header="عدد الموظفين" Binding="{Binding EmployeeCount}" Width="110"/>
                    <DataGridTextColumn Header="إجمالي الرواتب" Binding="{Binding TotalGross, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="الصافي" Binding="{Binding TotalNet, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
