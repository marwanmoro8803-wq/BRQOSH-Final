<UserControl x:Class="Brqosh.Desktop.Views.Pages.BoqPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="جدول الكميات BOQ" FontSize="{DynamicResource FontSize.Title}"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="بنود مشروع · كميات · أسعار · إجمالي تعاقدي"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}" Margin="0,0,0,12">
            <brq:ToolbarDockPanel>
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="المشروع:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ProjectBox" Width="360" Padding="10,8"
                              DisplayMemberPath="Name" SelectionChanged="OnProjectChanged"/>
                </WrapPanel>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Margin="0,0,0,12">
            <brq:ToolbarDockPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddItemBtn" Content="＋ بند جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAddItem"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="EditItemBtn" Content="تعديل" Padding="16,9" Click="OnEditItem"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="DeleteItemBtn" DockPanel.Dock="Right" Content="حذف"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnDeleteItem"/>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource AlertStrip}" Margin="0,0,0,12" Padding="16,10">
            <TextBlock x:Name="BoqSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" SelectionMode="Single"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم البند" Binding="{Binding ItemNumber}" Width="100"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="80"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
