<UserControl x:Class="Brqosh.Desktop.Views.Pages.SubcontractorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="مقاولو الباطن" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="عقود باطن · محتجز · استكمال/إلغاء"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddAgreementBtn" Content="＋ عقد باطن جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAddAgreement"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="WithholdBtn" Content="تسجيل محتجز" Padding="16,9" Margin="0,0,8,0" Click="OnWithholdRetention"/>
                    <Button x:Name="CompleteBtn" Content="استكمال" Padding="16,9" Click="OnComplete"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="إلغاء"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnCancel"/>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SubcontractorSummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم العقد" Binding="{Binding AgreementNumber}" Width="130"/>
                    <DataGridTextColumn Header="المشروع" Binding="{Binding ProjectName}" Width="*"/>
                    <DataGridTextColumn Header="مقاول الباطن" Binding="{Binding SupplierName}" Width="180"/>
                    <DataGridTextColumn Header="القيمة" Binding="{Binding ContractValue, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="محتجز %" Binding="{Binding RetentionPercent, StringFormat=N1}" Width="80"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
