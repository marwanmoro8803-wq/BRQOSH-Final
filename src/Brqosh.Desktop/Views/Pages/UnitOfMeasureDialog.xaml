<Window x:Class="Brqosh.Desktop.Views.Pages.UnitOfMeasureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="وحدة قياس" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="وحدة قياس جديدة" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="الرمز *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}" MaxLength="16"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="الاسم *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="رمز UN/ECE *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UnCodeBox" Style="{StaticResource AppTextBox}" MaxLength="16"
                         FlowDirection="LeftToRight"/>
            </StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="وحدة الأساس — اتركها فارغة إن كانت هذه هي الأصل"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="BaseCodeBox" Style="{StaticResource AppTextBox}" MaxLength="16"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="معامل التحويل *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FactorBox" Style="{StaticResource AppTextBox}" Text="1"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Click="OnCancel"/>
            <Button DockPanel.Dock="Right" Content="حفظ" Style="{StaticResource PrimaryButton}"
                    Padding="26,9" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
