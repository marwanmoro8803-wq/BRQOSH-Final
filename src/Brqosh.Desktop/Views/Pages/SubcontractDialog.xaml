<Window x:Class="Brqosh.Desktop.Views.Pages.SubcontractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عقد مقاول باطن"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="عقد مقاول باطن" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="المشروع *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ProjectBox" DisplayMemberPath="Name" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"/>

        <TextBlock Text="مقاول الباطن (مورد) *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="SupplierBox" DisplayMemberPath="Name" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"/>

        <TextBlock Text="رقم العقد *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="تاريخ العقد" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DatePicker" FontSize="{DynamicResource FontSize.BodyLarge}" Margin="0,0,0,14"/>

        <TextBlock Text="قيمة العقد *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ValueBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="نسبة المحتجز %" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="RetentionBox" Style="{StaticResource AppTextBox}" Text="10" Margin="0,0,0,14"/>

        <TextBlock Text="نطاق الأعمال" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ScopeBox" Style="{StaticResource AppTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ وتفعيل" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
