<Window x:Class="Brqosh.Desktop.Views.Pages.ReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حجز" Width="580" Height="430"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="حجز جديد" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="رقم الحجز *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="الغرفة *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="RoomBox" FontSize="{DynamicResource FontSize.BodyLarge}" SelectionChanged="OnRoomChanged"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="النزيل *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="GuestBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="الوصول *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="CheckInBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="المغادرة *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="CheckOutBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="سعر الليلة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RateBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="ويوم المغادرة غير محسوب: الوصول الأول والمغادرة الثالث ليلتان لا ثلاث"
                       Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Click="OnCancel"/>
            <Button DockPanel.Dock="Right" Content="حفظ" Style="{StaticResource PrimaryButton}"
                    Padding="26,9" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
