<UserControl x:Class="Brqosh.Desktop.Views.Pages.PurchaseOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="أوامر الشراء" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="PO · اعتماد · استلام · فاتورة"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewBtn" Content="＋ أمر شراء جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnNew"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض" Padding="16,9" Margin="0,0,8,0" Click="OnView"/>
                    <Button x:Name="SubmitBtn" Content="إرسال للموافقة" Padding="16,9" Margin="0,0,8,0" Click="OnSubmit"/>
                    <Button x:Name="ApproveBtn" Content="اعتماد" Padding="16,9" Margin="0,0,8,0" Click="OnApprove"/>
                    <Button x:Name="RejectBtn" Content="رفض" Style="{StaticResource SoftDangerButton}"
                            Padding="16,9" Margin="0,0,8,0" Click="OnReject"/>
                    <!-- (جاهزيّةُ الإطلاق · ح-١١٣) مستودعُ الاستلام لفاتورة الأمر — والأوّلُ «الافتراضيّ». -->
                    <StackPanel x:Name="WarehousePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="المستودع" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="WarehouseCombo" Width="200" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                                  DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    </StackPanel>
                    <Button x:Name="CreateInvoiceBtn" Content="إنشاء فاتورة من المحدد" Padding="16,9" Click="OnCreateInvoice"/>
                    <Button x:Name="PrevBtn" Content="→" Padding="12,9" Margin="8,0,6,0"
                            ToolTip="الصفحة السابقة" Click="OnPrev"
                            AutomationProperties.Name="الصفحة السابقة"/>
                    <Button x:Name="NextBtn" Content="←" Padding="12,9"
                            ToolTip="الصفحة التالية" Click="OnNext"
                            AutomationProperties.Name="الصفحة التالية"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="CancelOrderBtn" DockPanel.Dock="Right" Content="إلغاء"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9"
                        Click="OnCancelOrder"/>
                <Border DockPanel.Dock="Left" Background="{DynamicResource PrimarySoftBrush}"
                        CornerRadius="3" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryDarkBrush}"/>
                </Border>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="OrderSummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      BorderThickness="0" MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNumber}" Width="130"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding OrderDate}" Width="100"/>
                    <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                    <DataGridTextColumn Header="المسار" Binding="{Binding PipelineStep}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
