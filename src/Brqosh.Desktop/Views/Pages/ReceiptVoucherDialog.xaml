<Window x:Class="Brqosh.Desktop.Views.Pages.ReceiptVoucherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سند قبض جديد"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="سند قبض" FontSize="19" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="التاريخ *" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DatePicker x:Name="DatePickerBox" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="العميل *" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CustomerCombo" FontSize="14" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectionChanged="OnCustomerSelected"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="BalanceText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="المبلغ *" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="AmountBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="طريقة القبض *" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="MethodCombo" FontSize="14" Padding="10,8" SelectedIndex="0">
                    <ComboBoxItem Content="نقداً (الصندوق)"/>
                    <ComboBoxItem Content="بنك (حوالة/شبكة)"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="البيان *" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBox}"/>

        <TextBlock Text="المرجع (رقم حوالة/شيك — اختياري)" FontSize="13"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,4"/>
        <TextBox x:Name="ReferenceBox" Style="{StaticResource AppTextBox}"/>

        <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="ترحيل السند" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
            <Button Content="إلغاء" Margin="10,0,0,0" Padding="24,9" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
