<Window x:Class="Brqosh.Desktop.Views.Pages.ReceiptVoucherDialog"
        KeyboardNavigation.TabNavigation="Cycle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Brqosh.Desktop.Ui"
        Title="سند قبض جديد"
        Width="720" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Text="سند قبض" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="DatePickerBox" AutomationProperties.Name="{loc:Str Key=Field.Date}" FontSize="{DynamicResource FontSize.BodyLarge}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="العميل *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CustomerCombo" AutomationProperties.Name="{loc:Str Key=Field.Customer}" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectionChanged="OnCustomerSelected"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="BalanceText" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="المبلغ *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AmountBox" AutomationProperties.Name="{loc:Str Key=Field.Amount}" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="طريقة القبض *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MethodCombo" AutomationProperties.Name="{loc:Str Key=Field.ReceiptMethod}" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" SelectedIndex="0"
                              SelectionChanged="OnMethodChanged">
                        <ComboBoxItem Content="نقداً (الصندوق)"/>
                        <ComboBoxItem Content="بنك (حوالة/شبكة)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- (CEEF-231 · ط1-٤ب) العملةُ وسعرُها — والنطاقُ يحملهما منذ ط1-٤ ولا حقلَ
                 يصل إليهما. فتحصيلٌ بالدولار يُدخَل محوَّلاً بيدٍ، فتضيع القيمةُ الأصلية
                 ولا يُقيَّد فرقُ عملةٍ محقَّق — والحسابان 4108 و5218 بلا كاتبٍ من الشاشة. -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Str Key=Field.Currency}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CurrencyBox" ItemTemplate="{StaticResource CurrencyFlagItem}" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                              FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Str Key=Field.Currency}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Str Key=Field.ExchangeRate}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RateBox" AutomationProperties.Name="{loc:Str Key=Field.ExchangeRate}" Style="{StaticResource AppTextBox}" Text="1"/>
                </StackPanel>
            </Grid>

            <!-- (CEEF-231 · ط1-٢ج) خصمُ السداد المبكر — والحسابان 4103 و5214 كانا بلا
                 كاتبٍ في المستودع كلِّه. وبغيره تبقى قيمةُ الخصم ذمّةً مفتوحةً تُطالَب،
                 أو تُشطب بقيدٍ يدويٍّ لا يراه الدفترُ المساعد فتنكسر هـ-١. -->
            <TextBlock Text="{loc:Str Key=Field.SettlementDiscountAllowed}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SettlementDiscountBox" AutomationProperties.Name="{loc:Str Key=Field.SettlementDiscountAllowed}" Style="{StaticResource AppTextBox}"
                     Text="0.00" Margin="0,0,0,14"/>

            <TextBlock Text="البيان *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DescriptionBox" AutomationProperties.Name="{loc:Str Key=Field.Description}" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

            <TextBlock Text="{loc:Str Key=Field.ReferenceOptional}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ReferenceBox" AutomationProperties.Name="{loc:Str Key=Field.ReferenceOptional}" Style="{StaticResource AppTextBox}" Margin="0,0,0,4"/>

            <StackPanel x:Name="BankPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Text="{loc:Str Key=Field.BankAccount}" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BankCombo" AutomationProperties.Name="{loc:Str Key=Field.BankAccount}" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"/>
            </StackPanel>

            <TextBlock Text="تخصيص على الفواتير/المستخلصات (اختياري — إن وُجد يجب أن يساوي المبلغ)"
                       Style="{StaticResource FormSectionTitle}"/>
            <DataGrid x:Name="AllocGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      Height="160" HeadersVisibility="Column" FontSize="{DynamicResource FontSize.Body}" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المستند" Binding="{Binding DocumentNumber}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeLabel}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="التخصيص" Binding="{Binding AllocateAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="{loc:Str Key=Doc.AutoAllocate}" Style="{StaticResource GhostButton}" Padding="12,6" Click="OnAutoAllocate"/>
                <TextBlock x:Name="AllocSumText" Margin="16,6,0,0" FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="{loc:Str Key=Doc.PostVoucher}" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
                <Button Content="{loc:Str Key=Common.Cancel}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
