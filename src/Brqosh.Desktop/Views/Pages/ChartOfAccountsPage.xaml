<UserControl x:Class="Brqosh.Desktop.Views.Pages.ChartOfAccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- شريط الأدوات -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button Content="＋ حساب جديد" Style="{StaticResource PrimaryButton}" Padding="18,8"
                        DockPanel.Dock="Left" Click="OnAddAccount"/>
                <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Width="320"
                         DockPanel.Dock="Right" HorizontalAlignment="Right"
                         TextChanged="OnSearchChanged" ToolTip="بحث بالكود أو الاسم"/>
            </DockPanel>
        </Border>

        <!-- شجرة الحسابات -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TreeView x:Name="AccountsTree" BorderThickness="0" FontSize="14">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Padding" Value="4,4"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>
    </Grid>
</UserControl>
