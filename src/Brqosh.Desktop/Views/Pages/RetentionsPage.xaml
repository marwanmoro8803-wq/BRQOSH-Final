<UserControl x:Class="Brqosh.Desktop.Views.Pages.RetentionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="المحتجزات" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="عميل · باطن · إفراج · مشاريع"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ReleaseCustomerBtn" Content="إفراج محتجز عميل" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnReleaseCustomer"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ReleaseSubBtn" Content="إفراج محتجز باطن" Padding="16,9" Click="OnReleaseSubcontract"/>
                </WrapPanel>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="RetentionSummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="كود المشروع" Binding="{Binding ProjectCode}" Width="110"/>
                    <DataGridTextColumn Header="اسم المشروع" Binding="{Binding ProjectName}" Width="*"/>
                    <DataGridTextColumn Header="محتجز عميل" Binding="{Binding CustomerRetentionHeld, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="مُفرج عميل" Binding="{Binding CustomerRetentionReleased, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="متاح عميل" Binding="{Binding CustomerRetentionAvailable, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="محتجز باطن" Binding="{Binding SubcontractRetentionHeld, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="مُفرج باطن" Binding="{Binding SubcontractRetentionReleased, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="متاح باطن" Binding="{Binding SubcontractRetentionAvailable, StringFormat=N2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
