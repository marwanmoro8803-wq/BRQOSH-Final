<Window x:Class="Brqosh.Desktop.Views.Pages.VisitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="زيارة" Width="820" Height="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="زيارة جديدة" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="رقم الزيارة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="DateBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="الطبيب *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DoctorBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="المريض *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PatientBox" FontSize="{DynamicResource FontSize.BodyLarge}" SelectionChanged="OnPatientChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="وثيقة التأمين — واتركها فارغة للحساب الخاص"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PolicyBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الخدمة" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice}" Width="120"/>
                    <!-- (CEEF-231 · ط3-٢ج) صنفُ الصيدلية — وبغيره يُصرف الدواء ولا ينقص
                         من المستودع، فتكلفةُ المبيعات صفر والربحُ مئةٌ بالمئة. اترك
                         العمودَ فارغاً لسطر الخدمة. -->
                    <DataGridComboBoxColumn x:Name="ProductColumn" Header="صنف الصيدلية" Width="200"
                                            SelectedValueBinding="{Binding ProductId}"
                                            DisplayMemberPath="Label" SelectedValuePath="Id"/>
                    <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchNumber}" Width="120"/>
                    <!-- (جاهزيّةُ الإطلاق · ح-١١) المعاملةُ الضريبيّةُ للسطر — وكانت مسمَّرةً
                         خاضعةً بـ15%. والرعايةُ الصحيةُ للمواطن صفرية، وكذلك الأدويةُ
                         والمعدّاتُ الطبية. والافتراضُ «خاضعة» فلا يتغيّر ما مضى. -->
                    <DataGridComboBoxColumn x:Name="TreatmentColumn" Header="الضريبة" Width="220"
                                            SelectedItemBinding="{Binding Treatment}"
                                            DisplayMemberPath="Label"/>
                    <DataGridCheckBoxColumn Header="مشمولة بالوثيقة" Binding="{Binding IsCovered}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Click="OnCancel"/>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource PageSubtitleText}"
                       Text="وما لا تشمله الوثيقة على المريض كله مهما بلغت النسبة"/>
            <Button DockPanel.Dock="Right" Content="حفظ" Style="{StaticResource PrimaryButton}"
                    Padding="26,9" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
