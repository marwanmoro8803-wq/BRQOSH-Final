<UserControl x:Class="Brqosh.Desktop.Views.Pages.FiscalPeriodsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="الفترات المالية" FontSize="18"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="إقفال شهري · إقفال سنوي SOCPA · قيود مرحّلة"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="ClosePeriodBtn" Content="إقفال الفترة المحددة"
                            Style="{StaticResource PrimaryButton}" Padding="18,9" Click="OnClose"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ReopenPeriodBtn" Content="إعادة فتح الفترة المحددة"
                            Padding="16,9" Click="OnReopen"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button DockPanel.Dock="Right" x:Name="YearEndBtn" Content="إقفال سنوي (SOCPA)"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnYearEndClose"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="PeriodSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="PeriodsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الفترة" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="من" Binding="{Binding StartDate}" Width="120"/>
                    <DataGridTextColumn Header="إلى" Binding="{Binding EndDate}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="110"/>
                    <DataGridTextColumn Header="عدد القيود" Binding="{Binding EntryCount}" Width="110"/>
                    <DataGridTextColumn Header="أُقفلت في" Binding="{Binding ClosedAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
