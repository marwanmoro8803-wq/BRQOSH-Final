<UserControl x:Class="Brqosh.Desktop.Views.Pages.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="AddBtn" Content="＋ صنف جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="DeactivateBtn" DockPanel.Dock="Right" Content="إيقاف"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9"
                        Click="OnDeactivate"/>
                <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Width="320"
                         DockPanel.Dock="Left" VerticalAlignment="Center"
                         TextChanged="OnSearch" ToolTip="بحث بالكود أو الاسم"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الأصناف" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="مخزون · تسعير · متوسط تكلفة"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="InventorySummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      MouseDoubleClick="OnEdit" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="80"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeAr}" Width="90"/>
                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="متوسط التكلفة" Binding="{Binding WeightedAverageCost, StringFormat=N4}" Width="120"/>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
