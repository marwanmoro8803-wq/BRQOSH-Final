<UserControl x:Class="Brqosh.Desktop.Views.Pages.SalesQuotationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- (جاهزيّةُ الإطلاق · ح-١١٥ · order-to-cash-procure-to-pay-inventory#8) قبولٌ ورفضٌ وتحويلٌ إلى أمر بيع. -->
                    <Button x:Name="AcceptBtn" Content="قبول العرض" Style="{StaticResource SecondaryButton}"
                            Padding="16,9" Margin="0,0,8,0" Click="OnAccept"/>
                    <Button x:Name="RejectBtn" Content="رفض العرض" Style="{StaticResource SecondaryButton}"
                            Padding="16,9" Margin="0,0,8,0" Click="OnReject"/>
                    <Button x:Name="ConvertBtn" Content="تحويل إلى أمر بيع" Style="{StaticResource SecondaryButton}"
                            Padding="16,9" Margin="0,0,8,0" Click="OnConvert"/>
                    <Button x:Name="AddBtn" Content="＋ عرض سعر"
                            Style="{StaticResource PrimaryButton}" Padding="18,9" Click="OnAdd"/>
                </WrapPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="عروض الأسعار" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="LIFECYCLE-31 · مبيعات مبكرة"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="4,10,4,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="0,12,0,0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم العرض" Binding="{Binding QuotationNumber}" Width="120"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding QuotationDate}" Width="110"/>
                    <DataGridTextColumn Header="صالح حتى" Binding="{Binding ValidUntil}" Width="110"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
