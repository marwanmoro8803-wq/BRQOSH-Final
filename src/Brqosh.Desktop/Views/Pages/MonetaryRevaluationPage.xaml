<UserControl x:Class="Brqosh.Desktop.Views.Pages.MonetaryRevaluationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="إعادة تقييم الذمم بالعملات" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="البنود النقدية تُترجم بسعر الإقفال — والقيد يُعكس في اليوم التالي"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunBtn" Content="إعادة التقييم" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnRun"/>
                    <!-- (جاهزيّةُ الإطلاق · ح-٣٨) سعرٌ خاطئٌ يُلغى من هنا —
                         وكانت رسالةُ الرفض تُحيل إلى عكسٍ مرفوضٍ في نفسِه. -->
                    <Button x:Name="CancelBtn" Content="إلغاء تقييم التاريخ" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Padding="18,9" Click="OnCancelRevaluation"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="عرض المكشوف"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnRefresh"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <DatePicker x:Name="AsOfBox" DockPanel.Dock="Right" FontSize="{DynamicResource FontSize.BodyLarge}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="تاريخ الإقفال" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" BorderThickness="0"
                      GridLinesVisibility="Horizontal" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyCode}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ذمم مدينة بالعملة" Binding="{Binding ForeignReceivable, StringFormat=N2}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="المقيَّد بالريال" Binding="{Binding BookedReceivable, StringFormat=N2}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ذمم دائنة بالعملة" Binding="{Binding ForeignPayable, StringFormat=N2}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="المقيَّد بالريال" Binding="{Binding BookedPayable, StringFormat=N2}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="سعر الإقفال" Binding="{Binding ClosingRate}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
