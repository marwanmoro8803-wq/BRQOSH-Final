<UserControl x:Class="Brqosh.Desktop.Views.Pages.SuppliersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الموردون" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="AP · أرصدة · ضريبة المشتريات"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="AddSupplierBtn" Content="＋ مورد جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAddSupplier"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <!-- (CEEF-229 · م2-٢٣) طريق العودة من الإيقاف. -->
                <Button x:Name="ReactivateBtn" DockPanel.Dock="Right" Content="إعادة تفعيل"
                        Style="{StaticResource SecondaryButton}" Padding="16,9"
                        Click="OnReactivate" Visibility="Collapsed"/>
                <CheckBox x:Name="ShowInactiveCheck" DockPanel.Dock="Right" Content="إظهار الموقوف"
                          VerticalAlignment="Center" Margin="12,0"
                          Checked="OnToggleInactive" Unchecked="OnToggleInactive"/>
                <Button x:Name="DeactivateBtn" DockPanel.Dock="Right" Content="إيقاف"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9"
                        Click="OnDeactivate"/>
                <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Width="320"
                         DockPanel.Dock="Left" VerticalAlignment="Center"
                         TextChanged="OnSearchChanged" ToolTip="بحث بالاسم أو الرقم الضريبي"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SupplierSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="SuppliersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="OnEdit" BorderThickness="0"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المورد" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="الرقم الضريبي" Binding="{Binding VatRegistrationNumber}" Width="160"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="140"/>
                    <DataGridTextColumn Header="مسجل ضريبياً" Binding="{Binding VatStatus}" Width="120"/>
                    <DataGridTextColumn Header="الرصيد المستحق له" Binding="{Binding Balance, StringFormat=N2}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
