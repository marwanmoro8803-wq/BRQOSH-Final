<UserControl x:Class="Brqosh.Desktop.Views.Pages.ReceiptVouchersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="سندات القبض" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="تحصيل · نقد/بنك · تخصيص فواتير"/>
                </StackPanel>                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="NewVoucherBtn" Content="＋ سند قبض جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnNewVoucher"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض القيد" Padding="16,9" Margin="0,0,8,0" Click="OnView"/>
                    <Button Content="طباعة PDF" Padding="16,9" Margin="0,0,8,0" Click="OnPrintPdf"/>
                    <Button x:Name="PrevBtn" Content="→" Padding="12,9" Margin="0,0,6,0"
                            ToolTip="الصفحة السابقة" Click="OnPrev"/>
                    <Button x:Name="NextBtn" Content="←" Padding="12,9"
                            ToolTip="الصفحة التالية" Click="OnNext"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="ReverseBtn" DockPanel.Dock="Right" Content="↩ عكس"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9"
                        Click="OnReverse"/>
                <Border DockPanel.Dock="Left" Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="20" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="VoucherSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="VouchersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="140"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding VoucherDate}" Width="110"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="طريقة القبض" Binding="{Binding MethodAr}" Width="110"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="140"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="200"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
