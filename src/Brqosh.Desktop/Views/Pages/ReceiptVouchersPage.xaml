<UserControl x:Class="Brqosh.Desktop.Views.Pages.ReceiptVouchersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button Content="＋ سند قبض جديد" Style="{StaticResource PrimaryButton}" Padding="18,8"
                        DockPanel.Dock="Left" Click="OnNewVoucher"/>
                <TextBlock x:Name="TotalText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="VouchersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FontSize="14" RowHeight="36" Background="Transparent" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="140"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding VoucherDate}" Width="110"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="طريقة القبض" Binding="{Binding MethodAr}" Width="110"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="140"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
