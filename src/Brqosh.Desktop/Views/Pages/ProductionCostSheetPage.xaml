<UserControl x:Class="Brqosh.Desktop.Views.Pages.ProductionCostSheetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="كشف تكلفة الإنتاج" FontSize="{DynamicResource FontSize.Title}"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="من قيد إكمال كل أمر: المواد والأجر والتحميل وتكلفة الوحدة"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <WrapPanel>
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDate" Width="140"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <DatePicker x:Name="ToDate" Width="140"/>
                <Button Content="عرض" Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="12,0,0,0" Click="OnRefresh"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Body}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="0,12,0,12">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnOrderSelected"
                      BorderThickness="0" FontSize="{DynamicResource FontSize.Body}" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الأمر" Binding="{Binding OrderNumber}" Width="110"/>
                    <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="تاريخ الإكمال" Binding="{Binding CompletedOn, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="المخطط" Binding="{Binding PlannedQuantity, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="المنتج فعلاً" Binding="{Binding ProducedQuantity, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الإنتاجية %" Binding="{Binding YieldPercent, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="المواد" Binding="{Binding MaterialCost, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الأجر" Binding="{Binding LabourCost, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="التحميل" Binding="{Binding OverheadCost, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding UnitCost, StringFormat=N4}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="استهلاك المواد للأمر المحدد" FontWeight="SemiBold" Margin="4,0,0,6"/>

        <Border Grid.Row="4" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" FontSize="{DynamicResource FontSize.Body}" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الخامة" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="المخطط" Binding="{Binding PlannedQuantity, StringFormat=N4}" Width="110"/>
                    <DataGridTextColumn Header="المصروف" Binding="{Binding IssuedQuantity, StringFormat=N4}" Width="110"/>
                    <DataGridTextColumn Header="الفرق" Binding="{Binding QuantityVariance, StringFormat=N4}" Width="110"/>
                    <DataGridTextColumn Header="تكلفة المصروف" Binding="{Binding IssuedCost, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
