<UserControl x:Class="Brqosh.Desktop.Views.Pages.VatReturnPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="إقرار ضريبة القيمة المضافة" FontSize="18"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="مخرجات · مدخلات · صافي مستحق/مسترد"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <WrapPanel>
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDate" Width="160" FontSize="14"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <DatePicker x:Name="ToDate" Width="160" FontSize="14"/>
                <Button Content="عرض الإقرار" Style="{StaticResource PrimaryButton}" Padding="24,7" Margin="16,0,0,0" Click="OnRun"/>
                <Button Content="تصدير PDF" Style="{StaticResource SecondaryButton}" Padding="24,7" Margin="12,0,0,0" Click="OnExportPdf"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Padding="20">
            <StackPanel x:Name="ReportPanel"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SummaryCard}">
            <TextBlock x:Name="TotalsText" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
    </Grid>
</UserControl>
