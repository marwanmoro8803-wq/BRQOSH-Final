<UserControl x:Class="Brqosh.Desktop.Views.Pages.ReservationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الحجوزات وحسابات النزلاء" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="إيراد الغرفة يُستحق ليلة بليلة — لا عند الوصول"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="AddBtn" Content="＋ حجز" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="CheckOutBtn" DockPanel.Dock="Right" Content="مغادرة وتصفية"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnCheckOut"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="AccrueBtn" DockPanel.Dock="Right" Content="تقييد الليالي"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnAccrue"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="CheckInBtn" DockPanel.Dock="Right" Content="إنزال النزيل"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnCheckIn"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الحجز" Binding="{Binding Number}" Width="130"/>
                    <DataGridTextColumn Header="الغرفة" Binding="{Binding RoomNumber}" Width="110"/>
                    <DataGridTextColumn Header="النزيل" Binding="{Binding GuestName}" Width="*"/>
                    <DataGridTextColumn Header="الوصول" Binding="{Binding CheckIn}" Width="110"/>
                    <DataGridTextColumn Header="المغادرة" Binding="{Binding CheckOut}" Width="110"/>
                    <DataGridTextColumn Header="الليالي" Binding="{Binding Nights}" Width="80"/>
                    <DataGridTextColumn Header="سعر الليلة" Binding="{Binding Rate, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="رصيد الحساب" Binding="{Binding FolioTotal, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
