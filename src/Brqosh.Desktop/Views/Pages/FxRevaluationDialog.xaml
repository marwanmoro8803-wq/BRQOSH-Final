<Window x:Class="Brqosh.Desktop.Views.Pages.FxRevaluationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعادة تقييم عملة"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="تاريخ التقييم *" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DatePicker" FontSize="{DynamicResource FontSize.BodyLarge}" Margin="0,0,0,14"/>

        <TextBlock x:Name="RateLabel" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="RateBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock x:Name="BalanceLabel" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ForeignBalanceBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="ترحيل التقييم" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
