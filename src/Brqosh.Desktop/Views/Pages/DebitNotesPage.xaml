<UserControl x:Class="Brqosh.Desktop.Views.Pages.DebitNotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="إشعارات مدين" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="تصحيح فواتير مشتريات مرحّلة — AP"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewBtn" Content="＋ إشعار مدين مشتريات"
                            Style="{StaticResource PrimaryButton}" Padding="18,9" Click="OnNew"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button DockPanel.Dock="Right" x:Name="PrintBtn" Content="طباعة PDF"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0" Click="OnPrintPdf"/>
                <Button DockPanel.Dock="Right" x:Name="CancelBtn" Content="إلغاء الإشعار"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnCancel"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="NoteSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم" Binding="{Binding NoteNumber}" Width="140"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding NoteDate}" Width="110"/>
                    <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="180"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
