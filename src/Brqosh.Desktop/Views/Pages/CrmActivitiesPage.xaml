<UserControl x:Class="Brqosh.Desktop.Views.Pages.CrmActivitiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <Button x:Name="AddBtn" DockPanel.Dock="Right" Content="＋ نشاط"
                        Style="{StaticResource PrimaryButton}" Padding="18,9" Click="OnAdd"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="أنشطة CRM" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="مكالمات · اجتماعات · ملاحظات"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,12,0,0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeLabel}" Width="90"/>
                    <DataGridTextColumn Header="الموضوع" Binding="{Binding Subject}" Width="*"/>
                    <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueAt}" Width="140"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
