<Window x:Class="Brqosh.Desktop.Views.Pages.GoodsReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إذن استلام بضاعة"
        Width="640" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="28,24">
        <TextBlock Text="استلام من أمر شراء معتمد" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
        <TextBlock Text="أمر الشراء *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="OrderBox" DisplayMemberPath="Display" SelectedValuePath="Id"
                  FontSize="14" Padding="10,8" SelectionChanged="OnOrderChanged" Margin="0,0,0,14"/>
        <TextBlock Text="المستودع *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="WarehouseBox" DisplayMemberPath="Display" SelectedValuePath="Id"
                  FontSize="14" Padding="10,8" Margin="0,0,0,14"/>
        <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DateBox" FontSize="14" Margin="0,0,0,14"/>
        <TextBlock x:Name="LinesPreview" Margin="0,0,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="ترحيل الاستلام" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
