<Window x:Class="Brqosh.Desktop.Views.Pages.GoodsReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إذن استلام بضاعة"
        Width="1000" Height="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="استلام من أمر شراء معتمد" Style="{StaticResource PageTitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="الكمية المستلمة تُعدَّل، والصنف المتتبَّع لا يدخل بلا رقم دفعة"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,14"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="أمر الشراء *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="OrderBox" DisplayMemberPath="Display" SelectedValuePath="Id"
                          FontSize="14" Padding="10,8" SelectionChanged="OnOrderChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="المستودع *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="WarehouseBox" DisplayMemberPath="Display" SelectedValuePath="Id"
                          FontSize="14" Padding="10,8"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DateBox" FontSize="14"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="14" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="المطلوب" Binding="{Binding OrderedQuantity, StringFormat=N2}" IsReadOnly="True" Width="100"/>
                    <!-- (CEEF-231 · ط1-٣ب) الكمية المستلمة تُعدَّل — والاستلامُ الجزئيّ
                         هو الحالةُ الغالبة، وقفلُها على المطلوب يُثبت رصيداً لم يصل. -->
                    <DataGridTextColumn Header="المستلم" Binding="{Binding ReceivedQuantity, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding UnitCost, StringFormat=N2}" IsReadOnly="True" Width="120"/>
                    <!-- (CEEF-231 · ط1-٣ب) رقمُ الدفعة والصلاحية — وبغيرهما يرفض المَخنَقُ
                         كلَّ صنفٍ متتبَّعٍ باسمه، فلا يُستلَم دواءٌ ولا طعامٌ من الشاشة أصلاً. -->
                    <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchNumber}" Width="140"/>
                    <DataGridTemplateColumn Header="تاريخ الصلاحية" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0" FontSize="13"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                       Visibility="Collapsed" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="ترحيل الاستلام" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
