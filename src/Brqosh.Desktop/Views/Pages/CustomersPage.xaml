<UserControl x:Class="Brqosh.Desktop.Views.Pages.CustomersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button Content="＋ عميل جديد" Style="{StaticResource PrimaryButton}" Padding="18,8"
                        DockPanel.Dock="Left" Click="OnAddCustomer"/>
                <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Width="320"
                         DockPanel.Dock="Right" HorizontalAlignment="Right"
                         TextChanged="OnSearchChanged" ToolTip="بحث بالاسم أو الرقم الضريبي"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="CustomersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FontSize="14" RowHeight="36" Background="Transparent" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم العميل" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="الرقم الضريبي" Binding="{Binding VatRegistrationNumber}" Width="160"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="140"/>
                    <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="220"/>
                    <DataGridTextColumn Header="نوع الفاتورة" Binding="{Binding InvoiceKind}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
