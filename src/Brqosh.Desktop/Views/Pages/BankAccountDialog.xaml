<Window x:Class="Brqosh.Desktop.Views.Pages.BankAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حساب بنكي جديد"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="حساب بنكي" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="الكود *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="اسم الحساب *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="اسم البنك *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="BankBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="رقم الحساب" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AccountNumberBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="الآيبان (IBAN)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="IbanBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

        <CheckBox x:Name="DefaultCheck" Content="الحساب البنكي الافتراضي" Margin="0,4,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="SemiBold"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
