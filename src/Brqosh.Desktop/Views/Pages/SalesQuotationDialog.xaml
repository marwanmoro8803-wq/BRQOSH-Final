<Window x:Class="Brqosh.Desktop.Views.Pages.SalesQuotationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Brqosh.Desktop.Ui"
        Title="عرض سعر جديد"
        Width="1040" Height="620"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="العميل *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CustomerCombo" DisplayMemberPath="NameAr" Style="{StaticResource AppComboBox}"/>
        </StackPanel>

        <!-- (جاهزيّةُ الإطلاق · ح-١١٥ · order-to-cash-procure-to-pay-inventory#8) شبكةُ سطورٍ كشبكة فاتورة المبيعات. -->
        <Border Grid.Row="1" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36" Background="Transparent"
                      CellEditEnding="OnCellEditEnding">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="ProductColumn" Header="الصنف" Width="220"
                                            SelectedValueBinding="{Binding ProductId}"
                                            DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    <DataGridTextColumn Header="الوصف / الصنف" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120"/>
                    <DataGridComboBoxColumn Header="الفئة الضريبية" Width="150"
                                            SelectedValueBinding="{Binding VatCategory}"
                                            SelectedValuePath="Value"
                                            DisplayMemberPath="Display"
                                            ItemsSource="{Binding Source={x:Static ui:VatCategoryOptions.All}}"/>
                    <DataGridComboBoxColumn Header="سبب الإعفاء" Width="220"
                                            SelectedValueBinding="{Binding TaxExemptionReasonCode}"
                                            SelectedValuePath="Code"
                                            DisplayMemberPath="Display"
                                            ItemsSource="{Binding Source={x:Static ui:VatExemptionReasonOptions.All}}"/>
                    <DataGridTextColumn Header="نصّ السبب (خارج النطاق)" Width="180"
                                        Binding="{Binding TaxExemptionReason}"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="110" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="قبل الضريبة" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SubtotalText" Text="0.00" Style="{StaticResource TabularText}" Margin="8,0,24,0"/>
            <TextBlock Text="الضريبة" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
            <TextBlock x:Name="VatText" Text="0.00" Style="{StaticResource TabularText}" Margin="8,0,24,0"/>
            <TextBlock Text="الإجمالي" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TotalText" Text="0.00" Style="{StaticResource TabularText}" Margin="8,0,0,0"
                       Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                <Button Content="إرسال العرض" Style="{StaticResource PrimaryButton}" Padding="20,9" Click="OnSave"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="20,9" Margin="12,0,0,0" Click="OnCancel"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
