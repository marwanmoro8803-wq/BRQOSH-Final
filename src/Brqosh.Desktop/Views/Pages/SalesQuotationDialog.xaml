<Window x:Class="Brqosh.Desktop.Views.Pages.SalesQuotationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عرض سعر جديد" Width="520" Height="480"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="28,24">
        <TextBlock Text="العميل *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CustomerCombo" DisplayMemberPath="NameAr" Style="{StaticResource AppComboBox}"/>
        <TextBlock Text="الوصف *" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
        <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBox}"/>
        <TextBlock Text="الكمية" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
        <TextBox x:Name="QuantityBox" Style="{StaticResource AppTextBox}" Text="1"/>
        <TextBlock Text="سعر الوحدة" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
        <TextBox x:Name="UnitPriceBox" Style="{StaticResource AppTextBox}" Text="0"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                   Visibility="Collapsed" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="إرسال العرض" Style="{StaticResource PrimaryButton}" Padding="20,9" Click="OnSave"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="20,9" Margin="12,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
