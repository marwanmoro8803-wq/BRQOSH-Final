<Window x:Class="Brqosh.Desktop.Views.Pages.InsurancePayerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شركة تأمين" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="شركة تأمين" Style="{StaticResource PageTitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="شركة التأمين عميل له ذمة — وتنشأ له بطاقة عميل تلقائياً"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="الرمز *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,10"/>

            <TextBlock Text="اسم شركة التأمين *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,10"/>

            <TextBlock Text="الرقم الضريبي" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="VatNumberBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,10"/>

            <TextBlock Text="مهلة السداد (يوم)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TermBox" Style="{StaticResource AppTextBox}" Text="60"/>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}"
                       FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9"
                        Click="OnSave" IsDefault="True"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
