<Window x:Class="Brqosh.Desktop.Views.Pages.BoqItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بند BOQ"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TitleText" Text="إضافة بند لجدول الكميات" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="رقم البند *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="الوصف *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DescBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="الوحدة" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="UnitBox" Style="{StaticResource AppTextBox}" Text="م²" Margin="0,0,0,14"/>

        <TextBlock Text="الكمية *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="QtyBox" Style="{StaticResource AppTextBox}" Text="1" Margin="0,0,0,14"/>

        <TextBlock Text="سعر الوحدة *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PriceBox" Style="{StaticResource AppTextBox}" Text="0" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="إضافة" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
