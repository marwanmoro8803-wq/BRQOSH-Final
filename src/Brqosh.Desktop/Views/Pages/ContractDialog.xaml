<Window x:Class="Brqosh.Desktop.Views.Pages.ContractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عقد مقاولات"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="عقد مقاولات جديد" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="المشروع *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ProjectBox" DisplayMemberPath="Name" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"/>

        <TextBlock Text="رقم العقد *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="تاريخ العقد" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DatePicker" FontSize="{DynamicResource FontSize.BodyLarge}" Margin="0,0,0,14"/>

        <TextBlock Text="قيمة العقد *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ValueBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="الوصف" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DescBox" Style="{StaticResource AppTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ وتفعيل" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
