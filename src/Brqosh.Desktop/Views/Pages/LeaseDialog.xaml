<Window x:Class="Brqosh.Desktop.Views.Pages.LeaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عقد إيجار" Width="620" Height="500"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="عقد إيجار جديد" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="رقم العقد *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="الوحدة *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="UnitBox" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="المستأجر *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TenantBox" FontSize="14"/>
            </StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="تاريخ البداية *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="StartBox" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="تاريخ النهاية *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="EndBox" FontSize="14"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="الإيجار لكل دورة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RentBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="الدورية *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="FrequencyBox" FontSize="14">
                        <ComboBoxItem Content="أسبوعية"/>
                        <ComboBoxItem Content="شهرية" IsSelected="True"/>
                        <ComboBoxItem Content="ربع سنوية"/>
                        <ComboBoxItem Content="نصف سنوية"/>
                        <ComboBoxItem Content="سنوية"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="التأمين المسترد" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DepositBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="التأمين أمانة تُرد عند الإخلاء — ويُقيَّد التزامًا لا إيرادًا"
                       Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Click="OnCancel"/>
            <Button DockPanel.Dock="Right" Content="حفظ" Style="{StaticResource PrimaryButton}"
                    Padding="26,9" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
