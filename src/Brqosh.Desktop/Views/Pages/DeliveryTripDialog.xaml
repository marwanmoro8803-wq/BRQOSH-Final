<Window x:Class="Brqosh.Desktop.Views.Pages.DeliveryTripDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="رحلة توصيل جديدة" Height="560" Width="860"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="رحلة توصيل جديدة" Style="{StaticResource PageTitleText}"
                   Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="اسم المسار هو ما تقاس به الربحية — ورحلة بلا مسار لا تقارن بشيء"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="رقم الرحلة *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="المسار *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RouteBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="لوحة المركبة *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PlateBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="تاريخ المغادرة" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DateBox" FontSize="14"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="4,4,4,6" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="الشحنات المحملة — والشحنة المسلمة لا تحمل"/>

        <Border Grid.Row="4" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="ShipmentGrid" AutoGenerateColumns="False" BorderThickness="0"
                      GridLinesVisibility="Horizontal" FontSize="14" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="تحميل" Binding="{Binding Selected}" Width="80"/>
                    <DataGridTextColumn Header="البوليصة" Binding="{Binding WaybillNumber}" Width="160"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="الوجهة" Binding="{Binding DestinationCity}" Width="*"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="الأجرة" Binding="{Binding FreightCharge, StringFormat=N2}"
                                        Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ الرحلة" Style="{StaticResource PrimaryButton}" Padding="20,9"
                    Click="OnSave"/>
            <Border Style="{StaticResource ToolbarSpacer}"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="18,9"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
