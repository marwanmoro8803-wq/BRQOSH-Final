<UserControl x:Class="Brqosh.Desktop.Views.Pages.FxRevaluationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="إعادة تقييم الحسابات بالعملات" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="رصيد بعملة أجنبية يبقى بسعر يوم إيداعه ما لم يُعَد تقييمه"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunBtn" Content="إعادة التقييم" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnRun"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <DatePicker x:Name="AsOfBox" DockPanel.Dock="Right" FontSize="{DynamicResource FontSize.BodyLarge}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="حتى تاريخ" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" BorderThickness="0"
                      GridLinesVisibility="Horizontal" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الحساب البنكي" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الرصيد بالعملة الأجنبية" Binding="{Binding ForeignBalance}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
