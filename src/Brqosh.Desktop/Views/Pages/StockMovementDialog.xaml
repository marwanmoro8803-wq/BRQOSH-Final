<Window x:Class="Brqosh.Desktop.Views.Pages.StockMovementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حركة مخزنية" Width="780" Height="560" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DateBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="نوع الحركة *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TypeCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" SelectionChanged="OnTypeChanged">
                    <ComboBoxItem Content="رصيد افتتاحي" Tag="Opening"/>
                    <ComboBoxItem Content="تسوية زيادة (جرد)" Tag="AdjustmentIn"/>
                    <ComboBoxItem Content="تسوية نقص (جرد)" Tag="AdjustmentOut"/>
                    <ComboBoxItem Content="تحويل بين مستودعين" Tag="Transfer"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="المستودع *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="WarehouseCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" DisplayMemberPath="NameAr" SelectedValuePath="Id"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" x:Name="ToWarehousePanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="مستودع الوجهة *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ToWarehouseCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" DisplayMemberPath="NameAr" SelectedValuePath="Id"/>
        </StackPanel>
        <!-- (UI-AUDIT) أُزيلت خانةُ «البيان» المخفيّة دائماً: كانت تشارك ToWarehousePanel الصفَّ نفسَه ولا تُقرأ —
             فبيانُ الحركة في الدفتر ثابتٌ بقصد حسب نوعها (StoredDescriptions في الكود الخلفيّ). -->
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="True" BorderThickness="0"
                      GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="ProductColumn" Header="الصنف" Width="*" SelectedValueBinding="{Binding ProductId}"
                                            DisplayMemberPath="NameAr" SelectedValuePath="Id"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding UnitCost, StringFormat=N4}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="ترحيل" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
