<UserControl x:Class="Brqosh.Desktop.Views.Pages.MaintenanceOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="أوامر الصيانة" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="التكلفة على وحدتها — وتحميل التلف على المستأجر هو سند مصادرة التأمين"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="AddBtn" Content="＋ أمر صيانة" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="PostBtn" DockPanel.Dock="Right" Content="ترحيل الأمر"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnPost"/>
                <ComboBox x:Name="SupplierInvoiceBox" DockPanel.Dock="Right" MinWidth="220" FontSize="14"
                          VerticalAlignment="Center" Margin="0,0,10,0" DisplayMemberPath="Label"
                          ToolTip="فاتورة المورّد (اختياري) — بها تُخصم ضريبة المدخلات بدل الدفع نقداً"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <DatePicker x:Name="ToBox" DockPanel.Dock="Right" FontSize="14"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="FromBox" DockPanel.Dock="Right" FontSize="14"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="UnitGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitLabel}" Width="*"/>
                    <DataGridTextColumn Header="أوامر" Binding="{Binding Orders}" Width="100"/>
                    <DataGridTextColumn Header="على المالك" Binding="{Binding OwnerCost, StringFormat=N2}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Margin="4,12,4,6" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Text="الأوامر"/>

        <Border Grid.Row="4" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNumber}" Width="130"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitLabel}" Width="120"/>
                    <DataGridTextColumn Header="السبب" Binding="{Binding KindText}" Width="130"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110"/>
                    <DataGridTextColumn Header="التكلفة" Binding="{Binding TotalCost, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="على المستأجر" Binding="{Binding TenantCharge, StringFormat=N2}" Width="140"/>
                    <DataGridTextColumn Header="على المالك" Binding="{Binding OwnerCost, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="القيد" Binding="{Binding PostedText}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
