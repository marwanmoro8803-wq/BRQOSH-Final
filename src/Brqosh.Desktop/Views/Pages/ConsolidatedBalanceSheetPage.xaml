<UserControl x:Class="Brqosh.Desktop.Views.Pages.ConsolidatedBalanceSheetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="الميزانية الموحّدة" FontSize="18"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="أصول · التزامات · حقوق ملكية · عملة تقرير"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="المجموعة" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="GroupCombo" Width="280" FontSize="14" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                <TextBlock Text="حتى تاريخ" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <DatePicker x:Name="AsOfDate" Width="160" FontSize="14"/>
                <Button Content="عرض" Style="{StaticResource PrimaryButton}" Padding="24,7" Margin="16,0,0,0" Click="OnRun"/>
                <Button Content="تصدير PDF" Style="{StaticResource SecondaryButton}" Padding="24,7" Margin="12,0,0,0" Click="OnExportPdf"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FontSize="14" RowHeight="34" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="القسم" Binding="{Binding Section}" Width="120"/>
                    <DataGridTextColumn Header="رقم الحساب" Binding="{Binding AccountCode}" Width="110"/>
                    <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountNameAr}" Width="*"/>
                    <DataGridTextColumn Header="شركات" Binding="{Binding CompanyCount}" Width="70"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SummaryCard}">
            <TextBlock x:Name="TotalsText" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
    </Grid>
</UserControl>
