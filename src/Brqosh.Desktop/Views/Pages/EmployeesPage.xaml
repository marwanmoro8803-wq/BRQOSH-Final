<UserControl x:Class="Brqosh.Desktop.Views.Pages.EmployeesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="سجل الموظفين" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="هوية · جنسية · أجر · آيبان — والجنسية تحكم اشتراك التأمينات"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddBtn" Content="＋ موظف جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="TerminateBtn" DockPanel.Dock="Right" Content="إنهاء خدمة"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnTerminate"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <CheckBox x:Name="ShowTerminatedBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                          Content="إظهار من انتهت خدمتهم" Margin="0,0,12,0" Click="OnFilterChanged"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      MouseDoubleClick="OnEdit">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="الهوية/الإقامة" Binding="{Binding NationalId}" Width="130"/>
                    <DataGridTextColumn Header="الجنسية" Binding="{Binding Nationality}" Width="90"/>
                    <DataGridTextColumn Header="المسمى الوظيفي" Binding="{Binding JobTitle}" Width="160"/>
                    <DataGridTextColumn Header="تاريخ التعيين" Binding="{Binding HireDate}" Width="110"/>
                    <DataGridTextColumn Header="الأساسي" Binding="{Binding BasicSalary, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="إجمالي الأجر" Binding="{Binding GrossPay, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الآيبان" Binding="{Binding Iban}" Width="200"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
