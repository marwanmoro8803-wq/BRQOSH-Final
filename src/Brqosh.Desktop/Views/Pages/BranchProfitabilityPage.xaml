<UserControl x:Class="Brqosh.Desktop.Views.Pages.BranchProfitabilityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="ربحية الفروع" FontSize="17"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="أي فرع يكسب — ومجموع الفروع يساوي صافي قائمة الدخل"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunBtn" Content="عرض" Style="{StaticResource PrimaryButton}"
                            Padding="24,9" Click="OnRun"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <DatePicker x:Name="ToBox" DockPanel.Dock="Right" FontSize="14"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="إلى" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="FromBox" DockPanel.Dock="Right" FontSize="14"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="من" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchNameAr}" Width="*"/>
                    <DataGridTextColumn Header="الإيرادات" Binding="{Binding Revenue, StringFormat=N2}" Width="160"/>
                    <DataGridTextColumn Header="المصروفات" Binding="{Binding Expenses, StringFormat=N2}" Width="160"/>
                    <DataGridTextColumn Header="صافي الدخل" Binding="{Binding NetIncome, StringFormat=N2}" Width="160"/>
                    <DataGridTextColumn Header="هامش الربح %" Binding="{Binding Margin, StringFormat=N2}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
