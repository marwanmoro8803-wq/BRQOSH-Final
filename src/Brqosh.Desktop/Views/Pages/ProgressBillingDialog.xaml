<Window x:Class="Brqosh.Desktop.Views.Pages.ProgressBillingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مستخلص أعمال"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="مستخلص أعمال جديد" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="المشروع *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ProjectBox" DisplayMemberPath="Name" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" SelectionChanged="OnProjectChanged" Margin="0,0,0,14"/>

        <TextBlock Text="العميل *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CustomerBox" DisplayMemberPath="Name" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"/>

        <TextBlock Text="وصف الفترة *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PeriodBox" Style="{StaticResource AppTextBox}" Text="مستخلص رقم 1" Margin="0,0,0,14"/>

        <TextBlock Text="تاريخ المستخلص" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DatePicker" FontSize="{DynamicResource FontSize.BodyLarge}" Margin="0,0,0,14"/>

        <TextBlock Text="قيمة الأعمال الحالية *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AmountBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="نسبة المحتجز %" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="RetentionBox" Style="{StaticResource AppTextBox}" Text="10" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ وترحيل" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
