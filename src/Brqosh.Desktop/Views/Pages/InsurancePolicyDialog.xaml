<Window x:Class="Brqosh.Desktop.Views.Pages.InsurancePolicyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="وثيقة تأمين" Width="600" Height="470"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="وثيقة تأمين جديدة" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="شركة التأمين *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="PayerBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="رقم الوثيقة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PolicyNumberBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="رقم العضوية" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MemberNumberBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="نسبة التغطية ٪ *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CoverageBox" Style="{StaticResource AppTextBox}" Text="80"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="التحمل الثابت" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CopayBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="سقف سنة الوثيقة" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LimitBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="بداية السريان *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="StartBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="نهاية السريان *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="EndBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="التحمل يُخصم أولًا ثم تُطبَّق النسبة على الباقي — والسقف سقف سنة وثيقة لا سنة ميلادية"
                       Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Click="OnCancel"/>
            <Button DockPanel.Dock="Right" Content="حفظ" Style="{StaticResource PrimaryButton}"
                    Padding="26,9" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
