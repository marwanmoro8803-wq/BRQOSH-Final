<UserControl x:Class="Brqosh.Desktop.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RootPanel" Margin="0,0,0,24">

            <!-- Hero -->
            <Border x:Name="HeaderCard" Style="{StaticResource GlassPanel}"
                    Padding="24,20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="HeroTitleText"
                               FontSize="26" FontWeight="Black"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="HeroSubtitleText"
                               Style="{StaticResource PageSubtitleText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Smart alert -->
            <ContentControl x:Name="AlertHost" Margin="0,0,0,16"/>

            <!-- KPI Bento — 5 columns -->
            <Border Style="{StaticResource ContentCard}" Padding="12" Margin="0,0,0,16">
                <UniformGrid x:Name="KpiGrid"
                             AutomationProperties.AutomationId="BrqoshKpiGrid"
                             Columns="5"
                             Rows="2"/>
            </Border>

            <!-- Charts + Intelligence -->
            <Grid x:Name="BodyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="ChartsColumn" Grid.Column="0" Margin="0,0,14,0"/>
                <StackPanel x:Name="IntelColumn" Grid.Column="1"/>
            </Grid>

            <!-- Loading / error overlay host -->
            <Border x:Name="LoadingOverlay" Visibility="Collapsed"
                    Style="{StaticResource LoadingStatePanel}">
                <TextBlock x:Name="LoadingText"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
