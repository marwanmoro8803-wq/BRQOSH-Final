<Window x:Class="Brqosh.Desktop.Views.Pages.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مستخدم" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="بيانات المستخدم" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
        <TextBlock Text="اسم الدخول" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="UsernameBox" Style="{StaticResource AppTextBox}" IsEnabled="False" Margin="0,0,0,14"/>
        <TextBlock Text="الاسم المعروض" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DisplayBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>
        <TextBlock Text="رقم الجوال (للاسترجاع)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="MobileBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>
        <TextBlock Text="الدور" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="RoleCombo" Padding="10,8" FontSize="14" Margin="0,0,0,14">
            <ComboBoxItem Content="مدير النظام"/>
            <ComboBoxItem Content="محاسب"/>
            <ComboBoxItem Content="كاشير"/>
            <ComboBoxItem Content="عرض فقط"/>
        </ComboBox>
        <CheckBox x:Name="ActiveBox" Content="نشط" Margin="0,0,0,14" IsChecked="True"/>
        <TextBlock Text="كلمة مرور جديدة (اتركها فارغة للإبقاء)" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource AppPasswordBox}" Margin="0,0,0,4"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,8" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="24,8" Margin="12,0,0,0" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
