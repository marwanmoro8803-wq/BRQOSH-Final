<UserControl x:Class="Brqosh.Desktop.Views.Pages.WorkOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="أوامر الإنتاج" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="إصدار · إكمال · قيد مخزون · BOM"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="NewBtn" Content="＋ أمر إنتاج جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnNew"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ReleaseBtn" Content="إصدار المحدد" Padding="16,9" Margin="0,0,8,0" Click="OnRelease"/>
                    <!-- (جاهزيّةُ الإطلاق · ح-١٤٧) صرفُ موادّ فعليٌّ للأمر الصادر — ونصُّه من الشيفرة الخلفيّة. -->
                    <Button x:Name="IssueBtn" Padding="16,9" Margin="0,0,8,0" Click="OnIssue"/>
                    <Button x:Name="CompleteBtn" Content="إكمال المحدد" Padding="16,9" Margin="0,0,8,0" Click="OnComplete"/>
                    <Button Content="عرض قيد الإكمال" Padding="16,9" Click="OnViewJournal"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="إلغاء المحدد"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnCancel"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="WorkOrderSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNumber}" Width="130"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding OrderDate}" Width="100"/>
                    <DataGridTextColumn Header="قائمة المواد" Binding="{Binding BomName}" Width="*"/>
                    <DataGridTextColumn Header="الكمية المخططة" Binding="{Binding PlannedQuantity, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الكمية المنتجة" Binding="{Binding ProducedQuantity, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
