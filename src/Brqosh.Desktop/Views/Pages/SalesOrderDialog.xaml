<Window x:Class="Brqosh.Desktop.Views.Pages.SalesOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="أمر بيع جديد"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="28,24">
        <TextBlock Text="أمر بيع" Style="{StaticResource PageTitleText}" Margin="0,0,0,16"/>
        <TextBlock Text="العميل *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CustomerCombo" Style="{StaticResource AppComboBox}" DisplayMemberPath="NameAr" Margin="0,0,0,12"/>
        <TextBlock Text="الوصف *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="الكمية *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="QuantityBox" Style="{StaticResource AppTextBox}" Text="1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="سعر الوحدة *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UnitPriceBox" Style="{StaticResource AppTextBox}" Text="0"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button Content="تأكيد الأمر" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="24,9" Margin="12,0,0,0" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
