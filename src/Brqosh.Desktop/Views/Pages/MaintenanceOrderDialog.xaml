<Window x:Class="Brqosh.Desktop.Views.Pages.MaintenanceOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="أمر صيانة جديد" Height="560" Width="880"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="أمر صيانة جديد" Style="{StaticResource PageTitleText}"
                   Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="الدورية والإصلاحية على المالك — والاستهلاك العادي ثمن التأجير لا ذنب الساكن"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="رقم الأمر *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="وصف العمل *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="السبب" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="KindBox" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem Content="دورية"/>
                    <ComboBoxItem Content="إصلاحية"/>
                    <ComboBoxItem Content="تلف مستأجر"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="تاريخ الطلب" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DateBox" FontSize="14"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="الوحدة (اتركها فارغة للمرافق المشتركة)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="UnitBox" FontSize="14" DisplayMemberPath="Label"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="المورد" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="VendorBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="على المستأجر" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TenantChargeBox" Style="{StaticResource AppTextBox}" Text="0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="CostGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="14" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="بند التكلفة" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource AlertStrip}" Margin="0,12,0,0" Padding="16,10">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                       Text="التكلفة سطور لا رقم واحد — وبها يصير الأمر سندا يراجع ويطعن فيه"/>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ وإنهاء" Style="{StaticResource PrimaryButton}" Padding="20,9"
                    Click="OnSave"/>
            <Border Style="{StaticResource ToolbarSpacer}"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="18,9"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
