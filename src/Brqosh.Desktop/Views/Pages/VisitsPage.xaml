<UserControl x:Class="Brqosh.Desktop.Views.Pages.VisitsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الزيارات والفوترة" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="زيارة واحدة تنتج ذمتين — على المريض وعلى شركة التأمين"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddBtn" Content="＋ زيارة" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="BillBtn" DockPanel.Dock="Right" Content="فوترة الزيارة"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnBill"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الزيارة" Binding="{Binding VisitNumber}" Width="130"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding VisitDate}" Width="110"/>
                    <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="*"/>
                    <DataGridTextColumn Header="الطبيب" Binding="{Binding DoctorName}" Width="160"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="التأمين" Binding="{Binding Covered}" Width="110"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
