<UserControl x:Class="Brqosh.Desktop.Views.Pages.PricingPlansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="الباقات والتسعير" FontSize="18"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="خطط الاشتراك · حدود الشركات"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,0,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="PlansGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      FontSize="14" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding NameAr}" Width="*"/>
                    <DataGridTextColumn Header="أقصى شركات" Binding="{Binding MaxCompanies}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
