<Window x:Class="Brqosh.Desktop.Views.Pages.ChequeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شيك جديد"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="رقم الشيك *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="تاريخ الشيك *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DateBox" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="تاريخ الاستحقاق" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DueBox" FontSize="14"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="PartyLabel" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="PartyCombo" FontSize="14" Padding="10,8" Margin="0,0,0,14"
                  DisplayMemberPath="Display" SelectedValuePath="Id"/>

        <TextBlock Text="الحساب البنكي *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="BankCombo" FontSize="14" Padding="10,8" Margin="0,0,0,14"
                  DisplayMemberPath="Display" SelectedValuePath="Id"/>

        <TextBlock Text="المبلغ *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AmountBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="البيان *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="SemiBold"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="تسجيل وترحيل" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
