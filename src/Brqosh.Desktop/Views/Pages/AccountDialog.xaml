<Window x:Class="Brqosh.Desktop.Views.Pages.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حساب جديد"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="إضافة حساب إلى الدليل" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="الحساب الأب" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ParentCombo" FontSize="14" Padding="10,8" Margin="0,0,0,14"/>

        <TextBlock Text="رقم الحساب *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="اسم الحساب (عربي) *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameArBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="اسم الحساب (إنجليزي)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameEnBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <CheckBox x:Name="IsGroupCheck" Content="حساب تجميعي (لا يقبل قيوداً مباشرة)" FontSize="13" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="SemiBold"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
