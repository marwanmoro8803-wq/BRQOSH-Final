<Window x:Class="Brqosh.Desktop.Views.Pages.DebitNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إشعار مدين مشتريات"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
 FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="28,24">
        <TextBlock Text="إشعار مدين على فاتورة مشتريات" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
        <TextBlock Text="فاتورة المشتريات المرحّلة *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="InvoiceBox" DisplayMemberPath="Display" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"/>
        <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DateBox" FontSize="{DynamicResource FontSize.BodyLarge}" Margin="0,0,0,14"/>
        <TextBlock Text="السبب *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ReasonBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>
        <!-- (جاهزيّةُ الإطلاق · ح-٣٧) سطرٌ من الفاتورة يُختار بعينه —
             وكان وصفاً حرّاً يُنسب إلى أوّل سطرٍ مهما كُتِب فيه. -->
        <TextBlock Text="السطر المُرجَع *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="LineBox" DisplayMemberPath="Display" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="الكمية *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="QtyBox" Style="{StaticResource AppTextBox}" Text="1"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="السعر *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PriceBox" Style="{StaticResource AppTextBox}" Text="0"/>
            </StackPanel>
        </Grid>
        <!-- (جاهزيّةُ الإطلاق · ح-١٠٥) الدفعةُ المُرجَعة للصنف المتتبَّع — سطرُ فاتورة الشراء لا يحملها،
             فتُسمّى هنا؛ وتُترك فارغةً حين لا يبقى إلا دفعةٌ واحدة. -->
        <TextBlock Text="الدفعة (للصنف المتتبَّع)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
        <TextBox x:Name="BatchBox" Style="{StaticResource AppTextBox}"/>
        <!-- (جاهزيّةُ الإطلاق · ح-١٠٧) ما دون التكلفة لا يُرحَّل إلا بتأكيدٍ صريح — والرفضُ يُسمّي الفرق. -->
        <CheckBox x:Name="AcceptBelowCostBox" Content="أقبل مرتجعاً دون التكلفة (الفرقُ خسارة)" Margin="0,10,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="ترحيل" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
