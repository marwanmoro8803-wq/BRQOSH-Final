<Window x:Class="Brqosh.Desktop.Views.Pages.DeliveryNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إذن تسليم" Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}" ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="إذن تسليم من أمر البيع" Style="{StaticResource PageTitleText}" Margin="0,0,0,8"/>
        <TextBlock Text="عدّل الكمية المسلّمة، وأدخل رقم الدفعة للأصناف المتتبعة." Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
        <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Height="280" BorderThickness="0" AutomationProperties.Name="سطور التسليم">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الصنف" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="المطلوب" Binding="{Binding Ordered}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="الكمية المسلّمة" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="متتبَّع" Binding="{Binding TrackedLabel}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding Batch, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="تسليم" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>