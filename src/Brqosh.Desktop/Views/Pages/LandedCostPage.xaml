<UserControl x:Class="Brqosh.Desktop.Views.Pages.LandedCostPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="التكلفة الإضافية Landed Cost" FontSize="18"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="شحن · جمارك · توزيع على أرصدة مخزنية · WAC"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="التاريخ *" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DateBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="إجمالي التكلفة الإضافية *" Margin="0,0,0,4"/>
                        <TextBox x:Name="AmountBox" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="البيان *" Margin="0,0,0,4"/>
                        <TextBox x:Name="DescBox" Padding="10,8"/>
                    </StackPanel>
                </Grid>
                <DockPanel LastChildFill="False" Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Style="{StaticResource ToolbarPrimaryGroup}">
                        <Button x:Name="AllocateBtn" Content="توزيع وترحيل"
                                Style="{StaticResource PrimaryButton}" Padding="20,9" Click="OnAllocate"/>
                    </StackPanel>
                    <CheckBox x:Name="CreditPayableBox" Content="دائن الموردين (بدلاً من الصندوق)"
                              DockPanel.Dock="Left" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="LandedCostSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="الأصناف ذات الرصيد — حدّد حصة التوزيع (كمية أو وزن)"
                           Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                          BorderThickness="0" FontSize="14" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding NameAr}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding OnHand, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="متوسط التكلفة" Binding="{Binding Wac, StringFormat=N4}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="حصة التوزيع" Binding="{Binding Share, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
