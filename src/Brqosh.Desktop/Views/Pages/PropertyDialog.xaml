<Window x:Class="Brqosh.Desktop.Views.Pages.PropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عقار" Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="عقار جديد" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="الكود *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="اسم العقار *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="نوع العقار *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="KindBox" FontSize="{DynamicResource FontSize.BodyLarge}">
                        <ComboBoxItem Content="مبنى" IsSelected="True"/>
                        <ComboBoxItem Content="مجمع سكني"/>
                        <ComboBoxItem Content="فيلا"/>
                        <ComboBoxItem Content="أرض"/>
                        <ComboBoxItem Content="عقار تجاري"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="المدينة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CityBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="العنوان" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AddressBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="رقم الصك" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DeedBox" Style="{StaticResource AppTextBox}"/>
            </StackPanel>
        </StackPanel>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Click="OnCancel"/>
            <Button DockPanel.Dock="Right" Content="حفظ" Style="{StaticResource PrimaryButton}"
                    Padding="26,9" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
