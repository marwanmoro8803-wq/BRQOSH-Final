<UserControl x:Class="Brqosh.Desktop.Views.Pages.PostingAccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="حسابات الترحيل" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="الحساب الذي يُرحَّل إليه كل دور في القيود الآلية"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="AccountBox" Width="260" Style="{StaticResource AppComboBox}" DisplayMemberPath="Label" SelectedValuePath="Code"
                              Margin="0,0,8,0" AutomationProperties.Name="الحساب"/>
                    <Button x:Name="AssignBtn" Content="تعيين الحساب" Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="0,0,8,0" Click="OnAssign"/>
                    <Button x:Name="ResetBtn" Content="الافتراضي" Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnReset"/>
                </WrapPanel>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock Text="التغيير يسري على القيود الجديدة فقط، ولا يعدّل القيود المرحّلة." FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      SelectionChanged="OnSelectionChanged" AutomationProperties.Name="أدوار الترحيل">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الدور" Binding="{Binding Label}" Width="*"/>
                    <DataGridTextColumn Header="الافتراضي" Binding="{Binding DefaultCode}" Width="100"/>
                    <DataGridTextColumn Header="الحساب الحالي" Binding="{Binding Account}" Width="260"/>
                    <DataGridTextColumn Header="مخصّص" Binding="{Binding CustomLabel}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>