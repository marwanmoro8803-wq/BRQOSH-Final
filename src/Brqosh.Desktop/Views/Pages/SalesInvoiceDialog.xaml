<Window x:Class="Brqosh.Desktop.Views.Pages.SalesInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Brqosh.Desktop.Ui"
        Title="فاتورة مبيعات جديدة"
        Width="1040" Height="640"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="فاتورة مبيعات" Style="{StaticResource PageTitleText}"/>
                <TextBlock x:Name="HeroSubtitleText" Style="{StaticResource PageSubtitleText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DatePickerBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="العميل *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CustomerCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="العملة" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CurrencyBox" Style="{StaticResource AppTextBox}" Text="SAR"
                         MaxLength="3" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="سعر الصرف" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RateBox" Style="{StaticResource AppTextBox}" Text="1"/>
            </StackPanel>
            <!-- (جاهزيّةُ الإطلاق · ح-١١٠) مستودعُ الصرف — والأوّلُ «الافتراضيّ» فلا يتغيّر شيءٌ لمن لا يختار. -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0">
                <TextBlock Text="المستودع" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="WarehouseCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,12,0">
                <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36" Background="Transparent"
                          CellEditEnding="OnCellEditEnding">
                    <DataGrid.Columns>
                        <!-- (CEEF-229 · م2-٢٠) عمود اختيار الصنف — كان غائباً تماماً.
                             LineRow.ProductId يُقرأ في ثلاثة مواضع ولا يُكتب في موضعٍ واحد،
                             فتُرحَّل كل فاتورةٍ بـ ProductId = null: لا حركة مخزون ولا تكلفة
                             بضاعة مباعة. -->
                        <DataGridComboBoxColumn x:Name="ProductColumn" Header="الصنف" Width="220"
                                                SelectedValueBinding="{Binding ProductId}"
                                                DisplayMemberPath="Display" SelectedValuePath="Id"/>
                        <DataGridTextColumn Header="الوصف / الصنف" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="130"/>
                        <!-- (CEEF-231 · ط1-٢ب) نسبةُ خصم السطر — والمحرّكُ مبنيٌّ منذ ط1-٢
                             ولا حقلَ في أيّ شاشةٍ يصل إليه، فيُدخل البائعُ السعرَ مخصوماً
                             بيده وتضيع النسبةُ من المستند الإلكترونيّ ومن كلّ تقرير. -->
                        <DataGridTextColumn Header="خصم %" Binding="{Binding DiscountPercent, StringFormat=N2}" Width="90"/>
                        <DataGridComboBoxColumn Header="الفئة الضريبية" Width="150"
                                                SelectedValueBinding="{Binding VatCategory}"
                                                SelectedValuePath="Value"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding Source={x:Static ui:VatCategoryOptions.All}}"/>
                        <!-- (CEEF-229 · م1-١ب/الشقّ الثاني) سببُ الإعفاء — BR-KSA-CL-06.
                             وبلا هذين العمودين يصير الحارسُ في النطاق بابَاً مغلقاً بلا مفتاح:
                             يمنع البيعَ الصفريَّ والمعفى ولا يهدي المستخدمَ إلى حلّ. -->
                        <DataGridComboBoxColumn Header="سبب الإعفاء" Width="240"
                                                SelectedValueBinding="{Binding TaxExemptionReasonCode}"
                                                SelectedValuePath="Code"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding Source={x:Static ui:VatExemptionReasonOptions.All}}"/>
                        <DataGridTextColumn Header="نصّ السبب (خارج النطاق)" Width="200"
                                            Binding="{Binding TaxExemptionReason}"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="130" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource ContentCard}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ملخص مالي" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="خصم على المستند" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DocumentDiscountBox" Style="{StaticResource AppTextBox}" Text="0.00"
                                 Margin="0,0,0,8" TextChanged="OnDocumentDiscountChanged"/>
                        <TextBlock Text="قبل الضريبة" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="SubtotalText" Text="0.00" Style="{StaticResource TabularText}" FontSize="{DynamicResource FontSize.TitleLarge}" Margin="0,0,0,8"/>
                        <TextBlock Text="الضريبة 15%" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="VatText" Text="0.00" Style="{StaticResource TabularText}" Margin="0,0,0,8"/>
                        <TextBlock Text="الإجمالي" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="TotalText" Text="0.00" Style="{StaticResource TabularText}"
                                   Foreground="{StaticResource PrimaryBrush}" FontSize="{DynamicResource FontSize.Heading}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassPanel}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ZATCA e-Invoice" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ZatcaStatusText" TextWrapping="Wrap" Style="{StaticResource PageSubtitleText}"/>
                        <TextBlock x:Name="ZatcaHintText" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource PageSubtitleText}" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                <Button Content="ترحيل الفاتورة" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
