<Window x:Class="Brqosh.Desktop.Views.Pages.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مشروع جديد"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="إضافة مشروع مقاولات" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="كود المشروع *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="اسم المشروع *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="العميل" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CustomerBox" DisplayMemberPath="Name" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,14"/>

        <TextBlock Text="قيمة العقد" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ValueBox" Style="{StaticResource AppTextBox}" Text="0" Margin="0,0,0,14"/>

        <TextBlock Text="التكلفة المقدّرة الإجمالية (IFRS 15)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="EstimatedCostBox" Style="{StaticResource AppTextBox}" Text="0" Margin="0,0,0,14"/>

        <TextBlock Text="نسبة المحتجز %" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="RetentionBox" Style="{StaticResource AppTextBox}" Text="10" Margin="0,0,0,14"/>

        <TextBlock Text="الموقع" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="LocationBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="تاريخ البدء" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="StartDateBox" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="8,6" Margin="0,0,0,14"/>

        <TextBlock Text="تاريخ الانتهاء المتوقع" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="EndDateBox" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="8,6" Margin="0,0,0,14"/>

        <TextBlock Text="حالة المشروع" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="StatusBox" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
