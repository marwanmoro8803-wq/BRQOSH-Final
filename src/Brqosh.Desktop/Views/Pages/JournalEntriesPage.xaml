<UserControl x:Class="Brqosh.Desktop.Views.Pages.JournalEntriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="قيود اليومية" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="GL · ترحيل · عكس · تدقيق"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewEntryBtn" Content="＋ قيد جديد"
                            Style="{StaticResource PrimaryButton}" Padding="18,9"
                            Click="OnNewEntry"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض" Padding="16,9" Margin="0,0,8,0" Click="OnView"/>
                    <Button x:Name="PrevBtn" Content="→" Padding="12,9" Margin="0,0,6,0"
                            ToolTip="الصفحة السابقة" Click="OnPrev"
                            AutomationProperties.Name="الصفحة السابقة"/>
                    <Button x:Name="NextBtn" Content="←" Padding="12,9"
                            ToolTip="الصفحة التالية" Click="OnNext"
                            AutomationProperties.Name="الصفحة التالية"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button DockPanel.Dock="Right" x:Name="ReverseBtn" Content="↩ عكس القيد"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9"
                        Click="OnReverse"/>
                <Border DockPanel.Dock="Left" Background="{DynamicResource PrimarySoftBrush}"
                        CornerRadius="3" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryDarkBrush}"/>
                </Border>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="EntrySummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" Background="Transparent"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم القيد" Binding="{Binding EntryNumber}" Width="150"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDate}" Width="110"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding TotalDebit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding TotalCredit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
