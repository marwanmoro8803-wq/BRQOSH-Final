<UserControl x:Class="Brqosh.Desktop.Views.Pages.JournalEntriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button Content="＋ قيد جديد" Style="{StaticResource PrimaryButton}" Padding="18,8"
                        DockPanel.Dock="Left" Click="OnNewEntry"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="EntriesGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" FontSize="14"
                      RowHeight="38" Background="Transparent"
                      SelectionMode="Single"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم القيد" Binding="{Binding EntryNumber}" Width="150"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDate}" Width="110"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding TotalDebit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding TotalCredit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
