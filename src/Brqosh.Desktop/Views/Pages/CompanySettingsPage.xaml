<UserControl x:Class="Brqosh.Desktop.Views.Pages.CompanySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="إعدادات المنشأة" FontSize="{DynamicResource FontSize.Title}"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="هوية المنشأة · الشعار والطباعة · ضريبة · عملة · ترخيص — مدير النظام فقط"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource ContentCard}" Padding="32" MaxWidth="{StaticResource SettingsColumnWidth}" HorizontalAlignment="Center" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="الهوية والطباعة" Style="{StaticResource FieldLabel}" FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="شعار الشركة" Style="{StaticResource FieldLabel}"/>
                    <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="12" Margin="0,0,0,8" HorizontalAlignment="Left">
                        <Grid Width="180" Height="100">
                            <TextBlock x:Name="LogoPreviewPlaceholder" Text="لا يوجد شعار"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <Image x:Name="LogoPreviewImage" Stretch="Uniform" MaxHeight="96" MaxWidth="168"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="UploadLogoBtn" Content="رفع شعار" Style="{StaticResource SecondaryButton}"
                                Padding="16,8" Click="OnUploadLogo"/>
                        <Button x:Name="RemoveLogoBtn" Content="إزالة الشعار" Style="{StaticResource SecondaryButton}"
                                Padding="16,8" Margin="12,0,0,0" Click="OnRemoveLogo"/>
                        <CheckBox x:Name="TransparentLogoBox" Content="تفريغ خلفية الشعار (شفافة)"
                                  IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
                                  ToolTip="يزيل لون الخلفية المتّصل بحواف الصورة ويُبقي البياض داخل الشعار."/>
                    </StackPanel>

                    <TextBlock Text="اسم المنشأة (عربي) *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="اسم المنشأة (إنجليزي)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameEnBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="عنوان المنشأة" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AddressBox" Style="{StaticResource AppTextBox}" TextWrapping="Wrap"
                             AcceptsReturn="True" MinHeight="56" Margin="0,0,0,16"/>

                    <TextBlock x:Name="AddressEnLabel" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AddressEnBox" Style="{StaticResource AppTextBox}" TextWrapping="Wrap" MaxLength="512"
                             AcceptsReturn="True" MinHeight="44" Margin="0,0,0,16" FlowDirection="LeftToRight"
                             AutomationProperties.AutomationId="CompanySettingsAddressEn"/>

                    <TextBlock x:Name="AuditorLabel" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AuditorBox" Style="{StaticResource AppTextBox}" MaxLength="120" Margin="0,0,0,4"
                             AutomationProperties.AutomationId="CompanySettingsAuditor"/>
                    <TextBlock x:Name="AuditorHint" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- (CEEF-229 · Z-10) بيانات البائع النظامية للفوترة الإلكترونية.
                         العنوان أعلاه نصّ حرّ للترويسة؛ والفاتورة الإلكترونية تلزم حقولاً مفكَّكة. -->
                    <TextBlock Text="بيانات الفاتورة الإلكترونية" Style="{StaticResource FieldLabel}"
                               FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock x:Name="EInvoiceReadinessText" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="الاسم المسجَّل في السجل التجاري" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RegistrationNameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="رقم السجل التجاري" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CrnBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="العنوان الوطني" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="رقم المبنى (4 خانات)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BuildingNumberBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="الرقم الإضافي (اختياري)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AdditionalNumberBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="اسم الشارع" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="StreetNameBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="الحي" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DistrictNameBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="المدينة" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CityNameBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="الرمز البريدي (5 خانات)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PostalZoneBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="المنطقة" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CountrySubentityBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="رمز الدولة" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CountryCodeBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="خط الطباعة العربي" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PrintFontBox" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,24"/>

                    <TextBlock Text="الضريبة والعملة" Style="{StaticResource FieldLabel}" FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="الرقم الضريبي (15 خانة)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="VatBox" Style="{StaticResource AppTextBox}" MaxLength="15" Margin="0,0,0,16"/>

                    <TextBlock Text="نظام العمل" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="ProfileText" FontSize="{DynamicResource FontSize.BodyLarge}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ProfileBox" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,4"/>
                    <TextBlock Text="يغيّره المدير وحده، ولا يُقبل نظامٌ يُخفي وحدةً فيها بيانات. يُطبَّق على القوائم عند إعادة التشغيل."
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ActiveModulesText" FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="قالب الدولة" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="CountryTemplateText" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CountryComplianceText" FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="قالب القطاع" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="IndustryTemplateText" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="IndustryModulesText" FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="طريقة تكلفة المخزون *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CostingMethodBox" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,16"/>

                    <TextBlock Text="حد اعتماد القيد اليدوي (ريال)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ManualJournalThresholdBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,4"/>
                    <TextBlock Text="القيد اليدوي فوق هذا المبلغ لا يُرحَّل إلا بعد موافقة مستخدم آخر. يغيّره المدير وحده."
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="عملة العرض (ISO) *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="BaseCurrencyBox" ItemTemplate="{StaticResource CurrencyFlagItem}" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,16"/>

                    <TextBlock Text="عملة القياس المحاسبي (ISO) *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="FunctionalCurrencyBox" ItemTemplate="{StaticResource CurrencyFlagItem}" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CurrencyHintText"
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="مجموعة التقارير الموحّدة" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="GroupCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,16"/>

                    <TextBlock Text="معرّف الجهاز (للترخيص)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MachineIdBox" Style="{StaticResource AppTextBox}" IsReadOnly="True" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LicenseStatusText"
                               FontSize="{DynamicResource FontSize.Small}" TextWrapping="Wrap" Margin="0,4,0,16"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14" Effect="{StaticResource CardShadow}">
            <Grid>
                <!-- (UI-AUDIT) عمودان: رسالةُ خطأٍ طويلةٌ تلتفّ في عمودها ولا تمرّ تحت زرّ الحفظ. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" Margin="0,0,16,0" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Visibility="Collapsed" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="SaveBtn" Content="حفظ" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.AutomationId="CompanySettingsSave"
                            Padding="24,9" Click="OnSave"/>
                    <Button x:Name="ProvisionOrgBtn" Content="إنشاء منشأة جديدة" Style="{StaticResource SecondaryButton}"
                            Padding="24,9" Margin="12,0,0,0" Click="OnProvisionOrganization"/>
                    <Button x:Name="LicenseBtn" Content="تفعيل الترخيص" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.AutomationId="CompanySettingsLicense"
                            Padding="24,9" Margin="12,0,0,0" Click="OnLicense"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
