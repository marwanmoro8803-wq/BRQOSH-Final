<UserControl x:Class="Brqosh.Desktop.Views.Pages.DeliveryTripsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="240"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="رحلات التوصيل وربحية المسار" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="عهدة السائق أصل لا مصروف — والمسار الخاسر يظهر أولاً"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddBtn" Content="＋ رحلة" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="SettleBtn" DockPanel.Dock="Right" Content="تسوية العهدة"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnSettle"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="FloatBtn" DockPanel.Dock="Right" Content="تسليم العهدة"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnAdvance"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <TextBox x:Name="AmountBox" DockPanel.Dock="Right" Width="110" Text="0"
                         Style="{StaticResource AppTextBox}" VerticalAlignment="Center"
                         Margin="0,0,10,0"/>
                <TextBlock DockPanel.Dock="Right" Text="المبلغ" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <DatePicker x:Name="ToBox" DockPanel.Dock="Right" FontSize="{DynamicResource FontSize.BodyLarge}"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="FromBox" DockPanel.Dock="Right" FontSize="{DynamicResource FontSize.BodyLarge}"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المسار" Binding="{Binding RouteName}" Width="*"/>
                    <DataGridTextColumn Header="رحلات" Binding="{Binding Trips}" Width="90"/>
                    <DataGridTextColumn Header="شحنات" Binding="{Binding Shipments}" Width="90"/>
                    <DataGridTextColumn Header="الأجور" Binding="{Binding FreightRevenue, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="المصاريف" Binding="{Binding TripCost, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="الهامش" Binding="{Binding Margin, StringFormat=N2}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Margin="4,12,4,6" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Text="الرحلات"/>

        <Border Grid.Row="4" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الرحلة" Binding="{Binding TripNumber}" Width="130"/>
                    <DataGridTextColumn Header="المسار" Binding="{Binding RouteName}" Width="*"/>
                    <DataGridTextColumn Header="المركبة" Binding="{Binding VehiclePlate}" Width="120"/>
                    <DataGridTextColumn Header="المغادرة" Binding="{Binding DepartureDate}" Width="110"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110"/>
                    <DataGridTextColumn Header="شحنات" Binding="{Binding Shipments}" Width="90"/>
                    <DataGridTextColumn Header="العهدة" Binding="{Binding DriverFloat, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="المصاريف" Binding="{Binding Expenses, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="فرق العهدة" Binding="{Binding Variance, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
