<UserControl x:Class="Brqosh.Desktop.Views.Pages.StockCountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="جرد المخزون" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="عد فعلي · فروقات · ترحيل تسوية"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="PostCountBtn" Content="ترحيل فروقات الجرد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnPostCount"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="تحديث" Padding="16,9" Click="OnRefresh"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="المستودع" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="WarehouseCombo" Width="220" Padding="10,8"
                              DisplayMemberPath="NameAr" SelectedValuePath="Id" SelectionChanged="OnFilter"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="CountSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" BorderThickness="0"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="كود الصنف" Binding="{Binding ProductCode}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="المستودع" Binding="{Binding WarehouseName}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="70" IsReadOnly="True"/>
                    <!-- (CEEF-229 · م2-١٧ب) الموقوفُ يظهر ببضاعته ويُوسَم — لا يختفي ولا يُظنّ متاحاً. -->
                    <DataGridTemplateColumn Header="الحالة" Width="80" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="موقوف" Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="رصيد النظام" Binding="{Binding SystemQty, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="العد الفعلي" Binding="{Binding CountedQty, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الفرق" Binding="{Binding Variance, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                    <!-- (CEEF-229 · م2-٢٤) صار قابلاً للتحرير: بلا تكلفةٍ افتتاحية يدخل المخزون
                         بكميّةٍ بلا قيمة، فيُقيَّد أوّلُ بيعٍ تكلفةً صفراً ويُضخَّم مجمل الربح.
                         والقيمة تُقبل فقط لصنفٍ لا تكلفة له — لا تُعاد كتابة تقييمٍ محسوب. -->
                    <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding UnitCost, StringFormat=N4}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SummaryCard}">
            <TextBlock x:Name="TotalText" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
    </Grid>
</UserControl>
