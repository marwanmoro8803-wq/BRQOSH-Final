<Window x:Class="Brqosh.Desktop.Views.Pages.XmlViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عرض XML"
        Width="800" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource PageTitleText}"
                   FontSize="16" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}">
            <TextBox x:Name="ContentBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"
                    HorizontalAlignment="Right">
            <Button Content="نسخ" Style="{StaticResource SecondaryButton}"
                    Padding="20,8" Click="OnCopy"/>
            <Button Content="إغلاق" Style="{StaticResource PrimaryButton}"
                    Padding="20,8" Margin="10,0,0,0" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
