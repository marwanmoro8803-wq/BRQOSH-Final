<UserControl x:Class="Brqosh.Desktop.Views.Pages.WipPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="أعمال تحت التشغيل (WIP)"/>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="أوامر الإنتاج المفتوحة — قراءة فقط من حالة التصنيع الحالية."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNumber}" Width="130"/>
                    <DataGridTextColumn Header="قائمة المواد" Binding="{Binding BomName}" Width="*"/>
                    <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="مخطط" Binding="{Binding PlannedQuantity, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="منتج" Binding="{Binding ProducedQuantity, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
