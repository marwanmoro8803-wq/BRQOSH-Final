<UserControl x:Class="Brqosh.Desktop.Views.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="المستخدمون" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="RBAC · أدوار · صلاحيات"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddBtn" Content="＋ مستخدم جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </WrapPanel>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="UserSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      MouseDoubleClick="OnEdit">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الدخول" Binding="{Binding Username}" Width="140"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding DisplayNameAr}" Width="*"/>
                    <DataGridTextColumn Header="الدور" Binding="{Binding RoleAr}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
