<Window x:Class="Brqosh.Desktop.Views.Pages.PayrollDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دورة رواتب جديدة" Width="1020" Height="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="دورة رواتب (مسودة)" Style="{StaticResource PageTitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="السطور تُبنى من سجل الموظفين — والتأمينات وأقساط السلف محسوبة لا مكتوبة"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,14"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="السنة *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="YearBox" Style="{StaticResource AppTextBox}" Text="2026"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="الشهر *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MonthBox" Style="{StaticResource AppTextBox}" Text="7"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <TextBlock Text="تاريخ الصرف *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="PayDateBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                <Button x:Name="PreviewBtn" Content="تحديث القائمة" Style="{StaticResource SecondaryButton}"
                        Padding="20,9" HorizontalAlignment="Right" Click="OnPreview"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="False" BorderThickness="0" GridLinesVisibility="Horizontal"
                      FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="يُدرَج" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="اسم الموظف" Binding="{Binding NameAr}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BasicSalary, StringFormat=N2}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="بدل سكن" Binding="{Binding HousingAllowance, StringFormat=N2}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="بدل نقل" Binding="{Binding TransportAllowance, StringFormat=N2}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="تأمينات موظف" Binding="{Binding GosiEmployee, StringFormat=N2}" IsReadOnly="True" Width="105"/>
                    <DataGridTextColumn Header="تأمينات صاحب عمل" Binding="{Binding GosiEmployer, StringFormat=N2}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="قسط السلفة" Binding="{Binding AdvanceDeduction, StringFormat=N2}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="الصافي" Binding="{Binding NetPay, StringFormat=N2}" IsReadOnly="True" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="حفظ مسودة" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
