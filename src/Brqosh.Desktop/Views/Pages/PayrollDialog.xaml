<Window x:Class="Brqosh.Desktop.Views.Pages.PayrollDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دورة رواتب جديدة" Width="900" Height="580"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="دورة رواتب (مسودة)" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="السنة *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="YearBox" Style="{StaticResource AppTextBox}" Text="2026"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="الشهر *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MonthBox" Style="{StaticResource AppTextBox}" Text="7"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="تاريخ الصرف *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="PayDateBox" FontSize="14"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="14" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الموظف" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BasicSalary, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="بدل سكن" Binding="{Binding HousingAllowance, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="بدل نقل" Binding="{Binding TransportAllowance, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="تأمينات موظف" Binding="{Binding GosiEmployee, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="تأمينات صاحب عمل" Binding="{Binding GosiEmployer, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="SemiBold" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="حفظ مسودة" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
