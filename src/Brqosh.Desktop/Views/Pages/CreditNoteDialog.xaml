<Window x:Class="Brqosh.Desktop.Views.Pages.CreditNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Brqosh.Desktop.Ui"
        Title="إشعار دائن جديد"
        Width="860" Height="600"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="إشعار دائن (مردودات مبيعات)" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DatePickerBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="الفاتورة الأصلية *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="InvoiceCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectionChanged="OnInvoiceSelected"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="سبب الإشعار *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ReasonBox" Style="{StaticResource AppTextBox}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36" Background="Transparent"
                      CellEditEnding="OnCellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الوصف / الصنف المرتجع" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="130"/>
                    <DataGridComboBoxColumn Header="الفئة الضريبية" Width="150"
                                                SelectedValueBinding="{Binding VatCategory}"
                                                SelectedValuePath="Value"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding Source={x:Static ui:VatCategoryOptions.All}}"/>
                        <!-- (CEEF-229 · م1-١ب/الشقّ الثاني) سببُ الإعفاء — BR-KSA-CL-06.
                             وبلا هذين العمودين يصير الحارسُ في النطاق بابَاً مغلقاً بلا مفتاح:
                             يمنع البيعَ الصفريَّ والمعفى ولا يهدي المستخدمَ إلى حلّ. -->
                        <DataGridComboBoxColumn Header="سبب الإعفاء" Width="240"
                                                SelectedValueBinding="{Binding TaxExemptionReasonCode}"
                                                SelectedValuePath="Code"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding Source={x:Static ui:VatExemptionReasonOptions.All}}"/>
                        <DataGridTextColumn Header="نصّ السبب (خارج النطاق)" Width="200"
                                            Binding="{Binding TaxExemptionReason}"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="130" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource TotalsCard}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="قبل الضريبة:" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtotalText" Text="0.00" Margin="8,0,24,0" FontWeight="Bold"/>
                <TextBlock Text="الضريبة 15%:" FontWeight="SemiBold"/>
                <TextBlock x:Name="VatText" Text="0.00" Margin="8,0,24,0" FontWeight="Bold"/>
                <TextBlock Text="الإجمالي:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalText" Text="0.00" Margin="8,0,24,0" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" FontSize="{DynamicResource FontSize.Title}"/>
                <TextBlock Text="المتبقي من الفاتورة:" FontWeight="SemiBold"/>
                <TextBlock x:Name="RemainingText" Text="—" Margin="8,0,0,0" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                <Button Content="ترحيل الإشعار" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnPost"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
