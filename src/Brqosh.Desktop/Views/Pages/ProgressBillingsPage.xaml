<UserControl x:Class="Brqosh.Desktop.Views.Pages.ProgressBillingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddBillingBtn" Content="＋ مستخلص جديد" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAddBilling"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="طباعة PDF" Padding="16,9" Margin="0,0,8,0" Click="OnPrintPdf"/>
                    <Button Content="عرض" Padding="16,9" Margin="0,0,8,0" Click="OnView"/>
                    <Button Content="عرض القيد" Padding="16,9" Click="OnViewJournal"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="CancelBillingBtn" DockPanel.Dock="Right" Content="إلغاء"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnCancelBilling"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="المستخلصات" FontSize="{DynamicResource FontSize.Title}"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="فوترة الأعمال · المحتجزات · الترحيل"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="BillingSummaryText" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" SelectionMode="Single"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المستخلص" Binding="{Binding BillingNumber}" Width="140"/>
                    <DataGridTextColumn Header="المشروع" Binding="{Binding ProjectName}" Width="*"/>
                    <DataGridTextColumn Header="الفترة" Binding="{Binding PeriodDescription}" Width="180"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding BillingDate}" Width="110"/>
                    <DataGridTextColumn Header="الأعمال" Binding="{Binding CurrentWorkAmount, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="المحتجز" Binding="{Binding RetentionAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الصافي" Binding="{Binding NetBillableAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
