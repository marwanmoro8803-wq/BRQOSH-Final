<UserControl x:Class="Brqosh.Desktop.Views.Pages.BankReconciliationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="ImportBtn" Content="استيراد كشف CSV"
                            Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0"
                            Click="OnImportStatement"/>
                    <Button x:Name="AutoMatchBtn" Content="مطابقة تلقائية"
                            Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0"
                            Click="OnAutoMatch"/>
                    <Button x:Name="PostDifferenceBtn" Content="قيد فروق"
                            Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0"
                            Click="OnPostDifference"/>
                    <Button x:Name="RunBtn" Content="عرض" Style="{StaticResource PrimaryButton}"
                            Padding="20,9" IsDefault="True" Click="OnRun"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="الحساب البنكي" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="BankCombo" Width="240" Style="{StaticResource AppComboBox}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    <TextBlock Text="من" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <DatePicker x:Name="FromDate" Width="140"/>
                    <TextBlock Text="إلى" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <DatePicker x:Name="ToDate" Width="140"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="مطابقة بنكية" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="كشف البنك مقابل دفتر الأستاذ — مطابقة يدوية أو تلقائية."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Match summary strip -->
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="MatchSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <!-- Split matcher -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ContentCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="سطور كشف البنك (مستورد)"
                               Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="StatementGrid" AutoGenerateColumns="False" BorderThickness="0"
                              Background="Transparent" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate}" Width="100"/>
                            <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountDisplay}" Width="110"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding MatchStatus}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ContentCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="دفتر الأستاذ (غير مُسوّى / الكل)"
                               Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="Grid" AutoGenerateColumns="False" BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="مُسوّى"
                                                    Binding="{Binding IsReconciled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="70"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDate}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="رقم القيد" Binding="{Binding EntryNumber}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SummaryCard}" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
    </Grid>
</UserControl>
