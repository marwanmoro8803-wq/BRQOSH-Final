<Window x:Class="Brqosh.Desktop.Views.Pages.RoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="غرفة" Width="500" Height="340"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="غرفة جديدة" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="رقم الغرفة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NumberBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="صنف الغرفة" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="KindBox" FontSize="{DynamicResource FontSize.BodyLarge}">
                        <ComboBoxItem Content="مفردة"/>
                        <ComboBoxItem Content="مزدوجة" IsSelected="True"/>
                        <ComboBoxItem Content="بسريرين"/>
                        <ComboBoxItem Content="جناح"/>
                        <ComboBoxItem Content="قاعة"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="الدور" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FloorBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="سعر الليلة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RateBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Click="OnCancel"/>
            <Button DockPanel.Dock="Right" Content="حفظ" Style="{StaticResource PrimaryButton}"
                    Padding="26,9" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
