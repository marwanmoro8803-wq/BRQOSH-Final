<UserControl x:Class="Brqosh.Desktop.Views.Pages.CrmOpportunitiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <Button x:Name="AddBtn" DockPanel.Dock="Right" Content="＋ فرصة"
                        Style="{StaticResource PrimaryButton}" Padding="18,9" Click="OnAdd"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="فرص البيع" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="CRM · Pipeline"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,12,0,0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="160"/>
                    <DataGridTextColumn Header="القيمة" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="المرحلة" Binding="{Binding StageLabel}" Width="110"/>
                    <DataGridTextColumn Header="إغلاق متوقع" Binding="{Binding ExpectedClose}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
