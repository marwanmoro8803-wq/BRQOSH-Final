<Window x:Class="Brqosh.Desktop.Views.Pages.ShipmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بوليصة شحن" Width="600" Height="500"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="بوليصة شحن جديدة" Style="{StaticResource PageTitleText}" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="رقم البوليصة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="WaybillBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="تاريخ الشحن *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="ShipDateBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="المرسِل (التاجر) *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ShipperBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="اسم المرسَل إليه *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ConsigneeBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="جوال المرسَل إليه" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PhoneBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="مدينة الوجهة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CityBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="عدد الطرود" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PiecesBox" Style="{StaticResource AppTextBox}" Text="1"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="الوزن كجم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="WeightBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="أجرة الشحن *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FreightBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="مبلغ الدفع عند الاستلام" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CodBox" Style="{StaticResource AppTextBox}" Text="0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="وأجرة الشحن وحدها إيراد الشركة — ومبلغ التحصيل أمانة تُرد للتاجر"
                       Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Click="OnCancel"/>
            <Button DockPanel.Dock="Right" Content="حفظ" Style="{StaticResource PrimaryButton}"
                    Padding="26,9" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
