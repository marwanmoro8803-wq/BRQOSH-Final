<Window x:Class="Brqosh.Desktop.Views.Pages.JournalEntryViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عرض القيد"
        Width="820" Height="520"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="قيد يومية"
                   Style="{StaticResource PageTitleText}" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" Style="{StaticResource PageSubtitleText}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الحساب" Binding="{Binding AccountCode}" Width="100"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="TotalsText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            <Button Content="طباعة PDF" DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}" Padding="20,9" Margin="0,0,8,0"
                    Click="OnPrintPdf"/>
            <Button Content="إغلاق" DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}" Padding="24,9"
                    IsCancel="True" HorizontalAlignment="Right" Click="OnClose"/>
        </DockPanel>
    </Grid>
</Window>
