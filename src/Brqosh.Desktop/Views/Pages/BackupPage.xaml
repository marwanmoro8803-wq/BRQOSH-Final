<UserControl x:Class="Brqosh.Desktop.Views.Pages.BackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="880" HorizontalAlignment="Right">

            <TextBlock Text="النسخ الاحتياطي والاستعادة" Style="{StaticResource PageTitleText}"/>
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,20"
                       Text="نسخةٌ لا تُجرَّب ليست نسخة. خذ نسخةً كلَّ يوم عمل، واحفظها على قرصٍ غير قرص الخادم."/>

            <Border Style="{StaticResource ContentCard}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="أخذ نسخة" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="تُحفَظ النسخةُ باسمٍ يحمل تاريخَها ووقتها، فلا تُكتب فوق سابقتها."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BackupBtn" Content="أخذ نسخة الآن" Click="OnBackup"
                                Style="{StaticResource PrimaryButton}" MinWidth="150"/>
                        <Button Content="فتح مجلّد النسخ" Click="OnOpenFolder" Margin="10,0,0,0" MinWidth="150"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- (CEEF-231 · ط5-٤) نسخةٌ خارج الجهاز — والنصيحةُ أعلاه لم تكن ميزة.
                 القرصُ الذي تتلف عليه القاعدةُ تتلف عليه نسختُها، والفديةُ التي تُشفّر
                 المجلّدَ تُشفّر مجلّدَ النسخ الذي بجواره. -->
            <Border Style="{StaticResource ContentCard}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="نسخة خارج الجهاز" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="وجهة لكل سطر: مسار شبكة أو قرص آخر. وتُتحقق كل نسخة ببصمتها لا بحجمها."/>
                    <TextBox x:Name="DestinationsBox" Style="{StaticResource AppTextBox}"
                             AcceptsReturn="True" TextWrapping="NoWrap" Height="76"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OffsiteBtn" Content="نسخ إلى الوجهات" Click="OnReplicate"
                                Style="{StaticResource PrimaryButton}" MinWidth="170"/>
                    </StackPanel>
                    <TextBlock x:Name="OffsiteResultText" TextWrapping="Wrap" Margin="0,10,0,0"
                               Style="{StaticResource FieldLabel}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCard}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="الاستعادة" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="#B00020"
                               Text="الاستعادة تمحو كلّ ما في القاعدة الحالية وتضع مكانَه محتوى النسخة. لا رجعة فيها. أغلِق التطبيق على بقية الأجهزة قبل البدء."/>
                    <Button x:Name="RestoreBtn" Content="استعادة من ملفّ..." Click="OnRestore" MinWidth="180"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
