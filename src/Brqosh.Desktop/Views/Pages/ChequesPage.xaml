<UserControl x:Class="Brqosh.Desktop.Views.Pages.ChequesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="الشيكات" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="وارد/صادر · محفظة · إيداع · تحصيل"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="NewReceivedBtn" Content="＋ شيك وارد" Style="{StaticResource PrimaryButton}" Padding="18,8" Click="OnNewReceived"/>
                    <Button x:Name="NewIssuedBtn" Content="＋ شيك صادر" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="8,0,0,0" Click="OnNewIssued"/>
                </StackPanel>
            </brq:ToolbarDockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="ChequeSummaryText" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <!-- الجدول -->
        <Border Grid.Row="2" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="14" RowHeight="36"
                      SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الشيك" Binding="{Binding ChequeNumber}" Width="110"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeAr}" Width="70"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding ChequeDate}" Width="100"/>
                    <DataGridTextColumn Header="الطرف" Binding="{Binding PartyName}" Width="*"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- شريط إجراءات الشيك المحدد -->
        <Border Grid.Row="3" Style="{StaticResource ToolbarCard}" Margin="0,12,0,0">
            <brq:ToolbarDockPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="DepositBtn" Content="إيداع" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0" Click="OnDeposit" IsEnabled="False"/>
                    <Button x:Name="ClearBtn" Content="تحصيل/صرف" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0" Click="OnClear" IsEnabled="False"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BounceBtn" Content="ارتجاع" Style="{StaticResource SoftDangerButton}" Padding="14,7" Margin="0,0,8,0" Click="OnBounce" IsEnabled="False"/>
                    <Button x:Name="CancelBtn" Content="إلغاء" Style="{StaticResource SoftDangerButton}" Padding="14,7" Margin="0,0,8,0" Click="OnCancelCheque" IsEnabled="False"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض قيود الشيك" Style="{StaticResource SecondaryButton}" Padding="14,7" Click="OnViewJournals"/>
                </WrapPanel>
            </brq:ToolbarDockPanel>
        </Border>
    </Grid>
</UserControl>
