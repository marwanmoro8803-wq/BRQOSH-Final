<UserControl x:Class="Brqosh.Desktop.Views.Pages.MenuItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brq="clr-namespace:Brqosh.Desktop.Ui"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <brq:ToolbarDockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="قائمة الطعام والوصفات" FontSize="17"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="بيع الطبق يصرف مكوناته — وبغير وصفة يبقى المخزون كما اشتُري"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddBtn" Content="＋ صنف قائمة" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnAdd"/>
                </WrapPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="IssueBtn" DockPanel.Dock="Right" Content="صرف مكونات المبيع"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnIssue"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <TextBox x:Name="ServingsBox" DockPanel.Dock="Right" Width="90" Text="1"
                         Style="{StaticResource AppTextBox}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="عدد الحصص المباعة" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
            </brq:ToolbarDockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,10,0">
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" SelectionChanged="OnItemSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="110"/>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding NameAr}" Width="*"/>
                        <DataGridTextColumn Header="القسم" Binding="{Binding Section}" Width="110"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding SalePrice, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="المكونات" Binding="{Binding Components}" Width="100"/>
                        <DataGridTextColumn Header="الصرف" Binding="{Binding LinkState}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource ContentCard}">
                <DataGrid x:Name="ComponentsGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المكوّن" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="لكل حصة" Binding="{Binding Quantity, StringFormat=N4}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
