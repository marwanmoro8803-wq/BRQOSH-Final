<UserControl x:Class="Brqosh.Desktop.Views.Pages.StockMovementsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="NewBtn" Content="＋ حركة مخزنية" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnNew"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="عرض" Padding="16,9" Margin="0,0,8,0" Click="OnView"/>
                    <Button Content="عرض القيد" Padding="16,9" Click="OnViewJournal"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="إلغاء"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnCancel"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="حركات المخزون" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="إدخال · إخراج · تحويل · ترحيل"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      EnableRowVirtualization="True" SelectionMode="Single"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم" Binding="{Binding MovementNumber}" Width="140"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding MovementDate}" Width="110"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeAr}" Width="120"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="القيمة" Binding="{Binding TotalValue, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
