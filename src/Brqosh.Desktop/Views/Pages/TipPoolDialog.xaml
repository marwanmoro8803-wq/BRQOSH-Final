<Window x:Class="Brqosh.Desktop.Views.Pages.TipPoolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="وعاء إكراميات جديد" Height="520" Width="760"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="وعاء إكراميات جديد" Style="{StaticResource PageTitleText}"
                   Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="رسم الخدمة لا يدخل هنا — هو إيراد خاضع للضريبة وسطر في الفاتورة"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="تاريخ الوعاء" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DateBox" FontSize="{DynamicResource FontSize.BodyLarge}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="إكراميات نقدية" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CashBox" Style="{StaticResource AppTextBox}" Text="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="إكراميات بطاقة" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CardBox" Style="{StaticResource AppTextBox}" Text="0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DataGrid x:Name="StaffGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                      BorderThickness="0" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="EmployeeColumn" Header="العامل"
                                            SelectedValueBinding="{Binding EmployeeId}"
                                            SelectedValuePath="Id" DisplayMemberPath="Label" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource AlertStrip}" Margin="0,12,0,0" Padding="16,10">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                       Text="تقسم الحصص بالتساوي على العاملين المختارين — وآخر حصة تأخذ الباقي فلا يبقى فلس بلا صاحب"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ الوعاء" Style="{StaticResource PrimaryButton}" Padding="20,9"
                    Click="OnSave"/>
            <Border Style="{StaticResource ToolbarSpacer}"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="18,9"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
