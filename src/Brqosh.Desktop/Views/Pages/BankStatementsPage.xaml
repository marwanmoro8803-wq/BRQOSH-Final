<UserControl x:Class="Brqosh.Desktop.Views.Pages.BankStatementsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="كشوف الحسابات البنكية" FontSize="16"/>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="استيراد · مطابقة آلية · ترحيل الفروق"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Style="{StaticResource ToolbarPrimaryGroup}">
                    <Button x:Name="ImportBtn" Content="استيراد كشف" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="OnImport"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="PostDifferenceBtn" DockPanel.Dock="Right" Content="ترحيل السطر فرقًا"
                        Style="{StaticResource SoftDangerButton}" Padding="16,9" Click="OnPostDifference"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <Button x:Name="MatchBtn" DockPanel.Dock="Right" Content="مطابقة آلية"
                        Style="{StaticResource SecondaryButton}" Padding="16,9" Click="OnMatch"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSpacer}"/>
                <ComboBox x:Name="BankBox" DockPanel.Dock="Right" Width="240" FontSize="14"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock DockPanel.Dock="Right" Text="الحساب البنكي" VerticalAlignment="Center"
                           Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AlertStrip}" Margin="0,12,0,12" Padding="16,10">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,10,0">
                <DataGrid x:Name="StatementsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" SelectionChanged="OnStatementSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الملف" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="السطور" Binding="{Binding LineCount}" Width="80"/>
                        <DataGridTextColumn Header="غير مطابق" Binding="{Binding Unmatched}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource ContentCard}">
                <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="120"/>
                        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="140"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="130"/>
                        <DataGridTextColumn Header="المطابقة" Binding="{Binding MatchState}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
