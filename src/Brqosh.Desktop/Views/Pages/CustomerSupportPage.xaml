<UserControl x:Class="Brqosh.Desktop.Views.Pages.CustomerSupportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleText}" FontSize="{DynamicResource FontSize.Title}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
        </Border>

        <!-- (commercial-readiness#7) القنواتُ والباقاتُ من config/support.json الذي يعتمده المورّد — وبدونه تقول الشاشةُ ذلك. -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="SlaTitle" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="SupportStateText" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <DataGrid x:Name="SlaGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                          FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="32" MaxHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="SlaPlanCol" Binding="{Binding Plan}" Width="*"/>
                        <DataGridTextColumn x:Name="SlaResponseCol" Binding="{Binding Response}" Width="160"/>
                        <DataGridTextColumn x:Name="SlaHoursCol" Binding="{Binding Hours}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel x:Name="EmailRow" Margin="0,12,0,0">
                    <TextBlock x:Name="EmailLabel" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="EmailText" FlowDirection="LeftToRight"/>
                </WrapPanel>
                <WrapPanel x:Name="PhoneRow" Margin="0,4,0,0">
                    <TextBlock x:Name="PhoneLabel" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PhoneText" FlowDirection="LeftToRight"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- طلبٌ جديد: سؤال · مشكلة · شكوى · اقتراح — يُسجَّل برقمٍ على هذا الجهاز، ويُفتح بريدٌ جاهزٌ إن اعتُمد عنوانُ الدعم. -->
        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Padding="20" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="NewTitle" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="KindLabel" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="KindBox" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" Margin="0,0,0,10" MaxWidth="320" HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="SupportKind"/>
                <TextBlock x:Name="SubjectLabel" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="SubjectBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,10" MaxLength="140"
                         AutomationProperties.AutomationId="SupportSubject"/>
                <TextBlock x:Name="DetailsLabel" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DetailsBox" Style="{StaticResource AppTextBox}" TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="84" MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" MaxLength="4000"
                         AutomationProperties.AutomationId="SupportDetails"/>
                <TextBlock x:Name="FormError" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button x:Name="RegisterBtn" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,6"
                            AutomationProperties.AutomationId="SupportRegister" Click="OnRegister"/>
                    <Button x:Name="RegisterMailBtn" Style="{StaticResource SecondaryButton}" Padding="20,9" Margin="0,0,8,6"
                            AutomationProperties.AutomationId="SupportRegisterMail" Click="OnRegisterAndMail"/>
                </WrapPanel>
                <TextBlock x:Name="HonestyText" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="RequestsTitle" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TicketsSummaryText" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="CopyBtn" Style="{StaticResource SecondaryButton}" Padding="16,7" Margin="0,0,8,6" Click="OnCopyRequest"/>
                        <Button x:Name="MailBtn" Style="{StaticResource SecondaryButton}" Padding="16,7" Margin="0,0,8,6" Click="OnMailRequest"/>
                        <Button x:Name="CloseBtn" Style="{StaticResource SecondaryButton}" Padding="16,7" Margin="0,0,8,6" Click="OnCloseRequest"/>
                    </WrapPanel>
                </StackPanel>
                <DataGrid x:Name="TicketsGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                          FontSize="{DynamicResource FontSize.BodyLarge}" RowHeight="34" SelectionMode="Single" MinHeight="120"
                          AutomationProperties.AutomationId="SupportRequestsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="IdCol" Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn x:Name="KindCol" Binding="{Binding KindLabel}" Width="100"/>
                        <DataGridTextColumn x:Name="SubjectCol" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn x:Name="DateCol" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn x:Name="StatusCol" Binding="{Binding StatusLabel}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
