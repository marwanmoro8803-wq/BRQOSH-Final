<Window x:Class="Brqosh.Desktop.Views.Pages.WorkOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="أمر إنتاج جديد" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource BackgroundBrush}" ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="أمر إنتاج (مسودة)" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

        <TextBlock Text="قائمة المواد (BOM) *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="BomCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" DisplayMemberPath="Display" SelectedValuePath="Id" Margin="0,0,0,14"/>

        <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DateBox" FontSize="{DynamicResource FontSize.BodyLarge}" Margin="0,0,0,14"/>

        <TextBlock Text="الكمية المخططة *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="QtyBox" Style="{StaticResource AppTextBox}" Text="1" Margin="0,0,0,14"/>

        <!-- (جاهزيّةُ الإطلاق · ح-٩٧) مستودعا الأمر — وكان الافتراضيَّ أبداً؛ والفارغُ هو الافتراضيّ كما كان. -->
        <TextBlock Text="مستودع المواد (تُصرف منه)" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="MaterialsWarehouseCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" DisplayMemberPath="Display" SelectedValuePath="Id" Margin="0,0,0,14"/>

        <TextBlock Text="مستودع الإنتاج (يُسلَّم إليه)" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="OutputWarehouseCombo" FontSize="{DynamicResource FontSize.BodyLarge}" Padding="10,8" DisplayMemberPath="Display" SelectedValuePath="Id" Margin="0,0,0,14"/>

        <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NotesBox" Style="{StaticResource AppTextBox}" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="OnSave" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,9" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
