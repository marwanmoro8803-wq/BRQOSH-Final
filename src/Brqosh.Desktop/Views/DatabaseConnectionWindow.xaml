<Window x:Class="Brqosh.Desktop.Views.DatabaseConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Brqosh.Desktop.Views.Controls"
        Title="BRQOSH — إعدادات الاتصال بقاعدة البيانات"
        Width="720" SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32">

            <TextBlock Text="إعدادات الاتصال بقاعدة البيانات"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <Border Height="3" Width="44" CornerRadius="2" HorizontalAlignment="Right"
                    Background="{StaticResource AccentBrush}" Margin="0,12,0,0"/>

            <TextBlock x:Name="ReasonText"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>

            <Border Style="{StaticResource ContentCard}" Padding="28,24" Margin="0,20,0,0">
                <controls:DatabaseConnectionPanel x:Name="ConnectionPanel"/>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton"
                        Grid.Column="0"
                        Content="حفظ ومتابعة"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        FontSize="15" Padding="24,12"
                        Click="OnSave"/>
                <Button Grid.Column="2"
                        Content="إغلاق البرنامج"
                        Style="{StaticResource SecondaryButton}"
                        Padding="20,12"
                        Click="OnCancel"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
