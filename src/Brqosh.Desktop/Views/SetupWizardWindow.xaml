<Window x:Class="Brqosh.Desktop.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BRQOSH — إعداد النظام"
        Width="900" Height="760"
        MinWidth="800" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="52,40" MaxWidth="800">

            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="مرحباً بك في BRQOSH"
                           FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Height="4" Width="72" CornerRadius="2" HorizontalAlignment="Right"
                        Background="{StaticResource BrandAccentGradient}" Margin="0,12,0,0"/>
                <TextBlock Text="اختر نمط العمل المناسب لنشاطك — سيُفعّل النظام الوحدات والقوائم والحسابات المناسبة تلقائياً."
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="① نمط العمل"/>

            <Border Style="{StaticResource ContentCard}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="القطاع / نمط العمل *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ProfileCombo" Style="{StaticResource AppComboBox}" DisplayMemberPath="NameAr"/>
                    <TextBlock x:Name="IndustryPreviewText"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="①ب قالب الدولة"/>

            <Border Style="{StaticResource ContentCard}" Padding="20,16" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="CountryTemplateTitle"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="CountryTemplateDetails"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="TemplatePreviewPanel" Style="{StaticResource ContentCard}"
                    Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="معاينة القالب القطاعي"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="IndustryTemplateTitle"
                               FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="الوحدات المفعّلة:" Style="{StaticResource FieldLabel}" Margin="0,4,0,2"/>
                    <TextBlock x:Name="TemplateModulesText"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="الميزات:" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
                    <TextBlock x:Name="TemplateFeaturesText"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="② بيانات المنشأة"/>

            <Border Style="{StaticResource ContentCard}" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="اسم المنشأة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CompanyNameBox" Style="{StaticResource AppTextBox}"/>

                    <TextBlock Text="الرقم الضريبي — 15 خانة (اختياري الآن)"
                               Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <TextBox x:Name="VatNumberBox" Style="{StaticResource AppTextBox}"
                             MaxLength="15"/>
                    <TextBlock Text="مطلوب قبل تفعيل الفوترة الإلكترونية (ZATCA)."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="③ حساب المدير"/>

            <Border Style="{StaticResource ContentCard}" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="اسم المستخدم *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AdminUsernameBox" Style="{StaticResource AppTextBox}"/>

                    <TextBlock Text="كلمة المرور *"
                               Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="AdminPasswordBox" Style="{StaticResource AppPasswordBox}"/>

                    <TextBlock Text="تأكيد كلمة المرور *"
                               Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="AdminPasswordConfirmBox" Style="{StaticResource AppPasswordBox}"/>

                    <TextBlock x:Name="PolicyHintText"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <Button Content="ابدأ العمل الآن"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,24,0,40"
                    FontSize="16"
                    Padding="24,14"
                    Click="OnStartClicked"/>
        </StackPanel>
    </ScrollViewer>
</Window>
