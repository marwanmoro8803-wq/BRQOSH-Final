<Window x:Class="Brqosh.Desktop.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Brqosh.Desktop.Views.Controls"
        Title="BRQOSH — إعداد النظام"
        Width="1240" Height="760"
        MinWidth="1040" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- (طلبُ المالك) لوحةٌ حيّة: أنواعُ الأنشطة تتبدّل بأيقونةٍ وعنوانٍ وسطرِ خدمات، بألوان صفحة الانتظار وتوهّجها -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                    <GradientStop Color="#1A1411" Offset="0"/>
                    <GradientStop Color="#2B1D12" Offset="0.55"/>
                    <GradientStop Color="#1A1411" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border>
                <Border.Background>
                    <RadialGradientBrush x:Name="HeroGlow" Opacity="0.5" RadiusX="0.5" RadiusY="0.32">
                        <RadialGradientBrush.RelativeTransform><ScaleTransform x:Name="HeroGlowScale" CenterX="0.5" CenterY="0.5" ScaleX="0.9" ScaleY="0.9"/></RadialGradientBrush.RelativeTransform>
                        <GradientStop Color="#66C98A4B" Offset="0"/>
                        <GradientStop Color="#00C98A4B" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Margin="32,0">
                    <TextBlock x:Name="HeroHeadline" FontSize="{DynamicResource FontSize.Title}" FontWeight="Bold" Foreground="#F7EFE4"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="HeroTagline" FontSize="{DynamicResource FontSize.Small}" Foreground="#B9A793"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,36"/>
                    <Border x:Name="HeroCard" CornerRadius="16" Padding="22,26" Background="#26F7EFE4" BorderBrush="#55C98A4B" BorderThickness="1">
                        <Border.RenderTransform><TranslateTransform x:Name="HeroCardShift"/></Border.RenderTransform>
                        <StackPanel>
                            <Viewbox Height="72" HorizontalAlignment="Center">
                                <TextBlock x:Name="HeroIcon" FontFamily="Segoe UI Emoji" Foreground="#E3B07A"/>
                            </Viewbox>
                            <TextBlock x:Name="HeroTitle" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" Foreground="#F7EFE4"
                                       HorizontalAlignment="Center" Margin="0,14,0,8"/>
                            <TextBlock x:Name="HeroServices" FontSize="{DynamicResource FontSize.Body}" Foreground="#D9C7B0"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="HeroDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>
        </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="52,40" MaxWidth="800">

            <StackPanel Margin="0,0,0,8">
                <controls:BrandLogo MarkHeight="96" NameSize="20" Animate="True" HorizontalAlignment="Center" Margin="0,0,0,18"
                                    MarkBrush="{DynamicResource PrimaryLightBrush}" NameBrush="{DynamicResource PrimaryLightBrush}"/>
                <TextBlock Text="مرحباً بك في BRQOSH"
                           FontSize="{DynamicResource FontSize.Hero}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Border Height="4" Width="72" CornerRadius="2" HorizontalAlignment="Right"
                        Background="{StaticResource BrandAccentGradient}" Margin="0,12,0,0"/>
                <TextBlock Text="اختر نمط العمل المناسب لنشاطك — سيُفعّل النظام الوحدات والقوائم والحسابات المناسبة تلقائياً."
                           FontSize="{DynamicResource FontSize.BodyLarge}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="① نمط العمل"/>

            <Border Style="{StaticResource ContentCard}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="القطاع / نمط العمل *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ProfileCombo" Style="{StaticResource AppComboBox}" DisplayMemberPath="NameAr"/>
                    <TextBlock x:Name="IndustryPreviewText"
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="①ب قالب الدولة"/>

            <Border Style="{StaticResource ContentCard}" Padding="20,16" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="CountryTemplateTitle"
                               FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="CountryTemplateDetails"
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="TemplatePreviewPanel" Style="{StaticResource ContentCard}"
                    Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="معاينة القالب القطاعي"
                               FontSize="{DynamicResource FontSize.BodyLarge}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="IndustryTemplateTitle"
                               FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" Margin="0,8,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="الوحدات المفعّلة:" Style="{StaticResource FieldLabel}" Margin="0,4,0,2"/>
                    <TextBlock x:Name="TemplateModulesText"
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="الميزات:" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
                    <TextBlock x:Name="TemplateFeaturesText"
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="② بيانات المنشأة"/>

            <Border Style="{StaticResource ContentCard}" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="اسم المنشأة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CompanyNameBox" Style="{StaticResource AppTextBox}"/>

                    <TextBlock Text="الرقم الضريبي — 15 خانة (اختياري الآن)"
                               Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <TextBox x:Name="VatNumberBox" Style="{StaticResource AppTextBox}"
                             MaxLength="15"/>
                    <TextBlock Text="مطلوب قبل تفعيل الفوترة الإلكترونية (ZATCA)."
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="③ حساب المدير"/>

            <Border Style="{StaticResource ContentCard}" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="اسم المستخدم *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AdminUsernameBox" Style="{StaticResource AppTextBox}"/>

                    <TextBlock Text="كلمة المرور *"
                               Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="AdminPasswordBox" Style="{StaticResource AppPasswordBox}"/>

                    <TextBlock Text="تأكيد كلمة المرور *"
                               Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="AdminPasswordConfirmBox" Style="{StaticResource AppPasswordBox}"/>

                    <TextBlock x:Name="PolicyHintText"
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!--
              (CEEF-236 · ت-٣) قاعدةُ البيانات تُدخَل من هنا لا بتأليف database.json باليد:
              في الإنتاج كان التطبيقُ يرمي إن غاب الملفُّ ولا شاشةٌ تكتبه، فأوّلُ إقلاعٍ عند
              العميل كان يشترط محرّرَ نصوصٍ وكلمةَ مرورٍ صريحة. واللوحةُ مشتركةٌ مع
              DatabaseConnectionWindow فلا يتكرّر منطقُ التحقّق والحفظ في موضعَين.
            -->
            <TextBlock Style="{StaticResource FormSectionTitle}" Text="④ قاعدة البيانات"/>

            <Border Style="{StaticResource ContentCard}" Padding="28,24">
                <controls:DatabaseConnectionPanel x:Name="ConnectionPanel"/>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <Button x:Name="StartButton"
                    Content="ابدأ العمل الآن"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,24,0,40"
                    FontSize="{DynamicResource FontSize.Title}"
                    Padding="24,14"
                    Click="OnStartClicked"/>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Window>
