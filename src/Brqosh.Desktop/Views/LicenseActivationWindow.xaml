<Window x:Class="Brqosh.Desktop.Views.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفعيل ترخيص BRQOSH"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    <Border Style="{StaticResource AuthCard}" Margin="28">
        <StackPanel>
            <!-- رأس البطاقة -->
            <StackPanel Margin="0,0,0,24">
                <Border Height="3" Width="44" Background="{DynamicResource AccentBrush}"
                        CornerRadius="2" HorizontalAlignment="Right" Margin="0,0,0,18"/>
                <TextBlock Text="تفعيل الترخيص"
                           FontSize="{DynamicResource FontSize.Heading}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="أدخل مفتاح الترخيص المرسل من فريق الدعم الفني."
                           FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- حالةُ الترخيص الحالية -->
            <Border x:Name="StatusPanel" CornerRadius="2" Padding="12,9" Margin="0,0,0,16"
                    Background="{DynamicResource WarningSoftBrush}" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Small}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>

            <!-- معرّف الجهاز (قراءة فقط) -->
            <TextBlock Text="معرّف الجهاز" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="MachineIdBox" Style="{StaticResource AppTextBox}"
                     IsReadOnly="True" Margin="0,0,0,16"
                     Background="#FFFDF8"/>

            <!-- اسم المنشأة -->
            <TextBlock Text="اسم المنشأة" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="CompanyBox" Style="{StaticResource AppTextBox}"
                     IsReadOnly="True" Background="#FFFDF8"
                     Margin="0,0,0,16"/>

            <!-- مفتاح الترخيص -->
            <TextBlock Text="مفتاح الترخيص" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="KeyBox" Style="{StaticResource AppTextBox}"
                     FlowDirection="LeftToRight" FontFamily="{StaticResource FigureFont}"
                     FontSize="{DynamicResource FontSize.TitleLarge}" TextAlignment="Center" MinHeight="46"
                     VerticalContentAlignment="Center"/>
            <TextBlock x:Name="KeyHint" FontSize="{DynamicResource FontSize.Caption}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>

            <!-- رسالة الخطأ -->
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <!-- زر التفعيل -->
            <Button x:Name="ActivateButton"
                    Content="تفعيل الترخيص"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,24,0,0"
                    Click="OnActivate"/>
        </StackPanel>
    </Border>
</Window>
