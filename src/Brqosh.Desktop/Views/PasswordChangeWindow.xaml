<Window x:Class="Brqosh.Desktop.Views.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <Border Style="{StaticResource AuthCard}" Margin="28">
        <StackPanel>
            <!-- رأس البطاقة -->
            <StackPanel Margin="0,0,0,28">
                <Border Height="3" Width="44" Background="{StaticResource PrimaryBrush}"
                        CornerRadius="2" HorizontalAlignment="Right" Margin="0,0,0,18"/>
                <TextBlock Text="تغيير كلمة المرور مطلوب"
                           FontSize="{DynamicResource FontSize.Heading}" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="لأسباب أمنية، يجب تعيين كلمة مرور جديدة قبل المتابعة."
                           FontSize="{DynamicResource FontSize.Body}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- الحقول -->
            <TextBlock Text="كلمة المرور الحالية" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource AppPasswordBox}"
                         Margin="0,0,0,16"/>

            <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource AppPasswordBox}"
                         Margin="0,0,0,16"/>

            <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource AppPasswordBox}"/>

            <!-- إرشادات -->
            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="8"
                    Padding="12,10" Margin="0,12,0,0">
                <TextBlock x:Name="PolicyHintText"
                           FontSize="{DynamicResource FontSize.Small}" Foreground="{StaticResource PrimaryDarkBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- رسالة الخطأ -->
            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <!-- زر الإجراء -->
            <Button Content="حفظ والمتابعة"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,24,0,0"
                    Click="OnSave"/>

            <!-- (security-licensing-tenancy#7) للمدير وحده: مفتاحُ استعادةٍ جديدٌ يُبطل ما قبله -->
            <Button x:Name="ReissueKeyButton"
                    Content="إصدار مفتاح استعادة جديد"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0"
                    Visibility="Collapsed"
                    Click="OnReissueKey"/>
        </StackPanel>
    </Border>
</Window>
