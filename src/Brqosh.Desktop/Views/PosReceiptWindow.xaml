<Window x:Class="Brqosh.Desktop.Views.PosReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إيصال البيع — BRQOSH" Height="520" Width="420"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" ResizeMode="NoResize">
    <Border Padding="24" Background="{StaticResource SurfaceBrush}">
        <StackPanel>
            <TextBlock x:Name="CompanyText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="فاتورة ضريبية مبسّطة" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,16"/>
            <TextBlock x:Name="InvoiceNumberText" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtotalText" FontSize="13" Margin="0,12,0,0"/>
            <TextBlock x:Name="VatText" FontSize="13"/>
            <TextBlock x:Name="TotalText" FontSize="22" FontWeight="Bold" Margin="0,8,0,16"/>
            <StackPanel x:Name="QrPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                <Image x:Name="QrImage" Width="180" Height="180" Margin="0,0,0,8"/>
                <TextBlock x:Name="ZatcaStatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <Button Content="إغلاق" Style="{StaticResource PrimaryButton}" Padding="32,10"
                    Margin="0,20,0,0" HorizontalAlignment="Center" Click="OnClose"/>
        </StackPanel>
    </Border>
</Window>
