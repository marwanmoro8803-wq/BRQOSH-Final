<Window x:Class="Brqosh.Desktop.Views.PosReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إيصال البيع — BRQOSH" Height="680" Width="380"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" ResizeMode="NoResize">
    <DockPanel Background="{DynamicResource SurfaceBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,16">
            <Button Content="طباعة" Style="{StaticResource PrimaryButton}" Padding="28,10" Click="OnPrint"/>
            <Button Content="إغلاق" Style="{StaticResource SecondaryButton}" Padding="28,10" Margin="12,0,0,0" Click="OnClose"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- ‏(ح-١٢٣) ‏لوحةُ الإيصال وحدَها تُطبع — بعرض شريطٍ حراريٍّ ٨٠ ملم (٢٨٠ وحدةً ≈ ٧٤ ملم قابلةً للطباعة). -->
            <StackPanel x:Name="ReceiptPanel" Width="280" Margin="0,16,0,0" Background="White">
                <!-- ‏(المخرجاتُ كلُّها بهويّةٍ واحدة) ‏شعارُ المنشأة إن رفعته، وإلا درعُ BRQOSH — بالأسود لأنّ الطابعةَ الحراريّةَ لا تعرف الألوان. -->
                <Image x:Name="LogoImage" MaxWidth="150" MaxHeight="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed"/>
                <Path x:Name="MarkPath" Data="{StaticResource BrqoshMarkGeometry}" Fill="Black" Stretch="Uniform" Width="26" Height="32"
                      HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="CompanyText" FontSize="{DynamicResource FontSize.Title}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="VatNumberText" FontSize="{DynamicResource FontSize.Caption}" HorizontalAlignment="Center"/>
                <TextBlock Text="فاتورة ضريبية مبسّطة" FontSize="{DynamicResource FontSize.Small}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                <TextBlock x:Name="InvoiceNumberText" FontSize="{DynamicResource FontSize.Small}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="IssuedAtText" FontSize="{DynamicResource FontSize.Caption}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <ItemsControl x:Name="LinesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSize.Small}" TextWrapping="Wrap"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontSize="{DynamicResource FontSize.Small}" Text="{Binding LineTotal, StringFormat=N2}"/>
                                    <TextBlock FontSize="{DynamicResource FontSize.Caption}">
                                        <Run Text="{Binding Quantity, StringFormat=N2, Mode=OneWay}"/>
                                        <Run Text="×"/>
                                        <Run Text="{Binding UnitPrice, StringFormat=N2, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="0,8"/>
                <TextBlock x:Name="SubtotalText" FontSize="{DynamicResource FontSize.Small}"/>
                <TextBlock x:Name="VatText" FontSize="{DynamicResource FontSize.Small}"/>
                <TextBlock x:Name="TotalText" FontSize="{DynamicResource FontSize.TitleLarge}" FontWeight="Bold" Margin="0,6,0,10"/>
                <Image x:Name="QrImage" Width="160" Height="160" Margin="0,0,0,6" Visibility="Collapsed"/>
                <TextBlock x:Name="ZatcaStatusText" FontSize="{DynamicResource FontSize.Caption}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
