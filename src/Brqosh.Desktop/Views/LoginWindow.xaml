<Window x:Class="Brqosh.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Brqosh.Desktop.Views.Controls"
        Title="BRQOSH — تسجيل الدخول"
        Width="1060" Height="680"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource HeroPanelGradient}">
            <Grid Margin="56,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <!-- في الواجهة العربيّة «Left» هو الطرفُ البصريّ الأيمن — حيث يبدأ النصُّ تحته. -->
                    <controls:BrandLogo MarkHeight="150" NameSize="30" HorizontalAlignment="Left" Animate="True"/>
                    <Border Height="4" Width="80" Background="{StaticResource AccentBrush}"
                            CornerRadius="2" HorizontalAlignment="Left"
                            Margin="0,20,0,20"/>
                    <TextBlock Text="نظام تخطيط موارد المؤسسة"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#DCE9F3" TextWrapping="Wrap"/>
                    <TextBlock Text="محاسبة · مقاولات · تصنيع · نقاط بيع"
                               FontSize="14" Foreground="#E3C766"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <StackPanel Margin="0,32,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="فوترة إلكترونية متوافقة مع هيئة الزكاة والضريبة"
                                       FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="تقارير مالية احترافية وتحليل الأداء"
                                       FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="إدارة المخزون والمستودعات المتعددة"
                                       FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="© BRQOSH ERP — جميع الحقوق محفوظة"
                           FontSize="11" Foreground="#E3C766"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,24"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                <Grid MinHeight="640">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" Style="{StaticResource AuthCard}" Margin="28,24">
                        <StackPanel>
                            <Border Height="3" Width="48" Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="2" HorizontalAlignment="Right"
                                    Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button x:Name="LoginTabButton" Content="تسجيل الدخول"
                                        Style="{StaticResource AuthTabButton}" Tag="active"
                                        Click="OnLoginTab"/>
                                <Button x:Name="RegisterTabButton" Content="طلب حساب مستخدم"
                                        Style="{StaticResource AuthTabButton}"
                                        Click="OnRegisterTab"/>
                            </StackPanel>

                            <!-- ═══ لوحة الدخول ═══ -->
                            <StackPanel x:Name="LoginPanel">
                                <TextBlock Text="مرحباً بعودتك"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="سجّل دخولك للمتابعة"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,6,0,24"/>

                                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="UsernameBox"
                                         Style="{StaticResource AppTextBox}"
                                         AutomationProperties.AutomationId="LoginUsername"
                                         AutomationProperties.Name="اسم المستخدم"/>

                                <TextBlock Text="كلمة المرور"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,16,0,6"/>
                                <Grid>
                                    <PasswordBox x:Name="PasswordBox"
                                                 Style="{StaticResource AppPasswordBox}"
                                                 Padding="14,11,44,11"
                                                 AutomationProperties.Name="كلمة المرور"/>
                                    <TextBox x:Name="PasswordPlainBox"
                                             Style="{StaticResource AppTextBox}"
                                             Padding="14,11,44,11"
                                             Visibility="Collapsed"
                                             AutomationProperties.AutomationId="LoginPasswordPlain"
                                             AutomationProperties.Name="كلمة المرور"/>
                                    <ToggleButton x:Name="PasswordRevealToggle"
                                                  Style="{StaticResource PasswordRevealButton}"
                                                  AutomationProperties.AutomationId="LoginPasswordReveal"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <CheckBox x:Name="RememberMeBox" Content="تذكرني"
                                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <Button Content="نسيت كلمة المرور؟"
                                            Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Click="OnForgotPassword"/>
                                </Grid>

                                <TextBlock x:Name="MfaLabel"
                                           Text="رمز المصادقة (MFA)"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,16,0,6"
                                           Visibility="Collapsed"/>
                                <TextBox x:Name="MfaBox"
                                         Style="{StaticResource AppTextBox}"
                                         MaxLength="6"
                                         Visibility="Collapsed"
                                         AutomationProperties.Name="رمز MFA"/>

                                <TextBlock x:Name="ErrorText"
                                           AutomationProperties.AutomationId="LoginError"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Margin="0,14,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

                                <Button Content="تسجيل الدخول"
                                        Style="{StaticResource PrimaryButton}"
                                        AutomationProperties.AutomationId="LoginSubmit"
                                        AutomationProperties.Name="تسجيل الدخول"
                                        IsDefault="True"
                                        Margin="0,24,0,0"
                                        Click="OnLogin"/>
                            </StackPanel>

                            <!-- ═══ لوحة التسجيل ═══ -->
                            <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                                <TextBlock Text="طلب حساب مستخدم"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="أدخل بياناتك ورمز التحقق — يفعّل المدير الحساب بعد المراجعة."
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,8"/>
                                <TextBlock Text="إنشاء منشأة جديدة يتطلب صلاحية مدير النظام أو معالج المنشآت — من إعدادات المنشأة بعد تسجيل الدخول."
                                           FontSize="12" Foreground="{StaticResource InfoBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <TextBlock Text="الاسم المعروض" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RegDisplayBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RegUsernameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="رقم الجوال" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RegMobileBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,12">
                                    <PasswordBox x:Name="RegPasswordBox"
                                                 Style="{StaticResource AppPasswordBox}"
                                                 Padding="14,11,44,11"/>
                                    <TextBox x:Name="RegPasswordPlainBox"
                                             Style="{StaticResource AppTextBox}"
                                             Padding="14,11,44,11"
                                             Visibility="Collapsed"/>
                                    <ToggleButton x:Name="RegPasswordRevealToggle"
                                                  Style="{StaticResource PasswordRevealButton}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,12">
                                    <PasswordBox x:Name="RegConfirmPasswordBox"
                                                 Style="{StaticResource AppPasswordBox}"
                                                 Padding="14,11,44,11"/>
                                    <TextBox x:Name="RegConfirmPlainBox"
                                             Style="{StaticResource AppTextBox}"
                                             Padding="14,11,44,11"
                                             Visibility="Collapsed"/>
                                    <ToggleButton x:Name="RegConfirmRevealToggle"
                                                  Style="{StaticResource PasswordRevealButton}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="8,0,0,0"/>
                                </Grid>

                                <Button x:Name="SendRegOtpButton"
                                        Content="إنشاء رمز التحقق"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnSendRegistrationOtp"/>

                                <TextBlock x:Name="RegOtpHintText"
                                           FontSize="12" Foreground="{StaticResource InfoBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed"/>

                                <TextBlock Text="رمز التحقق" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <TextBox x:Name="RegOtpBox" Style="{StaticResource AppTextBox}" MaxLength="6"/>

                                <TextBlock x:Name="RegisterErrorText"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Margin="0,14,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

                                <TextBlock x:Name="RegisterSuccessText"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Margin="0,14,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

                                <Button Content="إرسال طلب الحساب"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,20,0,0"
                                        Click="OnRegister"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="44,0,44,24" Opacity="0.6">
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
                        <TextBlock x:Name="EnvironmentFooterText" Text="BRQOSH ERP v4"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
