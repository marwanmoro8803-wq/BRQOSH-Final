<Window x:Class="Brqosh.Desktop.Views.OrganizationProvisionerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BRQOSH — إنشاء منشأة جديدة"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32" MaxWidth="640">
            <TextBlock Text="إنشاء منشأة جديدة"
                       FontSize="{DynamicResource FontSize.Display}" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="يُنشئ شركة جديدة مع دليل حسابات وفرع ومستودع حسب القطاع. يتطلب صلاحية مدير النظام."
                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,20"/>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="① القطاع والدولة"/>
            <Border Style="{StaticResource ContentCard}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="نمط العمل *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ProfileCombo" Style="{StaticResource AppComboBox}" DisplayMemberPath="NameAr"/>
                    <TextBlock x:Name="IndustryPreviewText"
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="② بيانات المنشأة"/>
            <Border Style="{StaticResource ContentCard}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="اسم المنشأة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CompanyNameBox" Style="{StaticResource AppTextBox}"/>
                    <TextBlock Text="الرقم الضريبي (15 رقماً)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                    <TextBox x:Name="VatNumberBox" Style="{StaticResource AppTextBox}" MaxLength="15"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FormSectionTitle}" Text="③ مدير المنشأة (اختياري)"/>
            <Border Style="{StaticResource ContentCard}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AdminUsernameBox" Style="{StaticResource AppTextBox}"/>
                    <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="AdminPasswordBox" Style="{StaticResource AppPasswordBox}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
                <Button Content="إنشاء المنشأة" Style="{StaticResource PrimaryButton}"
                        Padding="24,10" Click="OnSave"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                        Padding="24,10" Margin="12,0,0,0" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
