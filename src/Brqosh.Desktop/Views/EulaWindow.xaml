<Window x:Class="Brqosh.Desktop.Views.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اتفاقية ترخيص المستخدم"
        Width="720" Height="640"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <Border Style="{StaticResource AuthCard}" Margin="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="اتفاقية ترخيص المستخدم"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <CheckBox x:Name="AgreeCheck" Content="قرأت الاتفاقية وأوافق عليها"
                          Checked="OnAgreeChanged" Unchecked="OnAgreeChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button x:Name="AcceptButton" Content="أوافق" Style="{StaticResource PrimaryButton}"
                            Padding="24,8" IsEnabled="False" Click="OnAccept" Margin="0,0,8,0"/>
                    <Button x:Name="DeclineButton" Content="لا أوافق" Style="{StaticResource SecondaryButton}" Padding="24,8" Click="OnDecline"/>
                </StackPanel>
            </StackPanel>
            <!-- الاتفاقيّةُ فقراتٌ لكلٍّ اتجاهُها: العربيّةُ RTL والإنجليزيّةُ LTR — في TextBox واحدٍ يُقلب ترتيبُ الجمل الإنجليزيّة وتقع علاماتُ ترقيمها في الجهة الخطأ. -->
            <RichTextBox x:Name="EulaBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Padding="12" FontSize="13"/>
        </DockPanel>
    </Border>
</Window>
