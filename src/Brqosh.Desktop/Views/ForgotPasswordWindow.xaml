<Window x:Class="Brqosh.Desktop.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="استعادة كلمة المرور"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <Border Style="{StaticResource AuthCard}" Margin="28">
        <StackPanel>
            <StackPanel Margin="0,0,0,24">
                <Border Height="3" Width="44" Background="{StaticResource PrimaryBrush}"
                        CornerRadius="2" HorizontalAlignment="Right" Margin="0,0,0,18"/>
                <TextBlock Text="استعادة كلمة المرور"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="سيظهر رمز التحقق هنا بعد إدخال اسم المستخدم."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,14"/>

            <Button x:Name="SendOtpButton"
                    Content="إنشاء رمز التحقق"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Stretch"
                    Click="OnSendOtp"/>

            <TextBlock x:Name="OtpHintText"
                       FontSize="12" Foreground="{StaticResource InfoBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="Collapsed"/>

            <TextBlock Text="رمز التحقق" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <TextBox x:Name="OtpBox" Style="{StaticResource AppTextBox}" MaxLength="6" Margin="0,0,0,14"/>

            <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,14">
                <PasswordBox x:Name="NewPasswordBox"
                             Style="{StaticResource AppPasswordBox}"
                             Padding="14,11,44,11"/>
                <TextBox x:Name="NewPasswordPlainBox"
                         Style="{StaticResource AppTextBox}"
                         Padding="14,11,44,11"
                         Visibility="Collapsed"/>
                <ToggleButton x:Name="NewPasswordRevealToggle"
                              Style="{StaticResource PasswordRevealButton}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="8,0,0,0"/>
            </Grid>

            <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Style="{StaticResource AppPasswordBox}"
                             Padding="14,11,44,11"/>
                <TextBox x:Name="ConfirmPlainBox"
                         Style="{StaticResource AppTextBox}"
                         Padding="14,11,44,11"
                         Visibility="Collapsed"/>
                <ToggleButton x:Name="ConfirmRevealToggle"
                              Style="{StaticResource PasswordRevealButton}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="8,0,0,0"/>
            </Grid>

            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="8"
                    Padding="12,10" Margin="0,12,0,0">
                <TextBlock Text="12 حرفاً على الأقل مع حرف كبير وصغير ورقم ورمز خاص."
                           FontSize="12" Foreground="{StaticResource PrimaryDarkBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="SuccessText"
                       Foreground="{StaticResource SuccessBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <Button Content="تعيين كلمة المرور"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,20,0,0"
                    Click="OnResetPassword"/>
        </StackPanel>
    </Border>
</Window>
