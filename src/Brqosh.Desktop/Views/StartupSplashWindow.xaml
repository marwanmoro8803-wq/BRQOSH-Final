<Window x:Class="Brqosh.Desktop.Views.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Brqosh.Desktop.Views.Controls"
        Title="BRQOSH"
        Width="560" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True"
        FontFamily="{StaticResource AppFont}">
    <!-- (1.0.32) صفحةُ الانتظار عند تهيئة البرنامج أوّلَ مرّة (إنشاءُ الدفاتر والحسابات والجداول يستغرق وقتاً): الشعارُ يلمع، وحلقاتٌ تنبض خلفه،
         وشريطٌ يتحرّك، ورسائلُ تتبدّل — حتى يُفتح البرنامج. كلُّ النصوص من الكود (LocaleManager) فتتبع لغة الواجهة؛ ولا حركةَ إن عطّل المستخدمُ تأثيراتِ ويندوز. -->
    <Border Margin="18" CornerRadius="18" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                <GradientStop Color="#1A1411" Offset="0"/>
                <GradientStop Color="#2B1D12" Offset="0.55"/>
                <GradientStop Color="#1A1411" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <!-- توهّجٌ ناعمٌ يتنفّس خلف الشعار -->
            <Ellipse x:Name="Glow" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
                     RenderTransformOrigin="0.5,0.5" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#66C98A4B" Offset="0"/>
                        <GradientStop Color="#00C98A4B" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><ScaleTransform x:Name="GlowScale" ScaleX="0.9" ScaleY="0.9"/></Ellipse.RenderTransform>
            </Ellipse>
            <!-- حلقتان تتّسعان وتتلاشيان بالتتابع -->
            <Ellipse x:Name="RingA" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,98,0,0"
                     Stroke="#C98A4B" StrokeThickness="1.4" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="RingAScale" ScaleX="0.6" ScaleY="0.6"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="RingB" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,98,0,0"
                     Stroke="#C98A4B" StrokeThickness="1.4" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="RingBScale" ScaleX="0.6" ScaleY="0.6"/></Ellipse.RenderTransform>
            </Ellipse>

            <StackPanel VerticalAlignment="Top" Margin="0,60,0,0">
                <controls:BrandLogo x:Name="Logo" MarkHeight="150" Animate="True" ShineSeconds="2.4" HorizontalAlignment="Center"
                                    MarkBrush="#F7EFE4" NameBrush="#F7EFE4"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,40">
                <TextBlock x:Name="StatusText" FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold" Foreground="#F7EFE4"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Opacity="1"/>
                <TextBlock x:Name="HintText" FontSize="{DynamicResource FontSize.Small}" Foreground="#B9A793" Margin="0,6,0,16"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <!-- شريطُ تقدّمٍ غيرُ محدّد: لمعةٌ تنزلق على مسارٍ خافت -->
                <Border Height="5" CornerRadius="2.5" Background="#3A2B1D" ClipToBounds="True" Width="300">
                    <Border x:Name="Runner" Width="110" HorizontalAlignment="Left" CornerRadius="2.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00C98A4B" Offset="0"/>
                                <GradientStop Color="#FFE3B07A" Offset="0.5"/>
                                <GradientStop Color="#00C98A4B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform><TranslateTransform x:Name="RunnerShift" X="-120"/></Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
