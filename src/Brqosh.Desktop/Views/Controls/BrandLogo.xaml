<UserControl x:Class="Brqosh.Desktop.Views.Controls.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="BRQOSH">
    <!-- (1.0.32) ‏**الاتجاهُ لا يُفرَض LTR على العنصر** — فرضُه كان يُعكس الشعارَ على الجهاز الحقيقيّ في نوافذ RTL (قِيس بتصوير الشاشة من exe الحقيقيّ:
         الدرعُ والاسمُ مقلوبان بينما بقيّةُ النافذة سليمة) مع أنّه سليمٌ في كلّ تشغيلٍ تجريبيّ. فيرث الشعارُ اتجاهَ النافذة كأيّ عنصر،
         ويُقلب مرّةً واحدةً صريحةً (FaceFlip) حين يكون الاتجاهُ RTL ليُرسم كما صُمّم: لاتينيّاً. -->
    <!-- شعارُ BRQOSH: الدرعُ هندسةٌ (BrandMark.xaml) فيتلوّن بأيّ فرشاةٍ ويبقى حادّاً بأيّ مقاس، والاسمُ تحته.
         الاتجاهُ LTR عمداً: اسمُ العلامة لاتينيٌّ ولا يُعكس في واجهةٍ عربيّة. -->
    <Grid x:Name="Face" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
        <ScaleTransform x:Name="FaceFlip" ScaleX="1" ScaleY="1"/>
    </Grid.RenderTransform>
    <StackPanel HorizontalAlignment="Center">
        <Viewbox x:Name="MarkBox" Height="{Binding MarkHeight, ElementName=Root}" Stretch="Uniform" HorizontalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <ScaleTransform x:Name="MarkScale" ScaleX="1" ScaleY="1"/>
            </Viewbox.RenderTransform>
            <Grid Width="751" Height="1000">
                <Path Data="{StaticResource BrqoshMarkGeometry}"
                      Fill="{Binding MarkBrush, ElementName=Root}"
                      Width="751" Height="1000" Stretch="Fill"/>
                <!-- لمعةٌ تمرّ على الدرع بين حينٍ وآخر (تُفعَّل بـAnimate فقط): فرشاةُ تدرّجٍ شفّافةٌ تُزاح عبر الدرع نفسِه. -->
                <Path x:Name="Shine" Data="{StaticResource BrqoshMarkGeometry}" Width="751" Height="1000" Stretch="Fill"
                      IsHitTestVisible="False" Opacity="0">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="ShineShift" X="-1.4"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#00FFFFFF" Offset="0.30"/>
                            <GradientStop Color="#B3FFFFFF" Offset="0.50"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.70"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Grid>
        </Viewbox>
        <!-- الاسمُ «BRQOSH» هندسةٌ مخطَّطة (BrandWordmark.xaml) بتباعد 0.12em كما في تصميم المالك، وتحته شريطٌ؛ المقاساتُ تتبع ارتفاعَ الدرع (انظر ApplyProportions). -->
        <Path x:Name="NameText" Data="{StaticResource BrqoshWordmarkGeometry}" Stretch="Fill"
              Visibility="{Binding NameVisibility, ElementName=Root}"
              Fill="{Binding NameBrush, ElementName=Root}" HorizontalAlignment="Center"/>
        <Rectangle x:Name="NameBar" Visibility="{Binding NameVisibility, ElementName=Root}"
                   Fill="{Binding NameBrush, ElementName=Root}" HorizontalAlignment="Center"/>
    </StackPanel>
    </Grid>
</UserControl>
