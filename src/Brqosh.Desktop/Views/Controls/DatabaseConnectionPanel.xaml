<UserControl x:Class="Brqosh.Desktop.Views.Controls.DatabaseConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <StackPanel>
        <TextBlock Text="تُحفظ الدفاتر على خادم PostgreSQL. تُجرَّب بيانات الاتصال قبل المتابعة، ثم تُحفظ محميّةً على هذا الجهاز — لا كلمة مرور صريحة على القرص."
                   FontSize="{DynamicResource FontSize.Small}" Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock x:Name="LoadErrorText"
                   FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <CheckBox x:Name="AutoDatabaseBox"
                  Content="إعدادٌ تلقائيّ (موصى به) — قاعدة بيانات مدمجة على هذا الجهاز بلا أيّ إدخال"
                  IsChecked="True" Visibility="Collapsed"
                  Margin="0,0,0,12"
                  Checked="OnDatabaseModeChanged" Unchecked="OnDatabaseModeChanged"/>
        <TextBlock x:Name="AutoDatabaseHint"
                   Text="يُجهَّز كلّ شيء داخليّاً: الخادم وكلمة المرور (عشوائيّة محميّة) والقاعدة. للمنشآت التي لها خادمٌ خاصّ: ألغِ التأشير وأدخل بياناته."
                   FontSize="{DynamicResource FontSize.Small}" Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

        <CheckBox x:Name="UseSqliteBox"
                  Content="قاعدة محلية مؤقتة (SQLite) — للتطوير والتجربة فقط"
                  Margin="0,0,0,12"
                  Checked="OnDatabaseModeChanged" Unchecked="OnDatabaseModeChanged"/>

        <StackPanel x:Name="PostgresPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="الخادم *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PgHostBox" Style="{StaticResource AppTextBox}" Text="localhost"
                             TextChanged="OnFieldChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="المنفذ *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PgPortBox" Style="{StaticResource AppTextBox}" Text="5432"
                             TextChanged="OnFieldChanged"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="اسم القاعدة *" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <TextBox x:Name="PgDatabaseBox" Style="{StaticResource AppTextBox}" Text="brqosh"
                     TextChanged="OnFieldChanged"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="مستخدم القاعدة *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PgUserBox" Style="{StaticResource AppTextBox}"
                             TextChanged="OnFieldChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="كلمة مرور القاعدة *" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PgPasswordBox" Style="{StaticResource AppPasswordBox}"
                                 PasswordChanged="OnFieldChanged"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="RequireTlsBox"
                      Content="اشتراط اتصال مشفّر (TLS) بالخادم"
                      IsChecked="True"
                      Margin="0,16,0,0"
                      Checked="OnFieldChanged" Unchecked="OnFieldChanged"/>
            <TextBlock Text="أزل الاشتراط فقط إذا كان الخادم على هذا الجهاز نفسه. على شبكة، الاتصال غير المشفّر يكشف كلمة المرور والدفاتر."
                       FontSize="{DynamicResource FontSize.Small}" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock x:Name="ExistingConfigHint"
                       FontSize="{DynamicResource FontSize.Small}" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="Collapsed"/>

            <!--
              نصُّ الحالة في Grid لا في StackPanel أفقيّ: الأفقيُّ يمنح الطفلَ عرضاً غيرَ محدود،
              فـ TextWrapping لا يعمل وتُقتطع رسالةُ الخطأ الطويلة — وهي أطولُ ما يُعرض هنا.
            -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="TestConnectionBtn"
                        Grid.Column="0"
                        Content="اختبار الاتصال"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnTestConnection"/>
                <TextBlock x:Name="ConnectionStatusText"
                           Grid.Column="1"
                           FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
