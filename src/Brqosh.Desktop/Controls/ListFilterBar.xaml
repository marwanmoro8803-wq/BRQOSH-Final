<UserControl x:Class="Brqosh.Desktop.Controls.ListFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Brqosh.Desktop.Ui"
             FontFamily="{StaticResource AppFont}">
    <!-- شريط بحث وفلترة مشترك لقوائم الفواتير والسندات: نص بحث (مؤجَّل 300ms) + حالة اختيارية + نطاق تاريخ.
         يطلق FilterChanged فقط عند تغيير المستخدم، والصفحة تقرأ SearchText وSelectedStatusValue وFromDate وToDate. -->
    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Width="280"
                 VerticalAlignment="Center"
                 TextChanged="OnSearchTextChanged"
                 AutomationProperties.Name="{loc:Str Key=Common.Search}"
                 ToolTip="{loc:Str Key=Common.Search}"/>
        <Button x:Name="ClearBtn" Content="✕" Padding="10,6" Margin="6,0,0,0"
                VerticalAlignment="Center"
                Click="OnClear"
                AutomationProperties.Name="{loc:Str Key=Filter.ClearFilters}"
                ToolTip="{loc:Str Key=Filter.ClearFilters}"/>

        <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:Str Key=Filter.Status}" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <ComboBox x:Name="StatusCombo" Width="140" DisplayMemberPath="Label"
                      SelectionChanged="OnStatusChanged"
                      AutomationProperties.Name="{loc:Str Key=Filter.Status}"/>
        </StackPanel>

        <StackPanel x:Name="DatePanel" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:Str Key=Filter.FromDate}" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <DatePicker x:Name="FromPicker" Width="140"
                        SelectedDateChanged="OnDateChanged"
                        AutomationProperties.Name="{loc:Str Key=Filter.FromDate}"/>
            <TextBlock Text="{loc:Str Key=Filter.ToDate}" VerticalAlignment="Center" Margin="12,0,8,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <DatePicker x:Name="ToPicker" Width="140"
                        SelectedDateChanged="OnDateChanged"
                        AutomationProperties.Name="{loc:Str Key=Filter.ToDate}"/>
        </StackPanel>
    </WrapPanel>
</UserControl>
