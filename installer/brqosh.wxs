<?xml version="1.0" encoding="UTF-8"?>
<!--
  BRQOSH ERP — MSI Installer (WiX v4)
  Build: installer\build-msi.ps1
  Requires: WiX Toolset v4+ (wix CLI)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="BRQOSH ERP"
           Manufacturer="BRQOSH"
           Version="$(var.ProductVersion)"
           UpgradeCode="E2D301B7-5EA4-4B64-990C-69A7E30CD174"
           Scope="perMachine"
           Codepage="1256"
           Compressed="yes">

    <!-- أيقونةُ «التطبيقات المُثبَّتة»؛ أمّا المختصراتُ فتأخذ أيقونةَ الملف التنفيذيّ المدمَجة (ApplicationIcon). -->
    <Icon Id="BrqoshIcon.ico" SourceFile="$(var.BrandIcon)" />
    <!-- أيقونةُ اختصار «إزالة BRQOSH»: أيقونةُ التطبيق وفي ركنها سلّةُ مهملات. -->
    <Icon Id="BrqoshUninstall.ico" SourceFile="$(var.UninstallIcon)" />
    <Property Id="ARPPRODUCTICON" Value="BrqoshIcon.ico" />
    <!-- (brqosh.com) ‏روابطُ «برامج وميزات»: الموقعُ ومساعدةُ الدعم وجهةُ الاتّصال. -->
    <Property Id="ARPURLINFOABOUT" Value="https://brqosh.com" />
    <Property Id="ARPHELPLINK" Value="https://brqosh.com/contact" />
    <Property Id="ARPCONTACT" Value="support@brqosh.com" />
    <!--
      (الإزالةُ بواجهةٍ حقيقيّة) ‏**الإزالةُ من «التطبيقات» تُجرى بـ`msiexec /x` — وهي بواجهةٍ «أساسيّة» (UILevel=3) لا يُشغَّل فيها تسلسلُ واجهة المُنصِّب أصلاً**،
      ‏فلا تظهر صفحاتُنا ولا سؤالُ «هل تحذف بياناتك؟» مهما أضفنا إلى InstallUISequence (قيس ذلك في سجلّ الإزالة: `Preselected=1` وUILevel=3 والتسلسلُ التنفيذيّ وحدَه).
      ‏فيُخفى زرُّ «إزالة» المباشر وتبقى «تغيير» التي تفتح `msiexec /i` بالواجهة الكاملة: معالجُ الصيانة ← «إزالة» ← سؤالُ البيانات ← التأكيد ← التقدّم.
      ‏و`msiexec /x /qn` للإدارة والنشر الجماعيّ يبقى يعمل (الخاصّيّة تؤثّر في «التطبيقات» وحدَها).
    -->
    <!-- ‏**تُضبط في تسلسل التنفيذ وحدَه لا في جدول Property**: حوارُ الصيانة في WixUI يُعطّل زرَّ «إزالة» إن رأى `ARPNOREMOVE=1` (قيس: «لا يمكن إزالة BRQOSH ERP»)،
         وهو يعمل في تسلسل الواجهة فلا يراها، أمّا تسجيلُ المنتج في «التطبيقات» فيراها فيُكتب `NoRemove=1`. -->
    <SetProperty Id="ARPNOREMOVE" Value="1" Before="CostFinalize" Sequence="execute" />
    <!-- ‏وWiX يضع `ARPNOMODIFY=1` من تلقاء نفسه (قُرئ في جدول Property للحزمة وفي سجلّ «برامج وميزات»: NoModify=1) فيُخفي «تغيير» أيضاً ولا يبقى في «التطبيقات» ما يُزيل —
         فيُفرَّغ قبل تسجيل المنتج ليظهر «تغيير». -->
    <SetProperty Id="ARPNOMODIFY" Value="" Before="CostFinalize" Sequence="execute" />
    <!-- ‏ما يظهر في «التطبيقات المُثبَّتة»: وصفُ المنتج ونوعُ استخدامه. -->
    <Property Id="ARPCOMMENTS" Value="BRQOSH ERP - نظام محاسبة وإدارة أعمال للمنشآت (استخدام مهني)" />

    <!--
      (م-١ · ن-٠١) ‏**الترقيةُ فوق تنصيبٍ قائمٍ لم تكن تقع — ولا يُقال.**

      ‏مقروءٌ من جدول `Upgrade` في الحزمة المشحونة قبل هذا الإصلاح:
        صفُّ الترقية : VersionMax='1.0.0.0'  VersionMaxInclusive=False ⟸ المدى (−∞, 1.0.0.0)
        صفُّ التنزيل : VersionMin='1.0.0.0'  VersionMinInclusive=False ⟸ المدى (1.0.0.0, +∞)
      ‏فإصدارٌ مُثبَّتٌ بـ`1.0.0.0` **خارجَ المدَيين معاً**: لا يُكشف ترقيةً ولا تنزيلاً،
      ‏فلا يُزال القديمُ ولا يُمنع الجديد. و`ProductCode` يتولّد كلَّ بناء، فيُسجَّل
      ‏**منتجٌ ثانٍ جنبَ الأوّل**، وتبقى ثنائيّاتُ الأمس تعمل. بلا رسالةٍ واحدة.

      ‏**والعلاجُ طبقتان، لأنّ واحدةً منهما لا تكفي:**

      ‏(١) `AllowSameVersionUpgrades="yes"` يجعل `VersionMaxInclusive` صحيحاً، فيُكشف
      ‏     إصدارٌ **مساوٍ** ويُزال قبل التثبيت. وهذا يُنقذ حتى لو نُسي رفعُ الرقم.
      ‏(٢) وترقيمٌ **يتغيّر فعلاً** لكلّ بناء — انظر `Directory.Build.props`. والحقلُ
      ‏     الثالث هو ما يُرفع، لا الرابع: قواعدُ Windows Installer تقارن ثلاثةَ حقولٍ
      ‏     فقط من `ProductVersion`، فرفعُ الرابع وحدَه لا يُنتج إصداراً مختلفاً عندها.

      ‏ولمّا صار الإصدارُ يُكشف، يعمل `RemoveExistingProducts` قبل التثبيت — فتُحذف
      ‏الملفّاتُ القديمةُ وتُكتب الجديدةُ من الصفر، **ولا تنطبق قاعدةُ «لا تستبدل ملفّاً
      ‏مساويَ الإصدار» التي كانت تُبقي الثنائيّاتِ القديمة في السيناريو جنباً-إلى-جنب**.
    -->
    <MajorUpgrade DowngradeErrorMessage="إصدار أحدث مثبت بالفعل."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!--
      (التنصيبُ يحمل كلَّ ما يلزمه) ‏**وقتُ التشغيل .NET 10 مضمَّنٌ في الحزمة** (نشرٌ self-contained) — لا شرطَ مسبقاً ولا تنزيلاً ولا إنترنت. كان
      ‏المُنصِّبُ يرفض الجهازَ الذي ليس عليه «.NET 10 Desktop Runtime» ويطلب من العميل تنزيلَه بنفسه (ح-٦٢/ح-١٣٨)؛ فصار الشرطُ بلا معنى
      ‏وحُذف مع اختبارِه، وحلّ محلَّه اختبارٌ يثبت أنّ النشرَ self-contained وأنّ المُنصِّبَ لا يشترط وقتَ تشغيلٍ خارجيّاً.
      ‏معاينةُ PDF تحتاج WebView2 (مضمَّنٌ في ويندوز 11)؛ وغيابُه على ويندوز 10 يُقابله «فتح خارجياً» لا عطل.
    -->

    <!-- واجهةُ التنصيب: ترحيبٌ ← اتفاقيّةُ الترخيص ← مجلّدُ التثبيت ← تأكيدٌ ← تقدّمٌ ← إنهاء، وفي الإزالة سؤالُ «حذفِ البيانات؟» (ui.wxs). -->
    <UIRef Id="BrqoshInstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- يُغلق البرنامجُ إن كان يعمل قبل التثبيت/الإزالة/الترقية فلا تبقى ملفّاتٌ محجوزة. -->
    <util:CloseApplication Id="CloseBrqosh" Target="Brqosh.Desktop.exe" CloseMessage="yes" RebootPrompt="no" Description="يُغلَق BRQOSH قبل المتابعة." />

    <Feature Id="MainFeature" Title="BRQOSH ERP" Level="1">
      <ComponentGroupRef Id="PublishComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BRQOSH" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="BRQOSH" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="PublishComponents" Directory="INSTALLFOLDER">
      <!--
        (م-١ · ن-٣٩) ‏**حُذف المكوّنُ `MainExecutable` — كان يُركِّب الملفَّ مرّةً ثانية.**

        ‏كان يُعلن `Brqosh.Desktop.exe` صراحةً، و`Files Include="**"` أدناه يحصد الشجرةَ
        ‏كلَّها **بما فيها ذلك الملفّ**. فيُثبَّت الواحدُ بمكوّنين، وهو ما يقوله `ICE30`
        ‏حرفاً: «‏installed … by two different components. **This breaks component
        ‏reference counting**» — أربعَ مرّاتٍ في الحزمة المشحونة.

        ‏**وعدُّ المراجع ليس تفصيلاً هنا:** هو ما يقرّر أيُّ ملفٍّ يبقى وأيُّه يُحذف عند
        ‏الترقية والإزالة — وهو موضوعُ هذه المرحلة بعينها. فمكوّنان يدّعيان ملفّاً واحداً
        ‏يجعلان سلوكَ الإزالة غيرَ محدَّد.

        ‏والحذفُ آمنٌ ومُتحقَّقٌ منه: بحثٌ على المستودع كلِّه عن `MainExecutable` و`BrqoshExe`
        ‏(‏`.wxs` · `.wxi` · `.ps1`) أعاد **تعريفَه وحدَه وصفرَ مراجع** — لا `ComponentRef`
        ‏ولا `Feature` ولا اختصارٌ يشير إليه. والاختصاران يستهدفان المسارَ نصّاً
        ‏(`[INSTALLFOLDER]Brqosh.Desktop.exe`) لا مكوّناً، فلا يتأثّران.

        ‏(‏وجُرِّب أوّلاً `Exclude` على `Files` فرفضه مخطّطُ WiX 5: `WIX0004 … unexpected
        ‏attribute 'Exclude'`. والحذفُ أصحُّ على أيّ حال — المكوّنُ زائدٌ لا مُكرَّرٌ فحسب.)
      -->
      <Files Include="$(var.PublishDir)\**" />

      <!--
        (CEEF-228) وضع التشغيل يُصرَّح به عند التثبيت.
        الافتراض في الكود صار الإنتاج، وهذا العنصر تعزيز صريح: قبله لم يكن المثبِّت
        يضبط BRQOSH_ENV إطلاقاً، والاختصاران يشغّلان exe مباشرةً لا BRQOSH-Production.bat.
      -->
      <Component Id="ProductionEnvironment" Guid="C0F9F2C1-9D92-41B0-9A3C-BCE7C004CFC9">
        <Environment Id="BrqoshEnvProduction"
                     Name="BRQOSH_ENV"
                     Value="production"
                     Action="set"
                     Part="all"
                     System="yes"
                     Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\BRQOSH" Name="environment"
                       Type="string" Value="production" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="1D61A9D9-12E1-4B25-9250-4884E30D9CE0">
      <Shortcut Id="StartMenuShortcutLink"
                Name="BRQOSH"
                Description="نظام محاسبة BRQOSH"
                Target="[INSTALLFOLDER]Brqosh.Desktop.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <!--
        (أداةُ الإزالة) ‏اختصارٌ في قائمة ابدأ «إزالة BRQOSH» يفتح معالجَ الإزالة مباشرةً بواجهته الكاملة (شعارٌ، سؤالُ «هل تحذف بياناتك؟»، تأكيدٌ، تقدّمٌ):
        ‏`msiexec /i {ProductCode} REMOVE=ALL` — قيس على جهازٍ حقيقيّ أنّه يبدأ بـ UninstallDataDlg، بخلاف `msiexec /x` الذي واجهتُه أساسيّةٌ لا تعرض صفحاتنا.
        ‏اختصارٌ لا ملفٌّ تنفيذيٌّ: مُشغِّلٌ غيرُ موقَّع كشفه Defender وحذفه.
      -->
      <Shortcut Id="UninstallShortcutLink"
                Name="إزالة BRQOSH (Uninstall)"
                Description="إزالة BRQOSH بواجهةٍ كاملة مع سؤالك عن بياناتك — Uninstall BRQOSH"
                Target="[SystemFolder]msiexec.exe"
                Arguments="/i [ProductCode] REMOVE=ALL"
                Icon="BrqoshUninstall.ico" />
      <RemoveFolder Id="CleanupStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\BRQOSH" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="1CCBDF32-D131-47D7-A5DC-FFA03E99F0CA">
      <Shortcut Id="DesktopShortcutLink"
                Name="BRQOSH"
                Description="نظام محاسبة BRQOSH"
                Target="[INSTALLFOLDER]Brqosh.Desktop.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\BRQOSH" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
