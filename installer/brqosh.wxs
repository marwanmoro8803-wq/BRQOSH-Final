<?xml version="1.0" encoding="UTF-8"?>
<!--
  BRQOSH ERP — MSI Installer (WiX v4)
  Build: installer\build-msi.ps1
  Requires: WiX Toolset v4+ (wix CLI)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BRQOSH ERP"
           Manufacturer="BRQOSH"
           Version="$(var.ProductVersion)"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="إصدار أحدث مثبت بالفعل." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      (CEEF-234 · T-07) فحصُ .NET 9 Desktop Runtime قبل التثبيت.

      وقياسٌ على جهازٍ حيٍّ صحّح الخطّةَ نفسَها: المسار الذي كانت الملاحظةُ السابقة
      تفترضه (SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx) **فارغٌ فعلاً** —
      والتسجيلُ الحقيقيُّ لمثبِّت وقت-تشغيل .NET (32-بت رغم أنه يُنصِّب ثنائياتٍ 64-بت)
      يقع تحت WOW6432Node. فحُرست الحالتان معاً لا واحدةً بالتخمين.

      ولا يُقارَن رقمُ إصدارٍ محدَّد (كـ«9.0.17»): كلُّ رقعةٍ تالية (9.0.18 وما بعدها)
      تُسجَّل باسم قيمةٍ جديد، فمطابقةُ رقمٍ ثابتٍ **تُرفض بعد أوّل رقعة** — أسوأُ من
      غياب الفحص لأنها ترفض تثبيتاً صحيحاً. فالشرطُ وجودُ المفتاح لا قيمةٌ بعينها:
      يمنع الحالة الموثَّقة (جهازٌ بلا أيّ Desktop Runtime يُثبَّت عليه التطبيقُ فيفشل
      لاحقاً بصمت) دون أن يرفض إصداراتٍ مستقبليةً من 9.x.
    -->
    <Property Id="DOTNETDESKTOPDIR" Secure="yes">
      <DirectorySearch Id="DotNetDesktopAppDir" Path="[ProgramFiles64Folder]dotnet\shared\Microsoft.WindowsDesktop.App" />
    </Property>

    <Launch Condition="DOTNETDESKTOPDIR"
        Message="يتطلّب BRQOSH .NET Desktop Runtime 9 أو أحدث. نزّله من https://dotnet.microsoft.com/download/dotnet/9.0 ثم أعد المحاولة." />

    <Feature Id="MainFeature" Title="BRQOSH ERP" Level="1">
      <ComponentGroupRef Id="PublishComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BRQOSH" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="BRQOSH" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="PublishComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="B1C2D3E4-F5A6-7890-BCDE-F12345678901">
        <File Id="BrqoshExe" Source="$(var.PublishDir)\Brqosh.Desktop.exe" KeyPath="yes" />
      </Component>
      <Files Include="$(var.PublishDir)\**" />

      <!--
        (CEEF-228) وضع التشغيل يُصرَّح به عند التثبيت.
        الافتراض في الكود صار الإنتاج، وهذا العنصر تعزيز صريح: قبله لم يكن المثبِّت
        يضبط BRQOSH_ENV إطلاقاً، والاختصاران يشغّلان exe مباشرةً لا BRQOSH-Production.bat.
      -->
      <Component Id="ProductionEnvironment" Guid="E4F5A6B7-C8D9-0123-EF01-345678901234">
        <Environment Id="BrqoshEnvProduction"
                     Name="BRQOSH_ENV"
                     Value="production"
                     Action="set"
                     Part="all"
                     System="yes"
                     Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\BRQOSH" Name="environment"
                       Type="string" Value="production" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="C2D3E4F5-A6B7-8901-CDEF-123456789012">
      <Shortcut Id="StartMenuShortcutLink"
                Name="BRQOSH"
                Description="نظام محاسبة BRQOSH"
                Target="[INSTALLFOLDER]Brqosh.Desktop.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\BRQOSH" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="D3E4F5A6-B7C8-9012-DEF0-234567890123">
      <Shortcut Id="DesktopShortcutLink"
                Name="BRQOSH"
                Description="نظام محاسبة BRQOSH"
                Target="[INSTALLFOLDER]Brqosh.Desktop.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\BRQOSH" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
