<?xml version="1.0" encoding="UTF-8"?>
<!--
  BRQOSH ERP — MSI Installer (WiX v4)
  Build: installer\build-msi.ps1
  Requires: WiX Toolset v4+ (wix CLI)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BRQOSH ERP"
           Manufacturer="BRQOSH"
           Version="$(var.ProductVersion)"
           UpgradeCode="E2D301B7-5EA4-4B64-990C-69A7E30CD174"
           Scope="perMachine"
           Compressed="yes">

    <!--
      (م-١ · ن-٠١) ‏**الترقيةُ فوق تنصيبٍ قائمٍ لم تكن تقع — ولا يُقال.**

      ‏مقروءٌ من جدول `Upgrade` في الحزمة المشحونة قبل هذا الإصلاح:
        صفُّ الترقية : VersionMax='1.0.0.0'  VersionMaxInclusive=False ⟸ المدى (−∞, 1.0.0.0)
        صفُّ التنزيل : VersionMin='1.0.0.0'  VersionMinInclusive=False ⟸ المدى (1.0.0.0, +∞)
      ‏فإصدارٌ مُثبَّتٌ بـ`1.0.0.0` **خارجَ المدَيين معاً**: لا يُكشف ترقيةً ولا تنزيلاً،
      ‏فلا يُزال القديمُ ولا يُمنع الجديد. و`ProductCode` يتولّد كلَّ بناء، فيُسجَّل
      ‏**منتجٌ ثانٍ جنبَ الأوّل**، وتبقى ثنائيّاتُ الأمس تعمل. بلا رسالةٍ واحدة.

      ‏**والعلاجُ طبقتان، لأنّ واحدةً منهما لا تكفي:**

      ‏(١) `AllowSameVersionUpgrades="yes"` يجعل `VersionMaxInclusive` صحيحاً، فيُكشف
      ‏     إصدارٌ **مساوٍ** ويُزال قبل التثبيت. وهذا يُنقذ حتى لو نُسي رفعُ الرقم.
      ‏(٢) وترقيمٌ **يتغيّر فعلاً** لكلّ بناء — انظر `Directory.Build.props`. والحقلُ
      ‏     الثالث هو ما يُرفع، لا الرابع: قواعدُ Windows Installer تقارن ثلاثةَ حقولٍ
      ‏     فقط من `ProductVersion`، فرفعُ الرابع وحدَه لا يُنتج إصداراً مختلفاً عندها.

      ‏ولمّا صار الإصدارُ يُكشف، يعمل `RemoveExistingProducts` قبل التثبيت — فتُحذف
      ‏الملفّاتُ القديمةُ وتُكتب الجديدةُ من الصفر، **ولا تنطبق قاعدةُ «لا تستبدل ملفّاً
      ‏مساويَ الإصدار» التي كانت تُبقي الثنائيّاتِ القديمة في السيناريو جنباً-إلى-جنب**.
    -->
    <MajorUpgrade DowngradeErrorMessage="إصدار أحدث مثبت بالفعل."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!--
      (CEEF-234 · T-07) فحصُ .NET 9 Desktop Runtime قبل التثبيت.

      وقياسٌ على جهازٍ حيٍّ صحّح الخطّةَ نفسَها: المسار الذي كانت الملاحظةُ السابقة
      تفترضه (SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx) **فارغٌ فعلاً** —
      والتسجيلُ الحقيقيُّ لمثبِّت وقت-تشغيل .NET (32-بت رغم أنه يُنصِّب ثنائياتٍ 64-بت)
      يقع تحت WOW6432Node. فحُرست الحالتان معاً لا واحدةً بالتخمين.

      ولا يُقارَن رقمُ إصدارٍ محدَّد (كـ«9.0.17»): كلُّ رقعةٍ تالية (9.0.18 وما بعدها)
      تُسجَّل باسم قيمةٍ جديد، فمطابقةُ رقمٍ ثابتٍ **تُرفض بعد أوّل رقعة** — أسوأُ من
      غياب الفحص لأنها ترفض تثبيتاً صحيحاً. فالشرطُ وجودُ المفتاح لا قيمةٌ بعينها:
      يمنع الحالة الموثَّقة (جهازٌ بلا أيّ Desktop Runtime يُثبَّت عليه التطبيقُ فيفشل
      لاحقاً بصمت) دون أن يرفض إصداراتٍ مستقبليةً من 9.x.
    -->
    <Property Id="DOTNETDESKTOPDIR" Secure="yes">
      <DirectorySearch Id="DotNetDesktopAppDir" Path="[ProgramFiles64Folder]dotnet\shared\Microsoft.WindowsDesktop.App" />
    </Property>

    <Launch Condition="DOTNETDESKTOPDIR"
        Message="يتطلّب BRQOSH .NET Desktop Runtime 9 أو أحدث. نزّله من https://dotnet.microsoft.com/download/dotnet/9.0 ثم أعد المحاولة." />

    <Feature Id="MainFeature" Title="BRQOSH ERP" Level="1">
      <ComponentGroupRef Id="PublishComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BRQOSH" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="BRQOSH" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="PublishComponents" Directory="INSTALLFOLDER">
      <!--
        (م-١ · ن-٣٩) ‏**حُذف المكوّنُ `MainExecutable` — كان يُركِّب الملفَّ مرّةً ثانية.**

        ‏كان يُعلن `Brqosh.Desktop.exe` صراحةً، و`Files Include="**"` أدناه يحصد الشجرةَ
        ‏كلَّها **بما فيها ذلك الملفّ**. فيُثبَّت الواحدُ بمكوّنين، وهو ما يقوله `ICE30`
        ‏حرفاً: «‏installed … by two different components. **This breaks component
        ‏reference counting**» — أربعَ مرّاتٍ في الحزمة المشحونة.

        ‏**وعدُّ المراجع ليس تفصيلاً هنا:** هو ما يقرّر أيُّ ملفٍّ يبقى وأيُّه يُحذف عند
        ‏الترقية والإزالة — وهو موضوعُ هذه المرحلة بعينها. فمكوّنان يدّعيان ملفّاً واحداً
        ‏يجعلان سلوكَ الإزالة غيرَ محدَّد.

        ‏والحذفُ آمنٌ ومُتحقَّقٌ منه: بحثٌ على المستودع كلِّه عن `MainExecutable` و`BrqoshExe`
        ‏(‏`.wxs` · `.wxi` · `.ps1`) أعاد **تعريفَه وحدَه وصفرَ مراجع** — لا `ComponentRef`
        ‏ولا `Feature` ولا اختصارٌ يشير إليه. والاختصاران يستهدفان المسارَ نصّاً
        ‏(`[INSTALLFOLDER]Brqosh.Desktop.exe`) لا مكوّناً، فلا يتأثّران.

        ‏(‏وجُرِّب أوّلاً `Exclude` على `Files` فرفضه مخطّطُ WiX 5: `WIX0004 … unexpected
        ‏attribute 'Exclude'`. والحذفُ أصحُّ على أيّ حال — المكوّنُ زائدٌ لا مُكرَّرٌ فحسب.)
      -->
      <Files Include="$(var.PublishDir)\**" />

      <!--
        (CEEF-228) وضع التشغيل يُصرَّح به عند التثبيت.
        الافتراض في الكود صار الإنتاج، وهذا العنصر تعزيز صريح: قبله لم يكن المثبِّت
        يضبط BRQOSH_ENV إطلاقاً، والاختصاران يشغّلان exe مباشرةً لا BRQOSH-Production.bat.
      -->
      <Component Id="ProductionEnvironment" Guid="C0F9F2C1-9D92-41B0-9A3C-BCE7C004CFC9">
        <Environment Id="BrqoshEnvProduction"
                     Name="BRQOSH_ENV"
                     Value="production"
                     Action="set"
                     Part="all"
                     System="yes"
                     Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\BRQOSH" Name="environment"
                       Type="string" Value="production" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="1D61A9D9-12E1-4B25-9250-4884E30D9CE0">
      <Shortcut Id="StartMenuShortcutLink"
                Name="BRQOSH"
                Description="نظام محاسبة BRQOSH"
                Target="[INSTALLFOLDER]Brqosh.Desktop.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\BRQOSH" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="1CCBDF32-D131-47D7-A5DC-FFA03E99F0CA">
      <Shortcut Id="DesktopShortcutLink"
                Name="BRQOSH"
                Description="نظام محاسبة BRQOSH"
                Target="[INSTALLFOLDER]Brqosh.Desktop.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\BRQOSH" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
